root = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
insert_final_newline = true
max_line_length = 240
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_code_style = intellij_idea
ktlint_standard_backing-property-naming = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_package-name = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_class-naming = disabled
ktlint_standard_filename = disabled
ktlint_standard_kdoc = disabled

# Generated by `just generate-models`; the generator's output is the source of truth.
[gemcore/src/main/kotlin/com/wallet/core/primitives/generated/**.kt]
ktlint = disabled

[gemcore/src/main/kotlin/com/gemwallet/android/ext/RemoteTypeMappers.kt]
ktlint = disabled
