default:
    @just --list

build:
    cargo build

lint:
    @cargo clippy --version
    cargo clippy -- -D warnings

test:
    cargo test --lib

export ANDROID_HOME := env("ANDROID_HOME", env("HOME") / "Library/Android/sdk")
export CARGO_NDK_VERSION := env("CARGO_NDK_VERSION", "4.1.2")

install-ndk:
    #!/usr/bin/env bash
    set -eu
    SDK_MANAGER="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
    NDK="ndk;28.1.13356709"

    if [ ! -x "$SDK_MANAGER" ]; then
        command -v sdkmanager >/dev/null || brew install --cask android-commandlinetools
        echo "Installing the SDK command-line tools into $ANDROID_HOME"
        yes | sdkmanager --sdk_root="$ANDROID_HOME" --licenses >/dev/null
        sdkmanager --sdk_root="$ANDROID_HOME" --install "cmdline-tools;latest"
    fi

    echo "Installing ndk: $NDK"
    "$SDK_MANAGER" --install "$NDK"

install-ios-targets:
    #!/usr/bin/env bash
    rustup target add aarch64-apple-ios-sim aarch64-apple-ios aarch64-apple-ios-macabi aarch64-apple-darwin

install-android-targets:
    rustup target add x86_64-linux-android aarch64-linux-android armv7-linux-androideabi
    cargo install cargo-ndk@${CARGO_NDK_VERSION}

export LIB_NAME := "gemstone"
export DY_LIB_NAME := if os() == "macos" { "libgemstone.dylib" } else { "libgemstone.so" }

export TARGET_DIR := "../target"
export GEN_SWIFT_FOLDER := "generated/swift"
export GEN_KOTLIN_FOLDER := "generated/kotlin"
export ANDROID_MODULE_FOLDER := "android/gemstone/src/main/java"

_generate-bindings LANGUAGE OUTPUT:
    #!/usr/bin/env bash
    set -euo pipefail
    library="${TARGET_DIR}/debug/${DY_LIB_NAME}"
    echo "Generating {{LANGUAGE}} bindings from $library"
    rm -rf "{{OUTPUT}}"
    mkdir -p "{{OUTPUT}}"
    cargo rustc --lib --crate-type cdylib
    cargo run -p uniffi-bindgen -- generate --language {{LANGUAGE}} --crate ${LIB_NAME} --no-format -o "{{OUTPUT}}" "$library"

bindgen-swift: (_generate-bindings "swift" GEN_SWIFT_FOLDER)

bindgen-kotlin: (_generate-bindings "kotlin" GEN_KOTLIN_FOLDER)
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p ${ANDROID_MODULE_FOLDER}
    if ! diff -qr "${GEN_KOTLIN_FOLDER}/uniffi" "${ANDROID_MODULE_FOLDER}/uniffi" >/dev/null 2>&1; then
        rm -rf "${ANDROID_MODULE_FOLDER}/uniffi"
        cp -R "${GEN_KOTLIN_FOLDER}/uniffi" "${ANDROID_MODULE_FOLDER}/uniffi"
    fi

build-android: bindgen-kotlin
    #!/usr/bin/env bash
    rm -rf ~/.m2/repository/com/gemwallet/gemstone/gemstone
    cd android && touch local.properties && ./gradlew publishDebugPublicationToMavenLocal
