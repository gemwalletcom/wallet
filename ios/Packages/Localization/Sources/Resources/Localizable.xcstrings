    "errors.keystore_access": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى مفاتيح هذه المحفظة على هذا الجهاز. إذا كانت لديك عبارة الاسترداد، فاحذف هذه المحفظة واستوردها مرة أخرى لاستعادة الوصول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে এই ওয়ালেটের কী অ্যাক্সেস করা যায়নি। আপনার রিকভারি ফ্রেজ থাকলে, এই ওয়ালেটটি সরিয়ে আবার ইম্পোর্ট করে অ্যাক্সেস ফিরে পান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tomto zařízení se nepodařilo získat přístup ke klíčům této peněženky. Pokud máte obnovovací frázi, odeberte tuto peněženku a znovu ji importujte, abyste obnovili přístup."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke få adgang til denne tegnebogs nøgler på denne enhed. Hvis du har din gendannelsesfrase, skal du fjerne denne tegnebog og importere den igen for at gendanne adgangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Schlüssel dieser Wallet konnte auf diesem Gerät nicht zugegriffen werden. Wenn Sie Ihre Wiederherstellungsphrase haben, entfernen Sie diese Wallet und importieren Sie sie erneut, um den Zugriff wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't access this wallet's keys on this device. If you have your recovery phrase, remove this wallet and import it again to restore access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a las claves de esta billetera en este dispositivo. Si tienes tu frase de recuperación, elimina esta billetera e impórtala de nuevo para restaurar el acceso."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به کلیدهای این کیف پول در این دستگاه ممکن نشد. اگر عبارت بازیابی خود را دارید، این کیف پول را حذف کنید و دوباره وارد کنید تا دسترسی بازیابی شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-access ang mga key ng wallet na ito sa device na ito. Kung mayroon kang recovery phrase, alisin ang wallet na ito at i-import itong muli upang maibalik ang access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'accéder aux clés de ce portefeuille sur cet appareil. Si vous avez votre phrase de récupération, supprimez ce portefeuille et importez-le à nouveau pour restaurer l'accès."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An kasa samun damar shiga makullan wannan walat a wannan na'urar. Idan kana da jimlar dawo da walat, cire wannan walat sannan ka sake shigo da ita don dawo da damar shiga."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לגשת למפתחות הארנק הזה במכשיר הזה. אם יש לך את ביטוי השחזור, הסר את הארנק וייבא אותו מחדש כדי לשחזר את הגישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर इस वॉलेट की कुंजियों तक पहुँच नहीं हो सकी। यदि आपके पास रिकवरी फ़्रेज़ है, तो इस वॉलेट को हटाकर दोबारा इम्पोर्ट करें और एक्सेस बहाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengakses kunci dompet ini di perangkat ini. Jika Anda memiliki frasa pemulihan, hapus dompet ini dan impor kembali untuk memulihkan akses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile accedere alle chiavi di questo portafoglio su questo dispositivo. Se hai la tua frase di recupero, rimuovi questo portafoglio e importalo di nuovo per ripristinare l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでこのウォレットの鍵にアクセスできませんでした。リカバリーフレーズをお持ちの場合は、このウォレットを削除して再度インポートするとアクセスを復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 이 지갑의 키에 접근할 수 없습니다. 복구 문구가 있다면 이 지갑을 삭제한 후 다시 가져와 접근 권한을 복구하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengakses kunci dompet ini pada peranti ini. Jika anda mempunyai frasa pemulihan, keluarkan dompet ini dan import semula untuk memulihkan akses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de sleutels van deze portemonnee op dit apparaat niet openen. Als je je herstelzin hebt, verwijder deze portemonnee dan en importeer hem opnieuw om weer toegang te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uzyskać dostępu do kluczy tego portfela na tym urządzeniu. Jeśli masz frazę odzyskiwania, usuń ten portfel i zaimportuj go ponownie, aby przywrócić dostęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar as chaves desta carteira neste dispositivo. Se você tiver sua frase de recuperação, remova esta carteira e importe-a novamente para restaurar o acesso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut accesa cheile acestui portofel pe acest dispozitiv. Dacă aveți fraza de recuperare, eliminați acest portofel și importați-l din nou pentru a restabili accesul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить доступ к ключам этого кошелька на этом устройстве. Если у вас есть секретная фраза, удалите кошелёк и импортируйте его заново, чтобы восстановить доступ."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kufikia funguo za pochi hii kwenye kifaa hiki. Ikiwa una fungu lako la kurejesha, ondoa pochi hii kisha uiingize tena ili kurejesha ufikiaji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเข้าถึงคีย์ของกระเป๋าเงินนี้บนอุปกรณ์นี้ได้ หากคุณมีวลีกู้คืน ให้ลบกระเป๋าเงินนี้แล้วนำเข้าใหม่เพื่อกู้คืนการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda bu cüzdanın anahtarlarına erişilemedi. Kurtarma ifadeniz varsa bu cüzdanı kaldırıp yeniden içe aktararak erişimi geri kazanabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося отримати доступ до ключів цього гаманця на цьому пристрої. Якщо у вас є фраза відновлення, видаліть цей гаманець і імпортуйте його знову, щоб відновити доступ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس پر اس والیٹ کی کلیدوں تک رسائی نہیں ہو سکی۔ اگر آپ کے پاس ریکوری فقرہ ہے تو اس والیٹ کو ہٹا کر دوبارہ درآمد کریں تاکہ رسائی بحال ہو جائے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập khóa của ví này trên thiết bị này. Nếu bạn có cụm từ khôi phục, hãy xóa ví này và nhập lại để khôi phục quyền truy cập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此设备上访问该钱包的密钥。如持有该钱包的助记词，请删除该钱包并重新导入以恢复访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在此裝置上存取該錢包的金鑰。如持有該錢包的助記詞，請移除該錢包並重新匯入以恢復存取。"
          }
        }
      }
    },
