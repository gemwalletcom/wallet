    "errors.camera_permissions_not_granted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم منح إذن الكاميرا. يرجى تمكين الوصول إلى الكاميرا في الإعدادات لمسح رمز الاستجابة السريعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরার অনুমতি দেওয়া হয়নি। QR কোড স্ক্যান করতে সেটিংসে ক্যামেরা অ্যাক্সেস সক্ষম করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebylo uděleno povolení k fotoaparátu. Chcete-li naskenovat QR kód, povolte v nastavení přístup k fotoaparátu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameratilladelse ikke givet. Aktiver kameraadgang i indstillingerne for at scanne QR-koden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraerlaubnis nicht erteilt. Bitte aktivieren Sie den Kamerazugriff in den Einstellungen, um den QR-Code zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera permission not granted. Please enable camera access in settings to scan QR code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiso de cámara no concedido. Habilite el acceso a la cámara en la configuración para escanear el código QR."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به دوربین داده نشده. لطفا در تنظیمات خود دسارسی دوربین را فعال کنید و سپس برای اسکن امتحان کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ibinigay ang pahintulot sa camera. Mangyaring paganahin ang access sa camera sa mga setting upang i-scan ang QR code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation de la caméra non accordée. Veuillez activer l'accès à la caméra dans les paramètres pour scanner le code QR."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a ba da izinin kyamara ba. Da fatan za a ba da damar damar kyamara a cikin saitunan don bincika lambar QR."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשאת מצלמה לא ניתנה. אפשר גישה למצלמה בהגדרות כדי לסרוק קוד QR."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे की अनुमति नहीं दी गई. कृपया क्यूआर कोड को स्कैन करने के लिए सेटिंग्स में कैमरा एक्सेस सक्षम करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin kamera tidak diberikan. Silakan aktifkan akses kamera di pengaturan untuk memindai kode QR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizzazione fotocamera non concessa. Abilita l'accesso alla fotocamera nelle impostazioni per scansionare il codice QR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの権限が許可されていません。QRコードをスキャンするためには、設定でカメラへのアクセスを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 권한이 부여되지 않았습니다. QR 코드를 스캔하려면 설정에서 카메라 액세스를 활성화하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebenaran kamera tidak diberikan. Sila dayakan akses kamera dalam tetapan untuk mengimbas kod QR."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameratoestemming niet verleend. Schakel cameratoegang in de instellingen in om de QR-code te scannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przyznano pozwolenia na kamerę. Włącz dostęp do aparatu w ustawieniach, aby zeskanować kod QR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão da câmera não foi concedida. Ative o acesso à câmera nas configurações para ler o código QR."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisiunea camerei nu a fost acordată. Vă rugăm să activați accesul la cameră în setări pentru a scana codul QR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на съемку не предоставлено. Пожалуйста, включите доступ к камере в настройках, чтобы отсканировать QR-код."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusa ya kamera haijatolewa. Tafadhali washa ufikiaji wa kamera katika mipangilio ili kuchanganua msimbo wa QR."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้รับอนุญาตให้ใช้กล้อง โปรดเปิดใช้งานการเข้าถึงกล้องในการตั้งค่าเพื่อสแกนโค้ด QR"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera izni verilmedi. Lütfen QR kodunu taramak için ayarlarda kamera erişimini etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвіл на камеру не надано. Будь ласка, увімкніть доступ до камери в налаштуваннях, щоб відсканувати QR-код."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیمرے کی اجازت نہیں دی گئی۔ QR کوڈ اسکین کرنے کے لیے براہ کرم سیٹنگز میں کیمرے تک رسائی کو فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền sử dụng máy ảnh không được cấp. Vui lòng bật quyền truy cập máy ảnh trong cài đặt để quét mã QR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未获取相机权限。请在设置中开启以扫描二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未取得相機權限。請在設定中允許相機存取，以掃描 QR 碼。"
          }
        }
      }
    },
