    "onboarding.security.create_wallet.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا أفهم وأريد الاستمرار"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি বুঝতে পারি এবং চালিয়ে যেতে চাই"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumím a chci pokračovat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forstår og vil gerne fortsætte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verstehe und möchte fortfahren"
          }
        },
        "en": {
