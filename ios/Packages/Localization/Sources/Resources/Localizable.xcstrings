    "errors.unable_estimate_network_fee": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكننا حاليًا حساب رسوم الشبكة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা বর্তমানে নেটওয়ার্ক ফি গণনা করতে অক্ষম।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V současné době nejsme schopni vypočítat síťový poplatek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi er i øjeblikket ikke i stand til at beregne netværksgebyret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sind derzeit nicht in der Lage, die Netzgwerkebühr zu berechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We are currently unable to calculate the network fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente no podemos calcular la tarifa de red."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درحال حاضر قادر به محاسبه کارمزد شبکه نیستیم."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasalukuyan naming hindi makalkula ang bayad sa network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne sommes actuellement pas en mesure de calculer les frais de réseau."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A halin yanzu ba mu iya ƙididdige kuɗin hanyar sadarwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כרגע איננו יכולים לחשב את עמלת הרשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम फिलहाल नेटवर्क शुल्क की गणना करने में असमर्थ हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini kami tidak bisa menghitung biaya jaringan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non siamo in grado di calcolare la tariffa di rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、ネットワーク手数料を計算できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 네트워크 요금을 계산할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat mengira yuran rangkaian pada masa ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Momenteel kunnen wij de netwerkkosten niet berekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecnie nie jesteśmy w stanie obliczyć opłaty sieciowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No momento, não podemos calcular a taxa de rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În prezent, nu putem calcula taxa de rețea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настоящее время мы не можем рассчитать комиссию сети."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa sasa hatuwezi kukokotoa ada ya mtandao."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้เราไม่สามารถคำนวณค่าธรรมเนียมเครือข่ายได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda ağ ücretini hesaplayamıyoruz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наразі ми не можемо розрахувати мережеву плату."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم فی الحال نیٹ ورک فیس کا حساب لگانے سے قاصر ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện tại chúng tôi không thể tính phí mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在无法计算网络费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在無法計算網路費用。"
          }
        }
      }
    },
