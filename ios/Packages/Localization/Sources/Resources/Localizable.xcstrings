    "info.circulating_supply.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد العملات المتاحة حاليًا والمتداولة في السوق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমানে বাজারে উপলব্ধ এবং লেনদেন হওয়া কয়েনের সংখ্যা।"
          }
        },
        "cs": {
