    "info.stake_frozen_required_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم التخزين على TRON عبر خطوتين. جمّد TRX أولاً، ثم قم بتخزينه لكسب المكافآت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TRON-এ স্টেকিং দুই ধাপে হয়। প্রথমে TRX ফ্রিজ করুন, তারপর পুরস্কার পেতে সেটি স্টেক করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsázení na TRONu má dva kroky. Nejprve zmrazte TRX, poté jej vsaďte a získejte odměny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Staking på TRON sker i to trin. Frys først TRX, og stake det derefter for at tjene belønninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Staking auf TRON erfolgt in zwei Schritten. Friere zuerst TRX ein und stake es dann, um Belohnungen zu verdienen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Staking on TRON takes two steps. First freeze TRX, then stake it to earn rewards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer stake en TRON tiene dos pasos. Primero congela TRX y luego hazle stake para ganar recompensas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "استیکینگ در TRON دو مرحله دارد. ابتدا TRX را فریز کنید، سپس آن را استیک کنید تا پاداش بگیرید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May dalawang hakbang ang staking sa TRON. Una, i-freeze ang TRX, pagkatapos ay i-stake ito para kumita ng rewards."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le staking sur TRON se fait en deux étapes. Gelez d'abord des TRX, puis stakez-les pour gagner des récompenses."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Saka hannun jari a TRON yana da matakai biyu. Da farko ka daskare TRX, sannan ka saka shi don samun lada."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סטייקינג ב-TRON נעשה בשני שלבים. תחילה הקפא TRX, ולאחר מכן בצע עליו סטייקינג כדי להרוויח תגמולים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TRON पर स्टेकिंग दो चरणों में होती है। पहले TRX जमाएं, फिर इनाम पाने के लिए उसे स्टेक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Staking di TRON dilakukan dalam dua langkah. Bekukan TRX dulu, lalu staking untuk mendapatkan hadiah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare stake su TRON richiede due passaggi. Prima congela i TRX, poi mettili in stake per guadagnare premi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TRONのステーキングは2ステップです。まずTRXをフリーズし、次にステークして報酬を獲得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TRON 스테이킹은 두 단계로 진행됩니다. 먼저 TRX를 동결한 다음, 스테이킹하여 보상을 받으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertaruhan di TRON melibatkan dua langkah. Bekukan TRX dahulu, kemudian pertaruhkannya untuk memperoleh ganjaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staken op TRON gaat in twee stappen. Bevries eerst TRX en stake het daarna om beloningen te verdienen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staking na TRON składa się z dwóch kroków. Najpierw zamroź TRX, a następnie postaw je, aby zdobyć nagrody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazer stake na TRON tem duas etapas. Primeiro congele TRX e depois faça stake para ganhar recompensas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mizarea pe TRON are doi pași. Mai întâi îngheață TRX, apoi mizează-l pentru a câștiga recompense."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стейкинг в TRON состоит из двух шагов. Сначала заморозьте TRX, а затем застейкайте его, чтобы получать вознаграждения."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuweka hisa kwenye TRON huhusisha hatua mbili. Kwanza ganda TRX, kisha uziweke hisa ili kupata zawadi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสเตคบน TRON มีสองขั้นตอน ก่อนอื่นฟรีซ TRX จากนั้นสเตคเพื่อรับรางวัล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TRON'da staking iki adımdan oluşur. Önce TRX'i dondurun, ardından ödül kazanmak için stake edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стейкінг у TRON складається з двох кроків. Спершу заморозьте TRX, а потім застейкайте його, щоб отримувати винагороди."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TRON پر اسٹیکنگ دو مراحل میں ہوتی ہے۔ پہلے TRX منجمد کریں، پھر انعامات کمانے کے لیے اسے اسٹیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt cọc trên TRON gồm hai bước. Trước tiên hãy đóng băng TRX, sau đó đặt cọc để nhận phần thưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 TRON 上质押分两步。先冻结 TRX，然后质押以赚取奖励。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 TRON 上質押分兩步。先凍結 TRX，然後質押以賺取獎勵。"
          }
        }
      }
    },
