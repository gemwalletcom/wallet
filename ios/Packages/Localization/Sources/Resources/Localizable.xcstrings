    "info.price_impact.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأثير السعر هو التغيير في سعر الرمز المميز الناتج عن حجم تداولك. يعني ارتفاع تأثير السعر أنك ستتلقى عددًا أقل من الرموز المميزة بسبب انخفاض السيولة أو حجم الطلب الكبير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল্যের প্রভাব হল আপনার ট্রেড সাইজের কারণে টোকেন মূল্যের পরিবর্তন। উচ্চ মূল্যের প্রভাবের অর্থ হল আপনি কম তরলতা বা একটি বড় অর্ডার আকারের কারণে কম টোকেন পাবেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vliv ceny je změna ceny tokenu způsobená velikostí vašeho obchodu. Vyšší dopad na cenu znamená, že obdržíte méně tokenů kvůli nízké likviditě nebo velké velikosti objednávky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prispåvirkning er ændringen i tokenpris forårsaget af din handelsstørrelse. Større prispåvirkning betyder, at du modtager færre tokens på grund af lav likviditet eller en stor ordrestørrelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Preiseinfluss ist die Änderung des Token-Preises, die durch Ihre Handelsgröße verursacht wird. Ein höherer Preiseinfluss bedeutet, dass Sie aufgrund geringer Liquidität oder einer großen Auftragsgröße weniger Token erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Price impact is the change in token price caused by your trade size. Higher price impact means you receive fewer tokens due to low liquidity or a large order size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El impacto en el precio es el cambio en el precio del token causado por el tamaño de la operación. Un mayor impacto en el precio significa que recibe menos tokens debido a una baja liquidez o a un gran tamaño de la orden."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاثیر قیمت تغییر در قیمت توکن است که به دلیل اندازه معامله شما ایجاد می شود. تاثیر قیمت بالاتر به این معنی است که به دلیل نقدینگی کم یا حجم سفارش بزرگ، توکن های کمتری دریافت می کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang epekto sa presyo ay ang pagbabago sa presyo ng token na dulot ng laki ng iyong kalakalan. Ang mas mataas na epekto sa presyo ay nangangahulugan na nakakatanggap ka ng mas kaunting mga token dahil sa mababang pagkatubig o isang malaking laki ng order."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impact sur le prix est la variation du prix du jeton causée par la taille de votre transaction. Un impact sur le prix plus élevé signifie que vous recevez moins de jetons en raison d'une faible liquidité ou d'une taille de commande importante."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasirin farashi shine canjin farashin alamar da girman cinikin ku ya haifar. Tasirin farashi mafi girma yana nufin ka karɓi ƴan alamu saboda ƙarancin kuɗi ko girman oda."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השפעת המחיר היא השינוי במחיר האסימון שנגרם על ידי גודל המסחר שלך. השפעה גבוהה יותר על המחיר פירושה שאתה מקבל פחות אסימונים עקב נזילות נמוכה או גודל הזמנה גדול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल्य प्रभाव आपके व्यापार आकार के कारण टोकन मूल्य में होने वाला परिवर्तन है। उच्च मूल्य प्रभाव का मतलब है कि आपको कम तरलता या बड़े ऑर्डर आकार के कारण कम टोकन प्राप्त होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dampak harga adalah perubahan harga token yang disebabkan oleh ukuran perdagangan Anda. Dampak harga yang lebih tinggi berarti Anda menerima lebih sedikit token karena likuiditas rendah atau ukuran pesanan besar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impatto sul prezzo è la variazione del prezzo del token causata dalla dimensione del tuo trade. Un impatto sul prezzo più elevato significa che ricevi meno token a causa della bassa liquidità o di una grande dimensione dell'ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格影響とは、取引サイズによって生じるトークン価格の変化です。価格影響が大きいということは、流動性が低いか注文サイズが大きいために受け取るトークンが少なくなることを意味します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격 영향은 거래 규모로 인해 발생하는 토큰 가격의 변화입니다. 가격 영향이 클수록 유동성이 낮거나 주문 규모가 커서 토큰을 덜 받는다는 의미입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesan harga ialah perubahan dalam harga token yang disebabkan oleh saiz dagangan anda. Kesan harga yang lebih tinggi bermakna anda menerima lebih sedikit token disebabkan kecairan yang rendah atau saiz pesanan yang besar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijsimpact is de verandering in de tokenprijs die wordt veroorzaakt door de omvang van uw transactie. Een hogere prijsimpact betekent dat u minder tokens ontvangt vanwege de lage liquiditeit of een grote ordergrootte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpływ ceny to zmiana ceny tokena spowodowana rozmiarem transakcji. Większy wpływ ceny oznacza, że otrzymujesz mniej tokenów z powodu niskiej płynności lub dużego rozmiaru zamówienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impacto de preço é a mudança no preço do token causada pelo tamanho da sua negociação. Impacto de preço mais alto significa que você recebe menos tokens devido à baixa liquidez ou a um tamanho de ordem grande."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Impactul prețului este modificarea prețului tokenului cauzată de dimensiunea tranzacției dvs. Impactul mai mare al prețului înseamnă că primiți mai puține tokenuri din cauza lichidității scăzute sau a unei comenzi mari."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Влияние цены — это изменение цены токена, вызванное размером вашей сделки. Более высокое влияние цены означает, что вы получаете меньше токенов из-за низкой ликвидности или большого размера заказа."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Athari ya bei ni mabadiliko ya bei ya tokeni yanayosababishwa na ukubwa wa biashara yako. Athari ya bei ya juu inamaanisha unapokea tokeni chache kutokana na ukwasi mdogo au ukubwa mkubwa wa agizo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลกระทบต่อราคาคือการเปลี่ยนแปลงของราคาโทเค็นที่เกิดจากขนาดการซื้อขายของคุณ ผลกระทบต่อราคาที่สูงขึ้นหมายความว่าคุณได้รับโทเค็นน้อยลงเนื่องจากสภาพคล่องต่ำหรือขนาดคำสั่งซื้อที่ใหญ่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyat etkisi, işlem boyutunuzdan kaynaklanan token fiyatındaki değişikliktir. Daha yüksek fiyat etkisi, düşük likidite veya büyük sipariş boyutu nedeniyle daha az token aldığınız anlamına gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вплив ціни — це зміна ціни токена, спричинена розміром вашої торгівлі. Більший вплив на ціну означає, що ви отримуєте менше токенів через низьку ліквідність або великий розмір замовлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قیمت کا اثر آپ کے تجارتی سائز کی وجہ سے ٹوکن کی قیمت میں تبدیلی ہے۔ زیادہ قیمت کے اثر کا مطلب ہے کہ آپ کو کم لیکویڈیٹی یا آرڈر کے بڑے سائز کی وجہ سے کم ٹوکن ملتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác động giá là sự thay đổi về giá token do quy mô giao dịch của bạn gây ra. Tác động giá cao hơn có nghĩa là bạn nhận được ít token hơn do tính thanh khoản thấp hoặc quy mô lệnh lớn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格影响表示交易对价格的冲击。价格影响越大，收到的代币越少，可能由于流动性低或交易金额大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "價格影響表示交易對價格的衝擊。價格影響越大，收到的代幣越少，可能因為流動性低或交易金額大。"
          }
        }
      }
    },
    "info.slippage.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشير الانزلاق إلى الفرق بين السعر المتوقع للتداول والسعر الفعلي الذي يتم تنفيذه به."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্লিপেজ বলতে কোনও ট্রেডের প্রত্যাশিত মূল্য এবং এটি সম্পাদিত প্রকৃত মূল্যের মধ্যে পার্থক্য বোঝায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skluz označuje rozdíl mezi očekávanou cenou obchodu a skutečnou cenou, za kterou je obchod proveden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage refererer til forskellen mellem den forventede pris på en handel og den faktiske pris, den udføres til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage bezeichnet die Differenz zwischen dem erwarteten Preis eines Handels und dem tatsächlichen Preis, zu dem er ausgeführt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage refers to the difference between the expected price of a trade and the actual price at which it is executed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El deslizamiento se refiere a la diferencia entre el precio esperado de una operación y el precio real al que se ejecuta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لغزش به تفاوت بین قیمت مورد انتظار یک معامله و قیمت واقعی که در آن انجام می‌شود اشاره دارد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang slippage ay tumutukoy sa pagkakaiba sa pagitan ng inaasahang presyo ng isang kalakalan at ang aktwal na presyo kung saan ito isinasagawa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le glissement fait référence à la différence entre le prix attendu d'une transaction et le prix réel auquel elle est exécutée."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamewa yana nufin bambanci tsakanin farashin ciniki da ake tsammani da ainihin farashin da ake aiwatar da shi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלקה (Slippage) מתייחסת להפרש בין המחיר הצפוי של עסקה לבין המחיר בפועל שבו היא מבוצעת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्लिपेज से तात्पर्य किसी व्यापार की अपेक्षित कीमत और उस वास्तविक कीमत, जिस पर वह व्यापार निष्पादित होता है, के बीच के अंतर से है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage merujuk pada perbedaan antara harga yang diharapkan dari suatu perdagangan dan harga aktual saat perdagangan itu dieksekusi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo slippage si riferisce alla differenza tra il prezzo previsto di una transazione e il prezzo effettivo a cui viene eseguita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリッページとは、取引の予想価格と実際に約定した価格の差を指します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬리피지란 거래의 예상 가격과 실제로 실행되는 가격의 차이를 말합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage merujuk kepada perbezaan antara harga jangkaan perdagangan dan harga sebenar di mana ia dilaksanakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage verwijst naar het verschil tussen de verwachte prijs van een transactie en de daadwerkelijke prijs waartegen de transactie wordt uitgevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poślizg odnosi się do różnicy między oczekiwaną ceną transakcji a rzeczywistą ceną, po której została ona zrealizowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizamento refere-se à diferença entre o preço esperado de uma negociação e o preço real pelo qual ela é executada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alunecarea se referă la diferența dintre prețul așteptat al unei tranzacții și prețul real la care aceasta este executată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проскальзывание означает разницу между ожидаемой ценой сделки и фактической ценой, по которой она исполняется."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage inarejelea tofauti kati ya bei inayotarajiwa ya biashara na bei halisi ambayo inatekelezwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความสลิปเพจหมายถึงความแตกต่างระหว่างราคาที่คาดหวังของการซื้อขายและราคาจริงที่ดำเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayma, bir işlemin beklenen fiyatı ile gerçekleştirildiği gerçek fiyat arasındaki farkı ifade eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прослизання стосується різниці між очікуваною ціною угоди та фактичною ціною, за якою вона виконується."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage سے مراد تجارت کی متوقع قیمت اور اصل قیمت کے درمیان فرق ہے جس پر اس پر عمل درآمد ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trượt giá là sự chênh lệch giữa giá dự kiến của một giao dịch và giá thực tế khi giao dịch đó được thực hiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑点是指交易预期价格与实际执行价格之间的差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑點是指交易預期價格與實際成交價格之間的差異。"
          }
        }
      }
    },
    "info.stake.apr.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معدل النسبة السنوية (APR) هو معدل المكافأة السنوي لمراهنة العملة المشفرة الخاصة بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বার্ষিক শতাংশ হার (এপিআর) হল আপনার ক্রিপ্টোকারেন্সি শেয়ার করার জন্য বার্ষিক পুরষ্কারের হার।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Roční procentní sazba (RPSN) je roční odměna za staking vaší kryptoměny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Årlig procentsats (ÅOP) er den årlige belønningssats for at satse din kryptovaluta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der effektive Jahreszins (APR) ist der jährliche Belohnungssatz für das Staking Ihrer Kryptowährung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Annual Percentage Rate (APR) is the yearly reward rate for staking your cryptocurrency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tasa de porcentaje anual (APR) es la tasa de recompensa anual por hacer stake de tu criptomoneda."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نرخ درصد سالانه (APR) نرخ پاداش سالانه برای سپرده‌گذاری ارز دیجیتال شما است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Annual Percentage Rate (APR) ay ang taunang reward rate para sa staking ng iyong cryptocurrency."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux annuel en pourcentage (APR) est le taux de récompense annuel pour le staking de votre crypto-monnaie."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yawan Kashi na shekara-shekara (APR) shine ƙimar lada na shekara don tara kuɗin cryptocurrency."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיעור אחוז שנתי (APR) הוא שיעור התגמול השנתי עבור הפקדת מטבע הקריפטו שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वार्षिक प्रतिशत दर (एपीआर) आपकी क्रिप्टोकरेंसी को दांव पर लगाने के लिए वार्षिक पुरस्कार दर है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkat Persentase Tahunan (APR) adalah tingkat imbalan tahunan untuk mempertaruhkan mata uang kripto Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso percentuale annuo (APR) è il tasso di ricompensa annuale per lo staking della tua criptovaluta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年率 (APR) は、暗号通貨をステーキングした場合の年間報酬率です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연이율(APR)은 암호화폐를 스테이킹할 때 매년 지급되는 보상률입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar Peratusan Tahunan (APR) ialah kadar ganjaran tahunan untuk mempertaruhkan mata wang kripto anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaarlijks percentage (APR) is het jaarlijkse beloningspercentage voor het staken van uw cryptocurrency."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Roczna stopa procentowa (APR) to roczna stopa nagrody za stakowanie kryptowaluty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxa Percentual Anual (APR) é a taxa de recompensa anual por fazer stake da sua criptomoeda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rata anuală procentuală (APR) este rata anuală de recompensă pentru plasarea criptomonedei tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Годовая процентная ставка (APR) — это годовая ставка вознаграждения за стейкинг вашей криптовалюты."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiwango cha Asilimia cha Mwaka (APR) ni kiwango cha tuzo cha kila mwaka cha kuweka sarafu yako ya cryptocurrency."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตราเปอร์เซ็นต์ต่อปี (APR) คืออัตราผลตอบแทนรายปีสำหรับการสเตคสกุลเงินดิจิทัลของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıllık Yüzde Oranı (APR), kripto paranızı stake etmeniz durumunda ödeyeceğiniz yıllık ödül oranıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Річна процентна ставка (APR) – це річна ставка винагороди за стейкінг вашої криптовалюти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سالانہ فیصدی شرح (APR) آپ کی کریپٹو کرنسی کو اسٹیک کرنے کے لیے سالانہ انعام کی شرح ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tỷ lệ phần trăm hàng năm (APR) là tỷ lệ phần thưởng hàng năm cho việc đặt cược tiền điện tử của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "年利率（APR）是质押加密货币的年度回报率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "年利率（APR）是質押加密貨幣的年度報酬率。"
          }
        }
      }
    },
    "info.stake.reserved.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى مبلغ صغير في محفظتك لتغطية الرسوم الخاصة بالعمليات مثل إلغاء المراهنة أو المطالبة بالمكافآت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরষ্কার দাবি করা বা আনস্টেক করার মতো ক্রিয়াকলাপের ফি মেটাতে আপনার ওয়ালেটে অল্প পরিমাণ টাকা থেকে যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Malá částka vám zůstane v peněžence na pokrytí poplatků za operace, jako je odstraňování sázek nebo nárokování odměn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lille beløb forbliver i din pung til at dække gebyrer for operationer som at fjerne indsatser eller gøre krav på belønninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleiner Betrag verbleibt in Ihrem Wallet, um Gebühren für Vorgänge wie das Aufheben der Absteckung oder das Einfordern von Prämien zu decken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small amount stays in your wallet to cover fees for operations like unstaking or claiming rewards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña cantidad permanece en tu billetera para cubrir las tarifas de operaciones como retirar del stake o reclamar recompensas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار کمی در کیف پول شما باقی می‌ماند تا هزینه‌های عملیاتی مانند لغو استیک یا دریافت پاداش را پوشش دهد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May maliit na halaga ang nananatili sa iyong wallet para mabayaran ang mga bayarin para sa mga operasyon tulad ng pag-unstaking o pag-claim ng mga reward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite somme reste dans votre portefeuille pour couvrir les frais d'opérations telles que le déblocage ou la réclamation de récompenses."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙananan kuɗi yana tsayawa a cikin walat ɗin ku don biyan kuɗi don ayyuka kamar cirewa ko neman lada."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סכום קטן נשאר בארנק שלך כדי לכסות עמלות עבור פעולות כמו ביטול הפקדה או תביעת תגמולים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके वॉलेट में एक छोटी राशि रहती है, जो अनस्टेकिंग या पुरस्कार का दावा करने जैसे कार्यों के लिए शुल्क को कवर करती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejumlah kecil dana disimpan di dompet Anda untuk menutupi biaya operasi seperti unstaking atau klaim hadiah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una piccola somma rimane nel tuo portafoglio per coprire le commissioni per operazioni come l'annullamento dello staking o la richiesta di premi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステーキング解除や報酬の請求などの操作にかかる手数料をカバーするために、少額がウォレットに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이킹 해제나 보상 청구 등의 수수료를 충당하기 위해 소액이 지갑에 남아 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejumlah kecil kekal dalam dompet anda untuk menampung yuran untuk operasi seperti menanggalkan atau menuntut ganjaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een klein bedrag blijft in uw portemonnee staan om de kosten voor handelingen zoals unstaking of het claimen van beloningen te dekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niewielka kwota pozostaje w Twoim portfelu i służy pokryciu opłat za operacje, takie jak anulowanie transakcji lub odbieranie nagród."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pequena quantia fica na sua carteira para cobrir taxas de operações como retirada de stake ou reivindicação de recompensas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O sumă mică rămâne în portofelul tău pentru a acoperi comisioanele aferente operațiunilor precum unstaking-ul sau revendicarea recompenselor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небольшая сумма остается в вашем кошельке для покрытия комиссий за такие операции, как отмена стейкинга или получение вознаграждений."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiasi kidogo husalia kwenye mkoba wako ili kulipia ada za shughuli kama vile kutoweka au kudai zawadi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เงินจำนวนเล็กน้อยจะอยู่ในกระเป๋าเงินของคุณเพื่อชำระค่าธรรมเนียมการดำเนินการ เช่น การเลิกสเตคหรือการรับรางวัล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdanınızda, stake'lerinizi iptal etme veya ödül talep etme gibi işlemlerin ücretlerini karşılamak için küçük bir miktar kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невелика сума залишається у вашому гаманці для покриття комісій за такі операції, як зняття коштів зі стейкінгу або отримання винагород."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک چھوٹی سی رقم آپ کے والیٹ میں رہ جاتی ہے تاکہ ان کارروائیوں کے لیے فیس کو پورا کیا جا سکے جیسے کہ ان اسٹیکنگ یا انعامات کا دعویٰ کرنا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số tiền nhỏ sẽ được giữ lại trong ví của bạn để trang trải phí cho các hoạt động như hủy đặt cọc hoặc nhận phần thưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包中会留有少量资金，用于支付取消质押或领取奖励等操作的费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錢包中會留有少量資金，用於支付取消質押或領取獎勵等操作的費用。"
          }
        }
      }
    },
    "info.stake.reserved.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محجوز لرسوم الشبكة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটওয়ার্ক ফি এর জন্য সংরক্ষিত"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervováno pro síťový poplatek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserveret til netværksgebyr"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserviert für Netzwerkgebühr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserved for Network Fee"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservado para comisión de red"
