    "transfer.minimum_account_balance": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يتبقى حد أدنى من الرصيد %@ بعد ذلك، ما لم تكن تستخدم رصيدك بالكامل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর পরেও ন্যূনতম %@ ব্যালেন্স থাকতে হবে, যদি না আপনি আপনার সম্পূর্ণ ব্যালেন্স ব্যবহার করছেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po uplynutí této doby musí zůstat minimální zůstatek %@, pokud nepoužíváte celý zůstatek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der skal være en minimumsaldo på %@ tilbage efter dette, medmindre du bruger din fulde saldo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach muss ein Mindestguthaben %@ übrig bleiben, es sei denn, Sie nutzen Ihr gesamtes Guthaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A minimum %@ balance must remain after this, unless you're using your full balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de esto, debe quedar un saldo mínimo %@, a menos que utilice su saldo completo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداقل موجودی %@ باید بعد از این باقی بماند، مگر اینکه از موجودی کامل خود استفاده کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang isang minimum na balanse %@ ay dapat manatili pagkatapos nito, maliban kung ginagamit mo ang iyong buong balanse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solde minimum %@ doit rester après cela, à moins que vous n'utilisiez votre solde complet."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mafi ƙarancin ma'auni %@ dole ne ya kasance bayan wannan, sai dai idan kuna amfani da cikakken ma'aunin ku."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר מכן חייבת להישאר יתרה מינימלית %@, אלא אם כן אתה משתמש ביתרה מלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बाद न्यूनतम %@ शेष राशि बनी रहनी चाहिए, जब तक कि आप अपनी पूरी शेष राशि का उपयोग नहीं कर रहे हों।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo minimum %@ harus tetap ada setelah ini, kecuali Anda menggunakan saldo penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo questo importo deve rimanere un saldo minimo %@, a meno che non si utilizzi l'intero saldo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全額を使用する場合を除き、取引後も最低 %@ の残高を維持する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 잔액을 사용하지 않는 한, 이 후에는 최소 %@ 잔액이 남아 있어야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baki minimum %@ mesti kekal selepas ini, melainkan anda menggunakan baki penuh anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierna moet er minimaal %@ saldo overblijven, tenzij u uw volledige saldo gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tym musi pozostać minimalne saldo %@, chyba że wykorzystujesz całe saldo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um saldo mínimo de %@ deve permanecer após isso, a menos que você esteja usando seu saldo total."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După aceasta, trebuie să rămână un sold minim %@, cu excepția cazului în care utilizați soldul integral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После этого должен оставаться минимальный баланс %@, если только вы не используете весь свой баланс."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Salio la chini la %@ lazima lisalie baada ya hili, isipokuwa kama unatumia salio lako kamili."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดคงเหลือขั้นต่ำ %@ ต้องคงอยู่หลังจากนี้ เว้นแต่คุณจะใช้ยอดคงเหลือทั้งหมดของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiyenizin tamamını kullanmadığınız sürece, bundan sonra minimum %@ bakiye kalmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після цього має залишитися мінімальний баланс %@, якщо ви не використовуєте весь баланс."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے بعد ایک کم از کم %@ بیلنس باقی رہنا چاہیے، جب تک کہ آپ اپنا پورا بیلنس استعمال نہ کر رہے ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau đó, bạn phải giữ lại số dư tối thiểu %@, trừ khi bạn sử dụng hết số dư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非使用全部余额，否则需保留至少 %@ 余额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此後必須保留最低 %@ 餘額，除非使用全部餘額。"
          }
        }
      }
    },
