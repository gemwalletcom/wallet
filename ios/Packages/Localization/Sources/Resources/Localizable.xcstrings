    "asset.verification.warning_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأي شخص إنشاء واحدة - بما في ذلك الرموز المميزة أو الخبيثة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে কেউ একটি তৈরি করতে পারে - জাল বা দূষিত টোকেন সহ।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý si jej může vytvořit – včetně falešných nebo škodlivých tokenů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan oprette en - inklusive falske eller ondsindede tokens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder kann einen erstellen – auch gefälschte oder böswillige Token."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can create one - including fake or malicious tokens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera puede crear uno, incluidos los tokens falsos o maliciosos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر کسی می تواند یکی را ایجاد کند - از جمله توکن های جعلی یا مخرب."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahit sino ay maaaring gumawa ng isa - kabilang ang mga peke o nakakahamak na token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'importe qui peut en créer un, y compris des jetons faux ou malveillants."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kowa na iya ƙirƙirar ɗaya - gami da alamun karya ko na mugunta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל אחד יכול ליצור אחד - כולל אסימונים מזויפים או זדוניים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी इसे बना सकता है - नकली या दुर्भावनापूर्ण टोकन सहित।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun dapat membuatnya - termasuk token palsu atau berbahaya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque può crearne uno, inclusi token falsi o dannosi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンは誰でも作成でき、偽造トークンや悪意のあるトークンも存在します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가짜 또는 악성 토큰을 포함하여 누구나 토큰을 만들 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiapa sahaja boleh mencipta satu - termasuk token palsu atau berniat jahat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen kan er een maken, inclusief valse of kwaadaardige tokens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy może go utworzyć – łącznie z fałszywymi lub złośliwymi tokenami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer um pode criar um – incluindo tokens falsos ou maliciosos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine poate crea unul - inclusiv jetoane false sau rău intenționate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой может создать его, включая поддельные или вредоносные токены."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtu yeyote anaweza kuunda moja - ikiwa ni pamoja na ishara bandia au hasidi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครๆ ก็สามารถสร้างโทเค็นขึ้นมาได้ รวมถึงโทเค็นปลอมหรือโทเค็นที่เป็นอันตราย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahte veya kötü amaçlı belirteçler de dahil olmak üzere herkes bir tane oluşturabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-хто може створити його, включно з підробленими чи шкідливими маркерами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی بھی ایک بنا سکتا ہے - بشمول جعلی یا نقصان دہ ٹوکن۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất cứ ai cũng có thể tạo một cái - bao gồm cả mã thông báo giả mạo hoặc độc hại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都可以创建代币，请谨防假冒或恶意代币。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都可以建立代幣，請謹防仿冒或惡意代幣。"
          }
        }
      }
    },
