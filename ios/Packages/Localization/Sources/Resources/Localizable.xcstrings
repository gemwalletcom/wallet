    "info.perpetual.liquidation_price.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سعر التصفية هو مستوى السعر الذي سيتم عنده إغلاق مركزك تلقائيًا لمنع المزيد من الخسائر. عندما يصل سعر السوق إلى هذا المستوى، تتم تصفية مركزك وتفقد الهامش الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিকুইডেশন প্রাইস হল সেই প্রাইস লেভেল যেখানে আপনার পজিশন স্বয়ংক্রিয়ভাবে বন্ধ হয়ে যাবে যাতে আরও ক্ষতি রোধ করা যায়। যখন বাজার মূল্য এই স্তরে পৌঁছায়, তখন আপনার অবস্থান বাতিল হয়ে যায় এবং আপনি আপনার মার্জিন হারাবেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Likvidační cena je cenová hladina, na které bude vaše pozice automaticky uzavřena, aby se předešlo dalším ztrátám. Když tržní cena dosáhne této úrovně, vaše pozice je zlikvidována a ztrácíte marži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Likvidationsprisen er det prisniveau, hvor din position automatisk lukkes for at forhindre yderligere tab. Når markedsprisen når dette niveau, er din position likvideret, og du mister din margin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Liquidationspreis ist das Preisniveau, bei dem Ihre Position automatisch geschlossen wird, um weitere Verluste zu verhindern. Wenn der Marktpreis dieses Niveau erreicht, wird Ihre Position liquidiert und Sie verlieren Ihre Marge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The liquidation price is the price level at which your position will be automatically closed to prevent further losses. When the market price reaches this level, your position is liquidated and you lose your margin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio de liquidación es el nivel de precio en el que su posición se cerrará automáticamente para evitar mayores pérdidas. Cuando el precio de mercado alcanza este nivel, su posición se liquida y pierde su margen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قیمت انحلال سطح قیمتی است که در آن موقعیت شما به طور خودکار بسته می شود تا از زیان بیشتر جلوگیری شود. هنگامی که قیمت بازار به این سطح می رسد، موقعیت شما منحل می شود و حاشیه خود را از دست می دهید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang presyo ng pagpuksa ay ang antas ng presyo kung saan awtomatikong isasara ang iyong posisyon upang maiwasan ang karagdagang pagkalugi. Kapag ang presyo sa merkado ay umabot sa antas na ito, ililikida ang iyong posisyon at mawawala ang iyong margin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix de liquidation est le niveau de prix auquel votre position sera automatiquement fermée pour éviter de nouvelles pertes. Lorsque le prix du marché atteint ce niveau, votre position est liquidée et vous perdez votre marge."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Farashin ruwa shine matakin farashin wanda za'a rufe matsayin ku ta atomatik don hana ƙarin asara. Lokacin da farashin kasuwa ya kai wannan matakin, ana share matsayin ku kuma kuna rasa margin ɗin ku."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיר הפירוק הוא רמת המחיר שבה הפוזיציה שלך תיסגר אוטומטית כדי למנוע הפסדים נוספים. כאשר מחיר השוק מגיע לרמה זו, הפוזיציה שלך מחוסלת ואתה מאבד את המרווח שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिसमापन मूल्य वह मूल्य स्तर है जिस पर आगे के नुकसान को रोकने के लिए आपकी स्थिति स्वचालित रूप से बंद हो जाएगी। जब बाजार मूल्य इस स्तर पर पहुंच जाता है, तो आपकी स्थिति समाप्त हो जाती है और आप अपना मार्जिन खो देते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga likuidasi adalah tingkat harga di mana posisi Anda akan ditutup secara otomatis untuk mencegah kerugian lebih lanjut. Ketika harga pasar mencapai level ini, posisi Anda dilikuidasi dan Anda kehilangan margin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prezzo di liquidazione è il livello di prezzo al quale la tua posizione verrà chiusa automaticamente per evitare ulteriori perdite. Quando il prezzo di mercato raggiunge questo livello, la tua posizione viene liquidata e perdi il tuo margine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "清算価格は、損失拡大を防ぐためにポジションが自動的に決済される価格水準です。市場価格がこの水準に達するとポジションは清算され、証拠金を失います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "청산 가격은 추가 손실을 방지하기 위해 귀하의 포지션이 자동으로 청산되는 가격 수준입니다. 시장 가격이 이 수준에 도달하면 귀하의 포지션은 청산되고 증거금을 잃게 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga pembubaran ialah paras harga di mana kedudukan anda akan ditutup secara automatik untuk mengelakkan kerugian selanjutnya. Apabila harga pasaran mencapai tahap ini, kedudukan anda dibubarkan dan anda kehilangan margin anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De liquidatieprijs is het prijsniveau waarbij uw positie automatisch wordt gesloten om verdere verliezen te voorkomen. Wanneer de marktprijs dit niveau bereikt, wordt uw positie geliquideerd en verliest u uw marge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena likwidacji to poziom ceny, przy którym Twoja pozycja zostanie automatycznie zamknięta, aby zapobiec dalszym stratom. Kiedy cena rynkowa osiągnie ten poziom, Twoja pozycja zostanie zlikwidowana, a Ty stracisz marżę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O preço de liquidação é o nível de preço no qual a sua posição será automaticamente fechada para evitar novas perdas. Quando o preço de mercado atinge este nível, a sua posição é liquidada e você perde a sua margem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prețul de lichidare este nivelul prețului la care poziția dvs. va fi închisă automat pentru a preveni alte pierderi. Când prețul pieței atinge acest nivel, poziția ta este lichidată și îți pierzi marja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена ликвидации — это уровень цен, при котором ваша позиция будет автоматически закрыта, чтобы предотвратить дальнейшие убытки. Когда рыночная цена достигает этого уровня, ваша позиция ликвидируется, и вы теряете свою маржу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei ya kufilisi ni kiwango cha bei ambapo nafasi yako itafungwa kiotomatiki ili kuzuia hasara zaidi. Wakati bei ya soko inafikia kiwango hiki, nafasi yako inafutwa na unapoteza kiasi chako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคาการชำระบัญชีคือระดับราคาที่สถานะของคุณจะถูกปิดโดยอัตโนมัติเพื่อป้องกันการสูญเสียเพิ่มเติม เมื่อราคาตลาดถึงระดับนี้ ตำแหน่งของคุณจะถูกชำระบัญชีและคุณจะสูญเสียหลักประกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasfiye fiyatı, daha fazla kaybın önlenmesi amacıyla pozisyonunuzun otomatik olarak kapatılacağı fiyat seviyesidir. Piyasa fiyatı bu seviyeye ulaştığında pozisyonunuz tasfiye edilir ve marjınızı kaybedersiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліквідаційна ціна – це рівень ціни, на якому ваша позиція буде автоматично закрита, щоб запобігти подальшим втратам. Коли ринкова ціна досягає цього рівня, ваша позиція ліквідується, і ви втрачаєте маржу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لیکویڈیشن پرائس قیمت کی سطح ہے جس پر مزید نقصانات کو روکنے کے لیے آپ کی پوزیشن خود بخود بند ہو جائے گی۔ جب مارکیٹ کی قیمت اس سطح تک پہنچ جاتی ہے، تو آپ کی پوزیشن ختم ہو جاتی ہے اور آپ اپنا مارجن کھو دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá thanh lý là mức giá mà tại đó vị thế của bạn sẽ tự động bị đóng để tránh thua lỗ thêm. Khi giá thị trường đạt đến mức này, vị thế của bạn sẽ bị thanh lý và bạn mất tiền ký quỹ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强平价格是当市场价格达到该水平时，仓位将被自动平仓以防止进一步亏损的价格。当市场价触及此价位，仓位被强制平仓，保证金将被扣除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強制平倉價格是市場價格達到某一價位時，倉位將被自動平倉以防止進一步損失的價格。當市場價格觸及此價位，倉位將被強制平倉，並損失保證金。"
          }
        }
      }
    },
