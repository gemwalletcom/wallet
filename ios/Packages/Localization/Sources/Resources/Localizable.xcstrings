    "errors.not_supported_qr": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز لا يدعم مسح رمز الاستجابة السريعة. يمكنك فقط تحديد صورة رمز الاستجابة السريعة من المكتبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইস QR কোড স্ক্যানিং সমর্থন করে না। আপনি শুধুমাত্র লাইব্রেরি থেকে QR কোড ছবি নির্বাচন করতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení nepodporuje skenování QR kódu. Můžete vybrat pouze obrázek QR kódu z knihovny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed understøtter ikke QR-kodescanning. Du kan kun vælge QR-kodebillede fra biblioteket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät unterstützt keine QR-Code-Scans. Sie können nur QR-Code-Bilder aus der Bibliothek auswählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not support QR code scanning. You can only select QR code image from library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no admite el escaneo de códigos QR. Solo puede seleccionar la imagen del código QR de la biblioteca."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این دستگاه اسکن بارکد را پشتیبانی نمیکند. شما فقط میتوانید تصویر بارکد را از گالری انتخاب کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sinusuportahan ng device na ito ang pag-scan ng QR code. Maaari ka lamang pumili ng QR code na imahe mula sa library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne prend pas en charge la numérisation de code QR. Vous pouvez uniquement sélectionner l'image du code QR dans la bibliothèque."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan na'urar baya goyan bayan duba lambar QR. Kuna iya zaɓar hoton lambar QR daga ɗakin karatu kawai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשיר זה אינו תומך בסריקת קוד QR. אתה יכול לבחור רק תמונה של קוד QR מהספרייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस QR कोड स्कैनिंग का समर्थन नहीं करता है. आप केवल लाइब्रेरी से क्यूआर कोड छवि का चयन कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini tidak mendukung pemindaian kode QR. Anda hanya dapat memilih gambar kode QR dari galeri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non supporta la scansione del codice QR. Puoi selezionare solo l'immagine del codice QR dalla libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではQRコードをスキャンできません。写真ライブラリからQRコード画像を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치는 QR 코드 스캔을 지원하지 않습니다. 라이브러리에서는 QR 코드 이미지만 선택할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti ini tidak menyokong pengimbasan kod QR. Anda hanya boleh memilih imej kod QR daripada pustaka."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat ondersteunt het scannen van QR-codes niet. U kunt alleen een QR-codeafbeelding uit de bibliotheek selecteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie obsługuje skanowania kodów QR. Możesz wybrać tylko obraz kodu QR z biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não é compatível com a leitura de código QR. Você só pode selecionar a imagem do código QR na biblioteca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv nu acceptă scanarea codurilor QR. Puteți selecta doar imaginea codului QR din bibliotecă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данное устройство не поддерживает сканирование QR-кода. Вы можете выбрать только изображение QR-кода из библиотеки."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa hiki hakitumii uchanganuzi wa msimbo wa QR. Unaweza tu kuchagua picha ya msimbo wa QR kutoka maktaba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ไม่รองรับการสแกนโค้ด QR คุณสามารถเลือกภาพรหัส QR จากห้องสมุดเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz QR kod taramasını desteklemiyor. Kütüphaneden yalnızca QR kod görüntüsünü seçebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій не підтримує сканування QR-коду. Ви можете вибрати лише зображення QR-коду з бібліотеки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آلہ QR کوڈ اسکیننگ کو سپورٹ نہیں کرتا ہے۔ آپ لائبریری سے صرف QR کوڈ کی تصویر منتخب کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không hỗ trợ quét mã QR. Bạn chỉ có thể chọn hình ảnh mã QR từ thư viện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持扫码，只能选图库的二维码图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置不支援掃描 QR 碼，只能從照片圖庫選取 QR 碼圖片。"
          }
        }
      }
    },
