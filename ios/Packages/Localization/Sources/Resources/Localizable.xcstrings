    "support.state_empty_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسألنا أي شيء. نحن هنا للمساعدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমাদের যেকোনো প্রশ্ন করুন। আমরা সাহায্য করতে এখানে আছি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptejte se nás na cokoli. Jsme tu, abychom vám pomohli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg os om hvad som helst. Vi er her for at hjælpe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen Sie uns alles. Wir sind für Sie da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask us anything. We are here to help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntanos lo que quieras. Estamos aquí para ayudarte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر سوالی دارید از ما بپرسید. ما اینجا هستیم تا کمک کنیم."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magtanong ka sa amin ng kahit ano. Nandito kami para tumulong."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez-nous toutes vos questions. Nous sommes là pour vous aider."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambaye mu kome. Muna nan don taimaka maka."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שאלו אותנו כל דבר. אנחנו כאן כדי לעזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमसे कुछ भी पूछें। हम मदद के लिए यहाँ हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanyakan apa saja kepada kami. Kami siap membantu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedici qualsiasi cosa. Siamo qui per aiutarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何でもお気軽にお尋ねください。サポートいたします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이든 물어보세요. 저희가 도와드리겠습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanya kami apa sahaja. Kami sedia membantu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag ons wat je maar wilt. We staan voor je klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj nas o cokolwiek. Jesteśmy tu, aby pomóc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte o que quiser. Estamos aqui para ajudar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întreabă-ne orice. Suntem aici să te ajutăm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите нас о чём угодно. Мы всегда рады помочь."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuulize chochote. Tupo hapa kukusaidia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามเราได้ทุกเรื่อง เราพร้อมช่วยเหลือคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bize her şeyi sorabilirsiniz. Yardım için buradayız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитуйте нас про що завгодно. Ми завжди раді допомогти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم سے کچھ بھی پوچھیں۔ ہم مدد کے لیے موجود ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy hỏi chúng tôi bất cứ điều gì. Chúng tôi luôn sẵn sàng hỗ trợ bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有任何问题都可以问我们。我们随时提供帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有任何問題都可以問我們。我們隨時提供協助。"
          }
        }
      }
    },
    "support.state_empty_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف يمكننا مساعدتك؟"
