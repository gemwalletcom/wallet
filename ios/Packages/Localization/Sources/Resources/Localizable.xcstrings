    "fee_rates.info": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تحديد سرعة المعاملة من خلال رسوم الشبكة المدفوعة لعمال المناجم في الشبكة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেনের গতি নেটওয়ার্ক মাইনারদের দেওয়া নেটওয়ার্ক ফি দ্বারা নির্ধারিত হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlost transakce je určena síťovým poplatkem placeným síťovým těžařům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionshastigheden bestemmes af netværksgebyr, der betales til netværksminearbejderne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geschwindigkeit der Transaktion wird durch die Netzwerkgebühr bestimmt, die an die Miner des Netzwerks gezahlt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed of transaction is determined by network fee paid to the network miners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocidad de la transacción está determinada por la tarifa de red pagada a los mineros de la red."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرعت انجام تراکنش بر اساس کارمزدی که به ماینرهای شبکه پرداخت میشود مشخص میشود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang bilis ng transaksyon ay tinutukoy ng bayad sa network na binabayaran sa mga minero ng network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse de transaction est déterminée par les frais de réseau payés aux mineurs du réseau."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ƙayyade saurin ma'amala ta hanyar kuɗin hanyar sadarwa da aka biya ga masu hakar ma'adinai na cibiyar sadarwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מהירות העסקה נקבעת לפי עמלת הרשת המשולמת לכורי הרשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन की गति नेटवर्क खनिकों को भुगतान किए गए नेटवर्क शुल्क से निर्धारित होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecepatan transaksi dihitung berdasarkan biaya jaringan yang dibayarkan pada jaringan penambang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocità della transazione è determinata dalla tariffa di rete pagata ai minatori della rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引速度は、ネットワークのマイナーに支払う手数料によって決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래 속도는 네트워크 채굴자에게 지불되는 네트워크 수수료에 따라 결정됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelajuan transaksi ditentukan oleh bayaran rangkaian yang dibayar kepada pelombong rangkaian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transactiesnelheid wordt bepaald door de netwerkkosten die aan de netwerkmijnwerkers worden betaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybkość transakcji zależy od opłaty sieciowej płaconej górnikom sieciowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A velocidade da transação é determinada pela taxa de rede paga aos mineradores da rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Viteza tranzacției este determinată de taxa de rețea plătită minerilor din rețea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорость транзакции определяется сетевой комиссией, выплачиваемой майнерам сети."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasi ya ununuzi imedhamiriwa na ada ya mtandao inayolipwa kwa wachimbaji wa mtandao."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความเร็วของการทำธุรกรรมจะถูกกำหนดโดยค่าธรรมเนียมเครือข่ายที่จ่ายให้กับนักขุดในเครือข่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem hızı, ağ madencilerine ödenen ağ ücreti tarafından belirlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидкість транзакції визначається мережевою комісією, яка виплачується майнерам мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لین دین کی رفتار کا تعین نیٹ ورک کے کان کنوں کو ادا کی جانے والی نیٹ ورک فیس سے کیا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốc độ giao dịch được xác định bằng phí mạng trả cho người khai thác mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易速度取决于向矿工支付的网络费用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易速度取決於向礦工支付的網路費用"
          }
        }
      }
    },
