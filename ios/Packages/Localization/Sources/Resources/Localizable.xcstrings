            "value": "می فهمم و می خواهم ادامه دهم"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naiintindihan ko at gusto kong magpatuloy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends et je veux continuer"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fahimta kuma ina so in ci gaba"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני מבין ורוצה להמשיך"
          }
        },
        "hi": {
          "stringUnit": {
