    "secret_phrase.do_not_share.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا حصل شخص ما على العبارة السرية الخاصة بك، فسيكون لديه السيطرة الكاملة على محفظتك!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ যদি আপনার গোপন বাক্যাংশ থাকে তবে তারা আপনার মানিব্যাগের সম্পূর্ণ নিয়ন্ত্রণ থাকবে!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud má někdo vaši tajnou frázi, bude mít plnou kontrolu nad vaší peněženkou!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis nogen har din hemmelige sætning, vil de have fuld kontrol over din tegnebog!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jemand Ihre geheime Phrase hat, hat er die vollständige Kontrolle über Ihre Wallet!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If someone has your secret phrase they will have full control of your wallet!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Si alguien tiene tu frase secreta tendrá control total de tu billetera!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر کسی عبارات خصوصی کیف پول شمارا داشته باشد کنترل کامل در دارایی های شما خواهد داشت."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung ang isang tao ay may iyong lihim na parirala magkakaroon sila ng ganap na kontrol sa iyong pitaka!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quelqu'un connaît votre phrase secrète, il aura le contrôle total de votre portefeuille !"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Idan wani yana da kalmar sirrin ku za su sami cikakken iko akan walat ɗin ku!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם למישהו יש את הביטוי הסודי שלך תהיה לו שליטה מלאה בארנק שלך!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि किसी के पास आपका गुप्त वाक्यांश है तो आपके बटुए पर उनका पूरा नियंत्रण होगा!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika seseorang memiliki frasa rahasia Anda, mereka akan memiliki kendali penuh atas dompet Anda!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se qualcuno conosce la tua frase segreta avrà il pieno controllo del tuo portafoglio!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズを知った人は、このウォレットを完全に操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가가 귀하의 비밀 문구를 알고 있다면 귀하의 지갑을 완전히 통제하게 될 것입니다!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika seseorang mempunyai frasa rahsia anda, mereka akan mempunyai kawalan penuh ke atas dompet anda!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als iemand uw geheime zin heeft, heeft hij de volledige controle over uw portemonnee!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli ktoś zna Twoje tajne hasło, będzie miał pełną kontrolę nad Twoim portfelem!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alguém tiver sua frase secreta, terá controle total de sua carteira!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă cineva are expresia ta secretă, va avea control total asupra portofelului tău!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если кто-то узнает вашу секретную фразу, он получит полный контроль над вашим кошельком!"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikiwa mtu ana maneno yako ya siri atakuwa na udhibiti kamili wa pochi yako!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากมีใครมีวลีลับของคุณ พวกเขาจะสามารถควบคุมกระเป๋าเงินของคุณได้อย่างเต็มที่!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birisi gizli ifadenizi ele geçirirse, cüzdanınızın tam kontrolüne sahip olacaktır!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо у когось є ваша секретна фраза, він отримає повний контроль над вашим гаманцем!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر کسی کے پاس آپ کا خفیہ جملہ ہے تو اس کے پاس آپ کے بٹوے کا مکمل کنٹرول ہوگا!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu ai đó có cụm từ bí mật của bạn, họ sẽ có toàn quyền kiểm soát ví của bạn!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人只要拥有助记词，就能完全控制这个钱包！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人只要擁有助記詞，就能完全控制您的錢包！"
          }
        }
      }
    },
    "secret_phrase.do_not_share.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشارك العبارة السرية الخاصة بك!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার গোপন বাক্যাংশ শেয়ার করবেন না!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesdílejte svou tajnou frázi!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del ikke din hemmelige sætning!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihre geheime Phrase nicht weiter!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not share your Secret Phrase!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡No compartas tu Frase Secreta!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارات خصوصی خود را با کسی به اشتراک نگذارید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huwag ibahagi ang iyong Lihim na Parirala!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne partagez pas votre phrase secrète !"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada ku raba Kalmar sirrinku!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אל תשתף את הביטוי הסודי שלך!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना गुप्त वाक्यांश साझा न करें!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan sebarkan Frasa Rahasia Anda!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non condividere la tua frase segreta!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズを共有しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀 문구를 공유하지 마세요!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan kongsi Frasa Rahsia anda!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel uw geheime zin niet!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udostępniaj swojego tajnego wyrażenia!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não compartilhe sua frase secreta!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu împărtășiți expresia dvs. secretă!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не делитесь своей секретной фразой!"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usishiriki Maneno yako ya Siri!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าเปิดเผยวลีลับของคุณ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli İfadenizi paylaşmayın!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не діліться своєю секретною фразою!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے خفیہ جملے کا اشتراک نہ کریں!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng chia sẻ Cụm từ bí mật của bạn!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿泄露助记词！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿洩漏助記詞！"
          }
        }
      }
    },
    "secret_phrase.save_phrase_safely": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ عبارتك السرية في مكان آمن \nالتي تتحكم فيها أنت فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার গোপন বাক্যাংশটি একটি নিরাপদ স্থানে সংরক্ষণ করুন \nযেটি শুধুমাত্র আপনি নিয়ন্ত্রণ করেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte si tajnou frázi na bezpečné místo \n, které ovládáte pouze vy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem din hemmelige sætning på et sikkert sted \nsom kun du kontrollerer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie Ihre geheime Phrase an einem sicheren Ort\n das nur Sie kontrollieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your Secret Phrase in a secure place \nthat only you control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu Frase Secreta en un lugar seguro\n que solo tu controlas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارت بازیابی خود را در مکانی امن ذخیره کنید \nکه فقط شما به آن دسترسی دارید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-save ang iyong Lihim na Parirala sa isang ligtas na lugar \nna ikaw lang ang kumokontrol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre phrase secrète dans un endroit sécurisé\n que vous seul contrôlez."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajiye kalmar sirrin ku a wuri mai tsaro \nwanda kai kadai ke sarrafa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור את הביטוי הסודי שלך במקום מאובטח \nשרק אתה שולט בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने गुप्त वाक्यांश को एक सुरक्षित स्थान पर सहेजें \nजिस पर केवल आपका नियंत्रण हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan Frasa Rahasia Anda di tempat yang aman \nyang hanya Anda kendalikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva la tua frase segreta in un luogo sicuro \n che solo tu controlli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズは、自分だけが管理できる\n安全な場所に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀 문구를 안전한 곳에 저장하세요\n 그건 당신만이 통제할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan Frasa Rahsia anda di tempat selamat \nyang hanya anda kawal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar uw geheime zin op een veilige plaats \ndie alleen u beheert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz swoje tajne zdanie w bezpiecznym miejscu\n nad którymi tylko ty masz kontrolę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve sua frase secreta em um local seguro\n que só você controla."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează-ți fraza secretă într-un loc sigur \npe care doar tu îl controlezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните свою секретную фразу в надежном месте. \nкоторое контролируете только вы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifadhi Maneno yako ya Siri mahali salama \nambayo unadhibiti wewe tu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกวลีลับของคุณไว้ในที่ปลอดภัย \nที่มีเพียงคุณเท่านั้นที่ควบคุม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli İfadenizi güvenli bir yere kaydedin\n bunu yalnızca sen kontrol edebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть свою секретну фразу в надійному місці \nякі контролюєте тільки ви."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے خفیہ جملے کو ایک محفوظ جگہ پر محفوظ کریں \n جس پر صرف آپ کنٹرول کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu cụm từ bí mật của bạn ở nơi an toàn\n mà chỉ có bạn kiểm soát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将助记词保存在安全位置，\n且只有您可以掌控。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將助記詞儲存在安全位置，\n且只有您可以掌控。"
          }
        }
      }
    },
    "secret_phrase.screenshot_detected.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تكون لقطات الشاشة متاحة لتطبيقات أخرى، ولكنها قد تعرض عبارة المرور الخاصة بك للخطر إذا تم حفظها بهذه الطريقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিনশটগুলি অন্যান্য অ্যাপের কাছে অ্যাক্সেসযোগ্য হতে পারে, যদি এইভাবে সংরক্ষণ করা হয় তবে এগুলি আপনার গোপন বাক্যাংশকে ঝুঁকির মধ্যে ফেলতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímky obrazovky mohou být přístupné jiným aplikacím, pokud se uloží tímto způsobem, mohou ohrozit vaši tajnou frázi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmbilleder kan være tilgængelige for andre apps, og de kan bringe din hemmelige frase i fare, hvis de gemmes på denne måde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots können von anderen Apps eingesehen werden und gefährden so Ihre geheime Phrase."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots may be accessible to other apps, they can put your secret phrase at risk if saved this way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla pueden ser accesibles a otras aplicaciones y, si se guardan de esta manera, pueden poner en riesgo tu frase secreta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین‌شات‌ها ممکن است برای برنامه‌های دیگر قابل دسترسی باشند، اگر به این روش ذخیره شوند، می‌توانند رمز عبور شما را در معرض خطر قرار دهند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring ma-access ang mga screenshot sa iba pang apps, maaari nilang ilagay sa panganib ang iyong sikretong parirala kung ise-save sa ganitong paraan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d'écran peuvent être accessibles à d'autres applications ; si elles sont enregistrées de cette manière, votre phrase secrète peut être compromise."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Za a iya samun damar ɗaukar hotuna zuwa wasu ƙa'idodi, za su iya sanya kalmar sirrin ku cikin haɗari idan an ajiye su ta wannan hanyar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צילומי מסך עשויים להיות נגישים לאפליקציות אחרות, והם עלולים לסכן את משפט הסוד שלך אם יישמרו בדרך זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनशॉट अन्य ऐप्स के लिए सुलभ हो सकते हैं, यदि वे इस तरह से सहेजे गए तो वे आपके गुप्त वाक्यांश को खतरे में डाल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan layar mungkin dapat diakses oleh aplikasi lain, namun hal itu dapat membahayakan frasa rahasia Anda jika disimpan dengan cara ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli screenshot potrebbero essere accessibili ad altre app e, se salvati in questo modo, potrebbero mettere a rischio la tua frase segreta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットは他のアプリからアクセスされる可能性があります。この方法でリカバリーフレーズを保存すると、漏えいするおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷은 다른 앱에서 접근할 수 있으며, 이런 방식으로 저장할 경우 비밀번호가 위험에 노출될 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan skrin mungkin boleh diakses oleh apl lain, ia boleh meletakkan frasa rahsia anda pada risiko jika disimpan dengan cara ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermafbeeldingen zijn mogelijk toegankelijk voor andere apps, maar ze kunnen uw geheime zin in gevaar brengen als u ze op deze manier opslaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrzuty ekranu mogą być dostępne dla innych aplikacji, a zapisanie ich w ten sposób może narazić Twoją tajną frazę na ryzyko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturas de tela podem ser acessíveis a outros aplicativos e, se salvas dessa forma, podem colocar sua frase secreta em risco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturile de ecran pot fi accesibile altor aplicații și pot pune în pericol fraza ta secretă dacă sunt salvate în acest fel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скриншоты могут быть доступны другим приложениям, и если сохранить их таким образом, они могут поставить под угрозу вашу секретную фразу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Picha za skrini zinaweza kupatikana kwa programu zingine, zinaweza kuweka maneno yako ya siri hatarini ikiwa yamehifadhiwa kwa njia hii."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพหน้าจออาจเข้าถึงได้จากแอปอื่น แต่หากบันทึกในลักษณะนี้ อาจทำให้รหัสผ่านของคุณตกอยู่ในความเสี่ยง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüleri diğer uygulamalar tarafından erişilebilir olabilir, bu şekilde kaydedilirse gizli ifadeniz riske girebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімки екрана можуть бути доступні іншим програмам, і якщо їх зберегти таким чином, ваша секретна фраза може бути під загрозою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین شاٹس دیگر ایپس کے لیے قابل رسائی ہو سکتے ہیں، اگر اس طرح محفوظ کیا جائے تو وہ آپ کے خفیہ جملے کو خطرے میں ڈال سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh chụp màn hình có thể được các ứng dụng khác truy cập, nhưng chúng có thể khiến cụm từ bí mật của bạn gặp rủi ro nếu được lưu theo cách này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕截图可能会被其他应用访问；以此方式保存助记词会带来泄露风险。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
