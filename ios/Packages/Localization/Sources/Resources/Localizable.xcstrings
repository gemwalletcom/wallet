            "state": "translated",
            "value": "قیمت فعالسازی باید کمتر از قیمت بازار باشد"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat mas mababa sa presyo sa merkado ang trigger price"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix de déclenchement doit être inférieur au prix du marché"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Farashin kunnawa ya kamata ya zama ƙasa da farashin kasuwa"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיר ההפעלה צריך להיות נמוך ממחיר השוק"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रिगर मूल्य बाजार मूल्य से कम होना चाहिए"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga pemicu harus lebih rendah dari harga pasar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prezzo di attivazione deve essere inferiore al prezzo di mercato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガー価格は市場価格より低くする必要があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트리거 가격은 시장 가격보다 낮아야 합니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga pencetus perlu lebih rendah daripada harga pasaran"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De triggerprijs moet lager zijn dan de marktprijs"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena aktywacji powinna być niższa niż cena rynkowa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O preço de acionamento deve ser menor que o preço de mercado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prețul de declanșare trebuie să fie mai mic decât prețul pieței"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена триггера должна быть ниже рыночной цены"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei ya kichochezi inapaswa kuwa chini ya bei ya soko"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคา Trigger ควรต่ำกว่าราคาตลาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetikleme fiyatı piyasa fiyatından düşük olmalıdır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціна спрацювання має бути нижчою за ринкову ціну"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرگر قیمت مارکیٹ قیمت سے کم ہونی چاہیے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá kích hoạt phải thấp hơn giá thị trường"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发价格应低于市场价格"
          }
        },
        "zh-Hant": {
