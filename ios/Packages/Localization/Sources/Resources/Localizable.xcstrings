    "update_app.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإصدار %@ من التطبيق متاح الآن. قم بالتحديث والاستمتاع بأحدث الميزات والتحسينات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটির সংস্করণ %@ এখন উপলব্ধ। আপডেট করুন এবং সর্বশেষ বৈশিষ্ট্য এবং উন্নতি উপভোগ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verze %@ aplikace je nyní k dispozici. Aktualizujte a užívejte si nejnovější funkce a vylepšení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ af appen er nu tilgængelig. Opdater og nyd de nyeste funktioner og forbedringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ der App ist jetzt verfügbar. Aktualisieren und genießen Sie die neuesten Funktionen und Verbesserungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ of the app is now available. Update and enjoy the latest features and improvements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión %@ de la aplicación ya está disponible. Actualice y disfrute de las últimas funciones y mejoras."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخه %@ برنامه اکنون در دسترس است. به روز رسانی کنید و از آخرین ویژگی ها و پیشرفت ها لذت ببرید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Available na ngayon ang bersyon %@ ng app. I-update at tamasahin ang mga pinakabagong feature at pagpapahusay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version %@ de l'application est désormais disponible. Mettez à jour et profitez des dernières fonctionnalités et améliorations."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shafin %@ na app yana nan yanzu. Sabunta kuma ji daɗin sabbin abubuwa da haɓakawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסה %@ של האפליקציה זמינה כעת. עדכן ותהנה מהתכונות והשיפורים העדכניים ביותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप का संस्करण %@ अब उपलब्ध है। अद्यतन करें और नवीनतम सुविधाओं और सुधारों का आनंद लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi %@ dari aplikasi telah tersedia. Perbarui dan nikmati fitur serta peningkatan terbaru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione %@ dell'app è ora disponibile. Aggiorna e goditi le funzionalità e i miglioramenti più recenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのバージョン%@が利用可能になりました。最新の機能と改善を楽しむために更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 앱 버전 %@을 사용할 수 있습니다. 최신 기능과 개선 사항을 업데이트하고 즐겨보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi %@ apl kini tersedia. Kemas kini dan nikmati ciri dan peningkatan terkini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versie %@ van de app is nu beschikbaar. Update en geniet van de nieuwste functies en verbeteringen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja %@ aplikacji jest już dostępna. Aktualizuj i ciesz się najnowszymi funkcjami i ulepszeniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão %@ do aplicativo já está disponível. Atualize e aproveite os recursos e melhorias mais recentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea %@ a aplicației este acum disponibilă. Actualizați și bucurați-vă de cele mai recente funcții și îmbunătățiri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия %@ приложения теперь доступна. Обновитесь и наслаждайтесь последними функциями и улучшениями."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Toleo la %@ la programu sasa linapatikana. Sasisha na ufurahie vipengele na maboresho ya hivi punde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปเวอร์ชัน %@ พร้อมใช้งานแล้ว อัปเดตและเพลิดเพลินกับฟีเจอร์และการปรับปรุงล่าสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın %@ sürümü artık mevcut. Güncelleyin ve en son özelliklerin ve iyileştirmelerin keyfini çıkarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Версія %@ програми вже доступна. Оновлюйте та насолоджуйтеся найновішими функціями та вдосконаленнями."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کا ورژن %@ اب دستیاب ہے۔ تازہ ترین خصوصیات اور بہتریوں کو اپ ڈیٹ کریں اور ان سے لطف اندوز ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản %@ của ứng dụng hiện đã có sẵn. Cập nhật và tận hưởng các tính năng và cải tiến mới nhất."
          }
        },
        "zh-Hans": {
