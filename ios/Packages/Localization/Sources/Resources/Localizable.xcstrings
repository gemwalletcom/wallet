          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуйте %@ балів за кожного друга, який долучиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمائیں %@ شامل ہونے والے ہر دوست کے لیے پوائنٹس۔"
