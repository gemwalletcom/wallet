          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Adadin tsabar kuɗi da ake da su a kasuwa a yanzu haka."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
