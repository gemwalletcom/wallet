    "price_alerts.auto_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشغيل التنبيهات عند حدوث تحركات كبيرة في الأسعار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উল্লেখযোগ্য মূল্য পরিবর্তনের সময় সতর্কতাগুলি ট্রিগার করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění se spouštějí při významných cenových pohybech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Advarsler udløses ved betydelige prisbevægelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei erheblichen Preisbewegungen werden Warnungen ausgelöst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts trigger on significant price moves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas se activan ante movimientos de precios significativos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشدارها در صورت حرکت قابل توجه قیمت فعال می‌شوند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagti-trigger ang mga alerto sa mga makabuluhang galaw ng presyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes se déclenchent en cas de mouvements de prix importants."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Faɗakarwa yana haifar da ƙaƙƙarfan motsin farashi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראות מופעלות על תנודות משמעותיות במחיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महत्वपूर्ण मूल्य परिवर्तन पर अलर्ट सक्रिय हो जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
