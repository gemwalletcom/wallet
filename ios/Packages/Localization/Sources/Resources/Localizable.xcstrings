        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala huu unahitaji %@, lakini ni %@ pekee zinazopatikana. Unahitaji %@ zaidi ili kuendelea."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธุรกรรมนี้ต้องใช้ %@ แต่มีเพียง %@ เท่านั้น คุณต้องการอีก %@ เพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem %@ gerektirir, ancak yalnızca %@ kullanılabilir. Devam etmek için %@ daha gerekiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї транзакції потрібно %@, але доступно лише %@. Щоб продовжити, вам потрібно ще %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس لین دین کے لیے %@ درکار ہے، لیکن صرف %@ دستیاب ہے۔ جاری رکھنے کے لیے آپ کو مزید %@ درکار ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch này yêu cầu %@, nhưng chỉ có %@ khả dụng. Bạn cần thêm %@ để tiếp tục."
          }
        },
        "zh-Hans": {
