            "value": "मैं समझता हूं और जारी रखना चाहता हूं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya mengerti dan ingin melanjutkan"
          }
        },
        "it": {
          "stringUnit": {
