            "value": "इस लेनदेन के लिए %@ आवश्यक है, लेकिन केवल %@ उपलब्ध हैं। जारी रखने के लिए आपको %@ और चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi ini memerlukan %@, tetapi hanya %@ yang tersedia. Anda memerlukan %@ lagi untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa transazione richiede %@, ma sono disponibili solo %@. Ti serve ancora %@ per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この取引には%@が必要ですが、利用できるのは%@のみです。続行するには、あと%@必要です。"
