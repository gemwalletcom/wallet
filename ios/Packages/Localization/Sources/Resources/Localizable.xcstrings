    "wallet.watch.tooltip.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفظة للمراقبة فقط. أنت لا تتحكم في هذه الأموال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধুমাত্র দেখার ওয়ালেট। এই তহবিল আপনার নিয়ন্ত্রণে নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peněženka pouze ke sledování. Tyto prostředky neovládáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnebog kun til overvågning. Du kontrollerer ikke disse midler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur-Beobachten-Wallet. Sie haben keine Kontrolle über diese Gelder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch-only wallet. You don't control these funds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Billetera solo de observación. No controlas estos fondos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول فقط برای مشاهده. شما کنترلی بر این وجوه ندارید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet na pang-bantay lamang. Hindi mo kontrolado ang mga pondong ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portefeuille en lecture seule. Vous ne contrôlez pas ces fonds."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Walat na kallo kawai. Ba ku da ikon sarrafa waɗannan kuɗaɗe ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארנק לצפייה בלבד. אין לך שליטה על הכספים האלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल देखने वाला वॉलेट। इन फ़ंड पर आपका नियंत्रण नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet khusus pantau. Anda tidak mengontrol dana ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Portafoglio di sola osservazione. Non controlli questi fondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧専用ウォレットです。この資金はあなたの管理下にありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보기 전용 지갑입니다. 이 자금을 제어할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet pantau sahaja. Anda tidak mengawal dana ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen-kijken-portemonnee. Je hebt geen controle over deze tegoeden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfel tylko do obserwacji. Nie kontrolujesz tych środków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carteira somente de observação. Você não controla esses fundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Portofel doar pentru monitorizare. Nu controlezi aceste fonduri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелек только для наблюдения. Вы не управляете этими средствами."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi ya kutazama tu. Huna udhibiti wa fedha hizi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าเงินสำหรับดูเท่านั้น คุณไม่ได้ควบคุมเงินเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca izleme cüzdanı. Bu fonlar sizin kontrolünüzde değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець лише для спостереження. Ви не контролюєте ці кошти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف دیکھنے کے لیے والیٹ۔ ان فنڈز پر آپ کا کنٹرول نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví chỉ để theo dõi. Bạn không kiểm soát số tiền này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供观察的钱包。这些资金不受您控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供觀察的錢包。這些資金不受您控制。"
          }
        }
      }
    },
