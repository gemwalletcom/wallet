          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеть %@ требует единовременную плату в размере %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtandao wa %@ unahitaji ada ya mara moja ya %@."
