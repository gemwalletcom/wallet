    "simulation.warning.unlimited_token_approval.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنح هذا المُنفِق إمكانية استخدام هذا الرمز المميز حتى تقوم بإلغاء الموافقة أو تنتهي صلاحيته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ব্যয়কারীকে এই টোকেনটি ব্যবহার করার অনুমতি দেয় যতক্ষণ না আপনি অনুমোদন প্রত্যাহার করেন অথবা এটির মেয়াদ শেষ হয়ে যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To dává utrácející adrese přístup k používání tohoto tokenu, dokud schválení nezrušíte nebo dokud nevyprší jeho platnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette giver brugeren adgang til at bruge denne token, indtil du tilbagekalder godkendelsen, eller den udløber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch erhält der Ausgeber Zugriff auf dieses Token, bis Sie die Genehmigung widerrufen oder es abläuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This gives the spender access to use this token until you revoke the approval or it expires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto le da al gastador acceso para usar este token hasta que revoque la aprobación o expire."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این به خرج‌کننده دسترسی می‌دهد تا زمانی که تأییدیه را لغو کنید یا منقضی شود، از این توکن استفاده کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbibigay ito sa gumagastos ng access na gamitin ang token na ito hanggang sa bawiin mo ang pag-apruba o hanggang sa mag-expire ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela donne au détenteur du jeton l'accès à utiliser jusqu'à ce que vous révoquiez l'autorisation ou que celle-ci expire."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan yana ba mai kashewa damar amfani da wannan alamar har sai kun soke amincewa ko kuma ta ƙare."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה נותן למוציא גישה להשתמש באסימון זה עד שתבטל את האישור או שהוא יפוג תוקפו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे खर्च करने वाले को इस टोकन का उपयोग तब तक करने की अनुमति मिलती है जब तक आप अनुमोदन रद्द नहीं कर देते या यह समाप्त नहीं हो जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memberi pihak yang mengeluarkan dana akses untuk menggunakan token ini hingga Anda mencabut persetujuan atau token tersebut kedaluwarsa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò consente allo spender di utilizzare questo token finché non revochi l'approvazione o finché non scade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この承認により、承認先のアドレスはこのトークンを使用できるようになります。承認を取り消すか、承認の有効期限が切れるまで有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 사용자가 승인을 취소하거나 만료될 때까지 해당 토큰을 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memberi pembeli akses untuk menggunakan token ini sehingga anda membatalkan kelulusan atau ia tamat tempoh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit geeft de gebruiker toegang tot het gebruik van dit token totdat u de goedkeuring intrekt of het token verloopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki temu osoba wydająca token uzyskuje dostęp do jego wykorzystania do momentu odwołania zatwierdzenia lub wygaśnięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso dá ao gastador acesso ao uso desse token até que você revogue a aprovação ou ele expire."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta îi oferă cheltuitorului acces la utilizarea acestui token până când îi revocați aprobarea sau expiră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это даёт получателю одобрения доступ к использованию этого токена до тех пор, пока вы не отзовёте разрешение или оно не истечёт."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hii inampa mtumiaji uwezo wa kutumia tokeni hii hadi utakapobatilisha idhini au itakapoisha muda wake."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งนี้ให้สิทธิ์ผู้ใช้จ่าย (spender) ในการใช้โทเค็นนี้จนกว่าคุณจะเพิกถอนการอนุมัติหรือโทเค็นหมดอายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, harcayan tarafa, siz onayı iptal edene veya süresi dolana kadar bu jetonu kullanma erişimi sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це надає отримувачу доступ до використання цього токена, доки ви не скасуєте схвалення або термін його дії не закінчиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ خرچ کرنے والے کو اس ٹوکن کو استعمال کرنے تک رسائی دیتا ہے جب تک کہ آپ منظوری منسوخ نہیں کرتے یا اس کی میعاد ختم نہیں ہوجاتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này cho phép người chi tiêu có quyền sử dụng mã thông báo này cho đến khi bạn thu hồi sự chấp thuận hoặc mã thông báo hết hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此授权会允许被授权方持续使用该代币，直到您撤销授权或授权到期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此授權允許被授權方持續使用此代幣，直到您撤銷授權或授權到期。"
          }
        }
      }
    },
