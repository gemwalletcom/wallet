    "onboarding.security.create_wallet.do_not_share.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأي شخص يحصل على عبارتك السرية أن يتولى السيطرة الكاملة على محفظتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে কেউ আপনার গোপন বাক্যাংশ পায় সে আপনার ওয়ালেটের সম্পূর্ণ নিয়ন্ত্রণ নিতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý, kdo získá vaši tajnou frázi, může převzít plnou kontrolu nad vaší peněženkou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhver, der får din hemmelige sætning, kan tage fuld kontrol over din pung."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder, der Ihre geheime Phrase erhält, kann die vollständige Kontrolle über Ihre Wallet übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who gets your secret phrase can take full control of your wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que obtenga tu frase secreta podrá tomar control total de tu billetera."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر کسی که عبارت مخفی شما را دریافت کند می تواند کنترل کامل کیف پول شما را در دست بگیرد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang sinumang makakakuha ng iyong sikretong parirala ay maaaring ganap na makontrol ang iyong pitaka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiconque obtient votre phrase secrète peut prendre le contrôle total de votre portefeuille."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duk wanda ya sami kalmar sirrin ku na iya ɗaukar cikakken iko da walat ɗin ku."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מי שמקבל את הביטוי הסודי שלך יכול להשתלט על הארנק שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका गुप्त वाक्यांश प्राप्त करने वाला कोई भी व्यक्ति आपके बटुए पर पूर्ण नियंत्रण कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun yang mendapatkan frasa rahasia Anda dapat mengambil alih dompet Anda sepenuhnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque scopra la tua frase segreta può assumere il controllo totale del tuo portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズを知った人は誰でも、このウォレットを完全に操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구든지 귀하의 비밀번호 문구를 알아내면 귀하의 지갑을 완전히 장악할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiapa sahaja yang mendapat frasa rahsia anda boleh mengawal sepenuhnya dompet anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen die uw geheime zin te pakken krijgt, kan de volledige controle over uw portemonnee overnemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda osoba, która pozna Twoją tajną frazę, będzie mogła przejąć pełną kontrolę nad Twoim portfelem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer um que descobrir sua frase secreta poderá assumir o controle total da sua carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine primește fraza ta secretă poate prelua controlul total asupra portofelului tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой, кто узнает вашу секретную фразу, может получить полный контроль над вашим кошельком."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtu yeyote anayepata maneno yako ya siri anaweza kuchukua udhibiti kamili wa pochi yako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครก็ตามที่รู้วลีลับของคุณ สามารถควบคุมกระเป๋าเงินของคุณได้อย่างสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli cümlenizi ele geçiren herkes cüzdanınızın tüm kontrolünü ele geçirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен, хто дізнається вашу секретну фразу, може повністю контролювати ваш гаманець."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو کوئی بھی آپ کا خفیہ جملہ حاصل کرتا ہے وہ آپ کے بٹوے کا مکمل کنٹرول لے سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ ai có được cụm từ bí mật của bạn đều có thể kiểm soát hoàn toàn ví của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何获得助记词的人都可以完全控制您的钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何取得您助記詞的人都能完全控制您的錢包。"
          }
        }
      }
    },
    "onboarding.security.create_wallet.do_not_share.title": {
