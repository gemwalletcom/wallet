        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Cibiyar sadarwar %@ tana buƙatar kuɗin lokaci ɗaya na %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשת %@ דורשת תשלום חד פעמי של %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ नेटवर्क को %@ का एक बार शुल्क देना पड़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaringan %@ memerlukan biaya satu kali sebesar %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rete %@ richiede una tariffa una tantum di %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ネットワークでは、1回限りの有効化手数料 %@ が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 네트워크에는 %@ 의 일회성 수수료가 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangkaian %@ memerlukan bayaran sekali sebanyak %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het %@-netwerk is een eenmalige vergoeding van %@ vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieć %@ wymaga jednorazowej opłaty w wysokości %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rede %@ exige uma taxa única de %@."
          }
        },
        "ro": {
