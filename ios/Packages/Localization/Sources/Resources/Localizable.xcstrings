        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verás actualizaciones sobre tus notificaciones aquí"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی‌های مربوط به اعلان‌هایتان را اینجا خواهید دید"
