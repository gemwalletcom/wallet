    "info.insufficient_network_fee_balance.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب هذه المعاملة %@ لرسوم شبكة %@، ولكن المتاح هو %@ فقط. تحتاج إلى %@ إضافية للمتابعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লেনদেনের জন্য %@ %@ নেটওয়ার্ক ফি হিসেবে প্রয়োজন, কিন্তু মাত্র %@ উপলভ্য আছে। চালিয়ে যেতে আপনার আরও %@ প্রয়োজন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato transakce vyžaduje %@ na síťový poplatek sítě %@, ale k dispozici je pouze %@. K pokračování potřebujete ještě %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne transaktion kræver %@ til netværksgebyret på %@, men kun %@ er tilgængelig. Du mangler %@ for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Transaktion erfordert %@ für die %@-Netzwerkgebühr, aber nur %@ sind verfügbar. Sie benötigen noch %@, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This transaction requires %@ for the %@ network fee, but only %@ is available. You need %@ more to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transacción requiere %@ para la tarifa de red de %@, pero solo hay %@ disponibles. Necesitas %@ más para continuar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تراکنش برای کارمزد شبکه %@ به %@ نیاز دارد، اما فقط %@ در دسترس است. برای ادامه به %@ بیشتر نیاز دارید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nangangailangan ang transaksyong ito ng %@ para sa bayad sa network ng %@, ngunit %@ lang ang available. Kailangan mo pa ng %@ para magpatuloy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette transaction nécessite %@ pour les frais du réseau %@, mais seulement %@ sont disponibles. Il vous faut encore %@ pour continuer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan ciniki yana buƙatar %@ don kuɗin hanyar sadarwar %@, amma %@ kawai ake da shi. Kuna buƙatar ƙarin %@ don ci gaba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה הזו דורשת %@ עבור עמלת הרשת של %@, אבל רק %@ זמינים. נדרשים עוד %@ כדי להמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लेनदेन के लिए %@ नेटवर्क शुल्क हेतु %@ आवश्यक है, लेकिन केवल %@ उपलब्ध हैं। जारी रखने के लिए आपको %@ और चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi ini memerlukan %@ untuk biaya jaringan %@, tetapi hanya %@ yang tersedia. Anda memerlukan %@ lagi untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa transazione richiede %@ per la commissione di rete %@, ma sono disponibili solo %@. Ti serve ancora %@ per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この取引には %@ が %@ ネットワークの手数料として必要ですが、利用可能な残高は %@ のみです。続行するには、あと %@ 必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 거래에는 %@ 네트워크 수수료로 %@이(가) 필요하지만 사용할 수 있는 금액은 %@뿐입니다. 계속하려면 %@이 더 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi ini memerlukan %@ untuk yuran rangkaian %@, tetapi hanya %@ tersedia. Anda memerlukan %@ lagi untuk meneruskan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze transactie vereist %@ voor de netwerkkosten van %@, maar er is slechts %@ beschikbaar. Je hebt nog %@ nodig om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta transakcja wymaga %@ na opłatę sieciową %@, ale dostępne jest tylko %@. Aby kontynuować, potrzebujesz jeszcze %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transação requer %@ para a taxa da rede %@, mas apenas %@ estão disponíveis. Você precisa de mais %@ para continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această tranzacție necesită %@ pentru taxa rețelei %@, dar sunt disponibili doar %@. Mai aveți nevoie de %@ pentru a continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этой транзакции требуется %@ на комиссию сети %@, но доступно только %@. Для продолжения вам нужно еще %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala huu unahitaji %@ kwa ada ya mtandao wa %@, lakini ni %@ pekee zinazopatikana. Unahitaji %@ zaidi ili kuendelea."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธุรกรรมนี้ต้องใช้ %@ สำหรับค่าธรรมเนียมเครือข่าย %@ แต่มีเพียง %@ เท่านั้น คุณต้องการอีก %@ เพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem %@ ağ ücreti için %@ gerektirir, ancak yalnızca %@ kullanılabilir. Devam etmek için %@ daha gerekiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї транзакції потрібно %@ на комісію мережі %@, але доступно лише %@. Щоб продовжити, вам потрібно ще %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس لین دین کے لیے %@ نیٹ ورک فیس کی مد میں %@ درکار ہے، لیکن صرف %@ دستیاب ہے۔ جاری رکھنے کے لیے آپ کو مزید %@ درکار ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch này yêu cầu %@ cho phí mạng %@, nhưng chỉ có %@ khả dụng. Bạn cần thêm %@ để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此交易需要 %@ 支付 %@ 网络费用，但只有 %@ 可用。还需要 %@ 才能继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此交易需支付 %@ 作為 %@ 網路手續費，但目前只有 %@ 可用，還差 %@ 才能繼續。"
          }
        }
      }
    },
    "info.lock_time.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت القفل، المعروف أيضًا باسم فترة إلغاء التجميد أو إلغاء التجميد، هو المدة التي لا يمكن خلالها الوصول إلى الأصول المرهونة بعد أن تقرر إلغاء ملكيتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক টাইম, যা আনবন্ডিং বা আনফ্রিজিং পিরিয়ড নামেও পরিচিত, সেই সময়কাল যে সময়ে স্টেক করা সম্পদগুলিকে আনস্টেক করার সিদ্ধান্ত নেওয়ার পরে অ্যাক্সেসযোগ্য নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doba uzamčení, známá také jako období rozvázání nebo rozmrazení, je doba, po kterou jsou vsazená aktiva nepřístupná poté, co se je rozhodnete zrušit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Låsetid, også kendt som ophævelses- eller frigørelsesperioden, er den varighed, hvori satsede aktiver er utilgængelige, efter at du beslutter dig for at ophæve dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sperrzeit, auch Unbonding- oder Unfreezing-Zeitraum genannt, ist der Zeitraum, in dem abgesteckte Vermögenswerte nicht mehr zugänglich sind, nachdem Sie sich entschieden haben, sie aufzuheben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock time, also known as the unbonding or unfreezing period, is the duration during which staked assets are inaccessible after you decide to unstake them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de bloqueo, también conocido como período de desvinculación o descongelación, es el período durante el cual los activos en stake son inaccesibles después de que decides retirarlos del stake."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان قفل، که به عنوان دوره باز کردن یا انجماد نیز شناخته می‌شود، مدت زمانی است که در طی آن دارایی‌های شرط‌بندی شده پس از اینکه تصمیم به رها کردن آن‌ها دارید، غیرقابل دسترسی هستند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang tagal ng pag-lock, na kilala rin bilang unbonding o unfreezing period, ay ang tagal kung saan hindi naa-access ang staked asset pagkatapos mong magpasya na alisin ang stake sa mga ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps de verrouillage, également connu sous le nom de période de déliement ou de dégel, est la durée pendant laquelle les actifs mis en jeu sont inaccessibles après que vous ayez décidé de les débloquer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokacin kulle, wanda kuma aka sani da lokacin kwancewa ko rashin daskarewa, shine tsawon lokacin da kadarorin da aka saka ba a iya samun su bayan kun yanke shawarar cire su."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זמן הנעילה, המכונה גם תקופת ביטול ההצמדה או ההקפאה, הוא משך הזמן שבו נכסים בהימור אינם נגישים לאחר שהחלטת לבטל אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक टाइम, जिसे अनबॉन्डिंग या अनफ़्रीज़िंग अवधि के रूप में भी जाना जाता है, वह अवधि है जिसके दौरान आपके द्वारा दांव से हटाने का निर्णय लेने के बाद दांव पर लगी संपत्तियों तक पहुंच नहीं हो पाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu penguncian, juga dikenal sebagai periode unbonding atau unfreezing, adalah durasi di mana aset yang dipertaruhkan tidak dapat diakses setelah Anda memutuskan untuk melepaskannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo di blocco, noto anche come periodo di svincolo o sblocco, è la durata durante la quale le risorse vincolate sono inaccessibili dopo che hai deciso di rimuoverle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック時間は、アンボンディング期間や凍結解除期間とも呼ばれ、ステーキング解除を決定した後にステークされた資産が利用できなくなる期間のことです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결합 해제 또는 동결 해제 기간이라고도 알려진 잠금 시간은 스테이크 해제를 결정한 후 스테이크된 자산에 액세스할 수 없는 기간입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa kunci, juga dikenali sebagai tempoh nyah ikatan atau nyahbeku, ialah tempoh di mana aset dipertaruhkan tidak boleh diakses selepas anda memutuskan untuk menyahtaruhnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergrendelingstijd, ook wel de unbonding- of unfreezing-periode genoemd, is de tijdsduur gedurende welke de inzet van activa ontoegankelijk is nadat u besluit deze weer op te heffen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas blokady, znany również jako okres odłączenia lub odmrożenia, to czas, podczas którego postawione aktywa są niedostępne po podjęciu decyzji o ich odstawieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de bloqueio, também conhecido como período de desvinculação ou descongelamento, é a duração durante a qual os ativos apostados ficam inacessíveis após você decidir desfazê-los."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Timpul de blocare, cunoscut și ca perioada de dezlegare sau dezghețare, este durata în care activele mizate sunt inaccesibile după ce decideți să le dezlegați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время блокировки, также известное как период разблокировки или размораживания, — это период времени, в течение которого активы недоступны после вывода стейка."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda wa kufunga, unaojulikana pia kama kipindi cha kuunganisha au kufungia, ni muda ambao mali zilizowekwa kwenye hisa haziwezi kufikiwa baada ya kuamua kuziondoa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาล็อคหรือที่เรียกว่าช่วงปลดพันธะหรือยกเลิกการแช่แข็งคือระยะเวลาที่ไม่สามารถเข้าถึงสินทรัพย์ที่สเตคไว้ได้หลังจากที่คุณตัดสินใจเลิกสเตค"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitlenme süresi, aynı zamanda bağlanmayı kaldırma veya dondurmayı kaldırma dönemi olarak da bilinir, stake edilen varlıklara, siz onları stake etmeye karar verdikten sonra erişilemez olduğu süredir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час блокування, також відомий як період розблокування або розморожування, — це тривалість, протягом якої ставлені активи недоступні після того, як ви вирішили їх скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لاک ٹائم، جسے ان بانڈنگ یا غیر منجمد کرنے کا دورانیہ بھی کہا جاتا ہے، وہ دورانیہ ہے جس کے دوران اسٹیک کیے گئے اثاثے ان اسٹیک کرنے کا فیصلہ کرنے کے بعد ناقابل رسائی ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian khóa, còn được gọi là thời gian hủy liên kết hoặc hủy đóng băng, là khoảng thời gian mà tài sản đã đặt cược không thể truy cập được sau khi bạn quyết định hủy đặt cược chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁等待期（也称解质押期或解冻期）是指发起解除质押后，质押资产暂时无法使用的等待时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖等待期（也稱解質押期或解凍期）是指發起解除質押後，質押資產暫時無法使用的等待時間。"
          }
        }
      }
    },
    "info.max_supply.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى لعدد العملات المعدنية التي ستوجد على الإطلاق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কখনও বিদ্যমান থাকবে এমন সর্বোচ্চ সংখ্যক কয়েন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximální počet mincí, které kdy budou existovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det maksimale antal mønter, der nogensinde vil eksistere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die maximale Anzahl an Münzen, die jemals existieren wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The maximum number of coins that will ever exist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número máximo de monedas que jamás existirán."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداکثر تعداد سکه‌هایی که تا به حال وجود خواهد داشت."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pinakamataas na bilang ng mga barya na iiral kailanman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre maximal de pièces qui existeront jamais."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Matsakaicin adadin tsabar kuɗi da za su wanzu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המספר המקסימלי של מטבעות שאי פעם יהיה קיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुल मिलाकर मौजूद सिक्कों की अधिकतम संख्या।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah maksimum koin yang akan pernah ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero massimo di monete che esisteranno mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "将来にわたって発行される可能性があるコインの最大数です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세상에 존재할 수 있는 동전의 최대 개수."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilangan maksimum syiling yang akan wujud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het maximale aantal munten dat ooit zal bestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalna liczba monet, która kiedykolwiek będzie istnieć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número máximo de moedas que jamais existirão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul maxim de monede care vor exista vreodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальное количество монет, которое когда-либо будет существовать."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Idadi ya juu zaidi ya sarafu zitakazokuwepo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเหรียญสูงสุดที่จะมีอยู่ตลอดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Var olabilecek maksimum madeni para sayısı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
