    "onboarding.accept_terms.item1.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفهم أنني المسؤول الوحيد عن أمان ونسخ احتياطي لمحافظي، وليس Gem."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি বুঝতে পারছি যে আমার ওয়ালেটের নিরাপত্তা এবং ব্যাকআপের জন্য আমি সম্পূর্ণরূপে দায়ী, Gem নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chápu, že za bezpečnost a zálohování svých peněženek nesu výhradní odpovědnost já, nikoli Gem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forstår, at jeg alene er ansvarlig for sikkerheden og backupen af mine tegnebøger, ikke Gem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist bewusst, dass ich allein für die Sicherheit und Sicherung meiner Wallets verantwortlich bin und nicht Gem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand that I am solely responsible for the security and backup of my wallets, not Gem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que soy el único responsable de la seguridad y el respaldo de mis billeteras, no Gem."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "من متوجه هستم که مسئولیت امنیت و پشتیبان‌گیری از کیف پول‌هایم فقط بر عهده‌ی خودم است، نه Gem."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naiintindihan ko na ako ang tanging responsable para sa seguridad at backup ng aking mga wallet, hindi si Gem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que je suis seul responsable de la sécurité et de la sauvegarde de mes portefeuilles, pas Gem."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fahimci cewa ni kaɗai ke da alhakin tsaro da ajiyar walat ɗina, ba Gem ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני מבין שאני האחראי הבלעדי לאבטחה ולגיבוי הארנקים שלי, לא Gem."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं समझता हूं कि मैं अपने वॉलेट की सुरक्षा और बैकअप के लिए पूरी तरह जिम्मेदार हूं, Gem नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya memahami bahwa saya bertanggung jawab penuh atas keamanan dan pencadangan dompet saya, bukan Gem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono consapevole che sono l'unico responsabile della sicurezza e del backup dei miei portafogli, non Gem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットのセキュリティとバックアップはすべて自分の責任であり、Gem は責任を負わないことを理解しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저는 Gem이 아닌 제 지갑의 보안과 백업에 대한 전적인 책임을 진다는 것을 이해합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya faham bahawa saya bertanggungjawab sepenuhnya untuk keselamatan dan sandaran dompet saya, bukan Gem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begrijp dat ik als enige verantwoordelijk ben voor de veiligheid en back-up van mijn wallets, niet Gem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiem, że za bezpieczeństwo i kopie zapasowe moich portfeli odpowiadam wyłącznie ja, a nie Gem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendo que sou o único responsável pela segurança e backup das minhas carteiras, não a Gem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înțeleg că eu sunt singurul responsabil pentru securitatea și backup-ul portofelelor mele, nu Gem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я понимаю, что ответственность за безопасность и резервное копирование моих кошельков несу исключительно я, а не Gem."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninaelewa kuwa ninawajibika pekee kwa usalama na hifadhi rudufu ya pochi zangu, si Gem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันเข้าใจว่าฉันเป็นผู้รับผิดชอบแต่เพียงผู้เดียวสำหรับการรักษาความปลอดภัยและการสำรองข้อมูลของกระเป๋าเงินของฉัน ไม่ใช่ Gem"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdanlarımın güvenliğinden ve yedeklemesinden yalnızca benim sorumlu olduğumu, Gem'in sorumlu olmadığını anlıyorum."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я розумію, що несу повну відповідальність за безпеку та резервне копіювання своїх гаманців, а не Gem."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں سمجھتا ہوں کہ میں اپنے بٹوے کی حفاظت اور بیک اپ کے لیے مکمل طور پر ذمہ دار ہوں، Gem نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi hiểu rằng tôi là người duy nhất chịu trách nhiệm về tính bảo mật và sao lưu ví của mình, không phải Gem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我明白钱包的安全备份由我自行负责，Gem 不承担任何责任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解錢包的安全與備份完全由我自行負責，Gem 不承擔任何責任。"
          }
        }
      }
    },
    "onboarding.accept_terms.item2.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أتفهم أن Gem ليس بنكًا أو بورصة، واستخدامه لأغراض غير قانونية محظور تمامًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি বুঝতে পারছি যে Gem কোনও ব্যাংক বা এক্সচেঞ্জ নয়, এবং অবৈধ উদ্দেশ্যে এটি ব্যবহার করা কঠোরভাবে নিষিদ্ধ।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chápu, že Gem není banka ani burza a jeho používání k nelegálním účelům je přísně zakázáno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forstår, at Gem ikke er en bank eller børs, og at det er strengt forbudt at bruge den til ulovlige formål."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist bewusst, dass Gem weder eine Bank noch eine Börse ist und dass die Nutzung für illegale Zwecke strengstens untersagt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand that Gem is not a bank or exchange, and using it for illegal purposes is strictly prohibited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que Gem no es un banco ni un exchange y que su uso con fines ilegales está estrictamente prohibido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "من متوجه هستم که Gem بانک یا صرافی نیست و استفاده از آن برای مقاصد غیرقانونی اکیداً ممنوع است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naiintindihan ko na ang Gem ay hindi isang bangko o exchange, at ang paggamit nito para sa mga iligal na layunin ay mahigpit na ipinagbabawal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que Gem n'est pas une banque ou une bourse et que son utilisation à des fins illégales est strictement interdite."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fahimci cewa Gem ba banki ba ne ko musanya, kuma an haramta amfani da shi don dalilai na doka."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני מבין ש-Gem אינו בנק או בורסה, והשימוש בו למטרות בלתי חוקיות אסור בהחלט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं समझता हूं कि Gem कोई बैंक या एक्सचेंज नहीं है, और इसका अवैध उद्देश्यों के लिए उपयोग करना सख्त वर्जित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya memahami bahwa Gem bukanlah bank atau bursa, dan menggunakannya untuk tujuan ilegal sangat dilarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono consapevole che Gem non è una banca o una borsa e che il suo utilizzo per scopi illegali è severamente proibito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemは銀行や取引所ではなく、違法目的での使用は禁止されていることを理解しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem은 은행이나 거래소가 아니며, 불법적인 목적으로 사용하는 것은 엄격히 금지되어 있다는 것을 알고 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya faham bahawa Gem bukan bank atau bursa, dan menggunakannya untuk tujuan yang menyalahi undang-undang adalah dilarang sama sekali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begrijp dat Gem geen bank of beurs is en dat het strikt verboden is om Gem voor illegale doeleinden te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiem, że Gem nie jest bankiem ani giełdą i używanie go w celach niezgodnych z prawem jest surowo zabronione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendo que o Gem não é um banco nem uma bolsa de valores, e usá-lo para fins ilegais é estritamente proibido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înțeleg că Gem nu este o bancă sau o bursă, iar utilizarea sa în scopuri ilegale este strict interzisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я понимаю, что Gem не является банком или биржей, и использование его в незаконных целях строго запрещено."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninaelewa kuwa Gem si benki au ubadilishaji, na kuitumia kwa madhumuni yasiyo halali ni marufuku kabisa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันเข้าใจว่า Gem ไม่ใช่ธนาคารหรือศูนย์แลกเปลี่ยน และการใช้เพื่อวัตถุประสงค์ที่ผิดกฎหมายถือเป็นสิ่งต้องห้ามอย่างเด็ดขาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem'in bir banka veya borsa olmadığını ve yasa dışı amaçlarla kullanılmasının kesinlikle yasak olduğunu anlıyorum."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я розумію, що Gem не є банком чи біржею, і його використання в незаконних цілях суворо заборонено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں سمجھتا ہوں کہ Gem ایک بینک یا ایکسچینج نہیں ہے، اور اسے غیر قانونی مقاصد کے لیے استعمال کرنا سختی سے ممنوع ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi hiểu rằng Gem không phải là ngân hàng hay sàn giao dịch và việc sử dụng Gem cho mục đích bất hợp pháp là hoàn toàn bị nghiêm cấm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我明白 Gem 不是银行或交易所，严禁将其用于非法用途。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解 Gem 不是銀行或交易所，嚴禁用於任何非法用途。"
          }
        }
      }
    },
    "onboarding.accept_terms.item3.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدرك أنه إذا فقدت إمكانية الوصول إلى محفظتي، فإن Gem ليست مسؤولة ولا يمكنها المساعدة بأي شكل من الأشكال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি বুঝি যে আমি যদি কখনো আমার ওয়ালেটে অ্যাক্সেস হারাই, তবে Gem দায়বদ্ধ নয় এবং কোনোভাবেই সাহায্য করতে পারবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chápu, že pokud někdy ztratím přístup ke svým peněženkám, Gem nenese žádnou odpovědnost a nemůže žádným způsobem pomoci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forstår, at hvis jeg nogensinde mister adgangen til mine tegnebøger, er Gem ikke ansvarlig og kan ikke hjælpe på nogen måde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist bewusst, dass Gem nicht haftbar ist und in keiner Weise helfen kann, wenn ich jemals den Zugriff auf meine Wallets verliere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand that if I ever lose access to my wallets, Gem is not liable and cannot help in any way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que si alguna vez pierdo el acceso a mis billeteras, Gem no es responsable y no puede ayudar de ninguna manera."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌دانم که اگر دسترسی به کیف پول‌هایم را از دست بدهم، Gem مسئولیتی ندارد و به هیچ وجه نمی‌تواند کمک کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naiintindihan ko na kung sakaling mawalan ako ng access sa aking mga wallet, walang pananagutan si Gem at hindi makakatulong sa anumang paraan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que si jamais je perds l'accès à mes portefeuilles, Gem n'est pas responsable et ne peut en aucun cas m'aider."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fahimci cewa idan na rasa damar shiga wallet dina, Gem ba abin dogaro bane kuma ba zai iya taimakawa ta kowace hanya ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני מבין שאם אי פעם אאבד גישה לארנקים שלי, Gem לא תישא באחריות ולא יכולה לעזור בשום צורה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं समझता हूं कि यदि मैं कभी भी अपने बटुए तक पहुंच खो देता हूं, तो Gem उत्तरदायी नहीं है और किसी भी तरह से मदद नहीं कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya memahami bahwa jika saya kehilangan akses ke dompet saya, Gem tidak bertanggung jawab dan tidak dapat membantu dengan cara apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capisco che se mai dovessi perdere l'accesso ai miei portafogli, Gem non sarà responsabile e non potrà aiutarmi in alcun modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットへのアクセスを失った場合、Gemは責任を負わず、支援もできないことを理解しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인은 지갑에 접근할 수 없는 경우 Gem이 책임을 지지 않으며 어떤 방식으로도 도움을 줄 수 없다는 점을 이해합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya faham bahawa jika saya kehilangan akses kepada dompet saya, Gem tidak bertanggungjawab dan tidak boleh membantu dalam apa jua cara."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begrijp dat als ik ooit de toegang tot mijn portemonnee verlies, Gem niet aansprakelijk is en op geen enkele manier kan helpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiem, że jeśli kiedykolwiek stracę dostęp do swoich portfeli, Gem nie ponosi odpowiedzialności i nie może w żaden sposób pomóc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendo que se eu perder o acesso às minhas carteiras, a Gem não será responsável e não poderá ajudar de forma alguma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înțeleg că, dacă pierd vreodată accesul la portofelele mele, Gem nu este responsabil și nu poate ajuta în niciun fel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я понимаю, что если я потеряю доступ к своим кошелькам, Gem не несет ответственности и не сможет оказать никакой помощи."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninaelewa kuwa nikipoteza ufikiaji wa pochi zangu, Gem haiwajibikiwi na haiwezi kusaidia kwa njia yoyote."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันเข้าใจว่าหากฉันสูญเสียการเข้าถึงกระเป๋าเงินของฉัน Gem จะไม่รับผิดชอบและไม่สามารถช่วยเหลือได้ในทางใดทางหนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdanlarıma erişimi kaybedersem Gem'in sorumlu olmayacağını ve hiçbir şekilde yardımcı olamayacağını anlıyorum."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я розумію, що якщо я коли-небудь втрачу доступ до своїх гаманців, Gem не несе відповідальності та не зможе жодним чином допомогти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں سمجھتا ہوں کہ اگر میں کبھی بھی اپنے بٹوے تک رسائی کھو دیتا ہوں تو Gem ذمہ دار نہیں ہے اور کسی بھی طرح مدد نہیں کر سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi hiểu rằng nếu tôi mất quyền truy cập vào ví của mình, Gem sẽ không chịu trách nhiệm pháp lý và không thể trợ giúp dưới bất kỳ hình thức nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我明白如果丢失钱包访问权限，Gem 不承担任何责任，也无法提供帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解若遺失錢包存取權限，Gem 不負任何責任且無法提供協助。"
          }
        }
      }
    },
    "onboarding.accept_terms.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى قراءة الشروط التالية والموافقة عليها قبل الاستمرار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালিয়ে যাওয়ার আগে অনুগ্রহ করে নিম্নলিখিত শর্তাবলী পড়ুন এবং তাতে সম্মত হন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před pokračováním si prosím přečtěte a souhlaste s následujícími podmínkami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læs og accepter venligst følgende vilkår, før du fortsætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte lesen Sie die folgenden Bedingungen und akzeptieren Sie sie, bevor Sie fortfahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please read and agree to the following terms before you continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lea y acepte los siguientes términos antes de continuar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لطفا قبل از ادامه، شرایط زیر را بخوانید و با آنها موافقت کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangyaring basahin at sumang-ayon sa mga sumusunod na tuntunin bago ka magpatuloy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez lire et accepter les conditions suivantes avant de continuer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Da fatan za a karanta kuma ku yarda da waɗannan sharuɗɗan kafin ku ci gaba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא קרא והסכים לתנאים הבאים לפני שתמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया आगे बढ़ने से पहले निम्नलिखित शर्तों को पढ़ें और उनसे सहमत हों।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harap baca dan setujui persyaratan berikut sebelum Anda melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di continuare, ti preghiamo di leggere e accettare i seguenti termini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行する前に、以下の利用規約をお読みいただき同意してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 진행하기 전에 다음 약관을 읽고 동의해 주시기 바랍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila baca dan bersetuju dengan syarat berikut sebelum anda meneruskan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees de volgende voorwaarden en ga ermee akkoord voordat u verdergaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed kontynuowaniem przeczytaj i zaakceptuj poniższe warunki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia e concorde com os seguintes termos antes de continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă rugăm să citiți și să acceptați următorii termeni înainte de a continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем продолжить, пожалуйста, прочтите и примите следующие условия."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafadhali soma na ukubali masharti yafuatayo kabla hujaendelea."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดอ่านและยอมรับเงื่อนไขต่อไปนี้ก่อนดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmeden önce lütfen aşağıdaki şartları okuyun ve kabul edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, прочитайте та погодьтеся з наступними умовами, перш ніж продовжити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاری رکھنے سے پہلے براہ کرم درج ذیل شرائط کو پڑھیں اور ان سے اتفاق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng đọc và đồng ý với các điều khoản sau trước khi tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请阅读并同意以下条款后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請閱讀並同意以下條款後繼續。"
          }
        }
      }
    },
