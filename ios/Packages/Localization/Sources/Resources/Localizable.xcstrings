          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang bilang ng mga barya na kasalukuyang magagamit at ipinagbibili sa merkado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
