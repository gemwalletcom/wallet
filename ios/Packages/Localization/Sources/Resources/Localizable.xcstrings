    "price_alerts.get_notified_explain_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على إشعار عندما يكون هناك تغيير كبير في سعر الأصول المشفرة المفضلة لديك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রিয় ক্রিপ্টো সম্পদের মূল্যের উল্লেখযোগ্য পরিবর্তন হলে বিজ্ঞপ্তি পান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte se upozornit, když dojde k významné změně ceny vašich oblíbených kryptoaktiv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få besked, når der er en betydelig prisændring på dine foretrukne kryptoaktiver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie sich benachrichtigen, wenn es bei Ihren bevorzugten Krypto-Assets zu einer erheblichen Preisänderung kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get notified when there's a significant price change in your favorite crypto assets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe notificaciones cuando haya un cambio de precio significativo en tus criptoactivos favoritos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگامی که تغییر قیمت قابل توجهی در دارایی های رمزنگاری مورد علاقه شما ایجاد می شود مطلع شوید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maabisuhan kapag may malaking pagbabago sa presyo sa iyong mga paboritong crypto asset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez averti lorsqu'il y a un changement de prix significatif dans vos actifs cryptographiques préférés."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Samun sanarwa lokacin da akwai gagarumin canjin farashi a cikin kadarorin crypto da kuka fi so."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבל הודעה כאשר יש שינוי משמעותי במחיר בנכסי הקריפטו המועדפים עליך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपकी पसंदीदा क्रिप्टो परिसंपत्तियों में कोई महत्वपूर्ण मूल्य परिवर्तन हो तो सूचना प्राप्त करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan pemberitahuan saat ada perubahan harga yang signifikan pada aset kripto favorit Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi una notifica quando si verifica una variazione significativa del prezzo delle tue criptovalute preferite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りの暗号資産の価格が大幅に変動したときに通知を受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾는 암호화폐의 가격이 크게 변동되면 알림을 받으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan makluman apabila terdapat perubahan harga yang ketara dalam aset kripto kegemaran anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang een melding wanneer er een aanzienlijke prijswijziging plaatsvindt in uw favoriete crypto-activa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj powiadomienia o znaczących zmianach cen Twoich ulubionych kryptowalut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja notificado quando houver uma mudança significativa de preço em seus criptoativos favoritos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primiți notificări când există o schimbare semnificativă a prețului activelor dvs. cripto preferate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте уведомления о значительном изменении цен на ваши любимые криптоактивы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pata arifa kunapokuwa na mabadiliko makubwa ya bei katika vipengee unavyovipenda vya crypto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับการแจ้งเตือนเมื่อมีการเปลี่ยนแปลงราคาที่สำคัญในสินทรัพย์ crypto ที่คุณชื่นชอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori kripto varlıklarınızda önemli bir fiyat değişikliği olduğunda bildirim alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуйте сповіщення, коли відбувається значна зміна ціни на ваші улюблені криптоактиви."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کے پسندیدہ کرپٹو اثاثوں میں قیمت میں نمایاں تبدیلی ہو تو اطلاع حاصل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận thông báo khi có thay đổi đáng kể về giá của tài sản tiền điện tử yêu thích của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当关注的加密资产出现大幅波动时，立即收到通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喜愛的加密資產價格大幅變動時收到通知。"
          }
        }
      }
    },
