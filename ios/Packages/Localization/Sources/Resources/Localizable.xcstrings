        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment pouvons-nous vous aider ?"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaya za mu taimaka?"
