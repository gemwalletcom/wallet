    "swap.price_impact_warning.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستخسر %@ من رصيدك %@ في هذه الصفقة. هل أنت متأكد من رغبتك في المتابعة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ট্রেডে আপনি %@ হারাবেন, যা আপনার %@ এর একটি অংশ। আপনি কি নিশ্চিত যে এগিয়ে যেতে চান?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto obchodu ztratíte %@ z vašich %@. Jste si jisti, že chcete pokračovat?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil miste %@ af dine %@ i denne handel. Er du sikker på, at du vil fortsætte?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verlieren bei diesem Handel %@ Ihrer %@. Möchten Sie wirklich fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will lose %@ of your %@ in this trade. Are you sure you want to proceed?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderás %@ de tus %@ en esta operación. ¿Estás seguro de que deseas continuar?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما %@ از %@ خود را در این معامله از دست خواهید داد. آیا مطمئن هستید که می خواهید ادامه دهید؟"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mawawalan ka ng %@ ng iyong %@ sa trade na ito. Sigurado ka bang gusto mong magpatuloy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous perdrez %@ de vos %@ lors de cette transaction. Voulez-vous vraiment continuer ?"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ku rasa %@ na %@ naku a cikin wannan cinikin. Kun tabbata kuna son ci gaba?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה תפסיד %@ מה- %@ שלך במסחר הזה. האם אתה בטוח שאתה רוצה להמשיך?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस व्यापार में आप अपना %@ %@ देंगे। क्या आप वाकई आगे बढ़ना चाहते हैं?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan kehilangan %@ dari %@ Anda dalam perdagangan ini. Apakah Anda yakin ingin melanjutkan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderai %@ dei tuoi %@ in questa operazione. Vuoi procedere?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この取引では %@ の損失が発生します（対象資産：%@）。続行してもよろしいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 거래에서 %@을(를) 잃게 되며, 이는 보유하신 %@의 일부입니다. 계속하시겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan kehilangan %@ daripada %@ anda dalam perdagangan ini. Adakah anda pasti mahu meneruskan?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U verliest %@ van uw %@ in deze transactie. Weet u zeker dat u wilt doorgaan?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stracisz %@ swojego %@ w tej transakcji. Czy na pewno chcesz kontynuować?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você perderá %@ dos seus %@ nesta negociação. Tem certeza de que deseja prosseguir?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vei pierde %@ din %@ în această tranzacție. Ești sigur că vrei să continui?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы потеряете %@ из ваших %@ в этой сделке. Вы уверены, что хотите продолжить?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Utapoteza %@ ya %@ yako katika biashara hii. Je, una uhakika unataka kuendelea?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะสูญเสีย %@ จาก %@ ของคุณในการซื้อขายครั้งนี้ คุณแน่ใจหรือไม่ว่าต้องการดำเนินการต่อ?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlemde %@ kaybedeceksiniz; bu, %@ varlığınızın bir kısmıdır. Devam etmek istediğinizden emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви втратите %@ із своїх %@ у цій торгівлі. Ви впевнені, що бажаєте продовжити?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اس تجارت میں %@ اپنے %@ کا کھو دیں گے۔ کیا آپ واقعی آگے بڑھنا چاہتے ہیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ mất %@ trong số %@ của mình trong giao dịch này. Bạn có chắc chắn muốn tiếp tục không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次交易将损失 %@ 的 %@。确定要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次交易將損失 %@ 的 %@。確定要繼續嗎？"
          }
        }
      }
    },
