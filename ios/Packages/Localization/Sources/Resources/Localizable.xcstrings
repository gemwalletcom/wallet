    "secret_phrase.confirm.quick_test.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل هذا الاختبار السريع للتأكد من أنك قمت بحفظ كل شيء بشكل صحيح."
