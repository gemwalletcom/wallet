    "errors.balances_activity_outdated": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تكون الأرصدة والنشاط غير محدثة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যালেন্স এবং কার্যকলাপ পুরনো হতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatky a aktivita mohou být zastaralé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldi og aktivitet kan være forældede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guthaben und Aktivität sind möglicherweise nicht aktuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balances and activity may be outdated."
          }
        },
        "es": {
