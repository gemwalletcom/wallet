            "value": "Ta transakcja wymaga %@, ale dostępne jest tylko %@. Aby kontynuować, potrzebujesz jeszcze %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transação requer %@, mas apenas %@ estão disponíveis. Você precisa de mais %@ para continuar."
