    "banner.account_activation.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب شبكة %@ رسومًا لمرة واحدة قدرها %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ নেটওয়ার্কের জন্য %@ এর এককালীন ফি প্রয়োজন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Síť %@ vyžaduje jednorázový poplatek %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ netværket kræver et engangsgebyr på %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das %@ Netzwerk erfordert eine einmalige Gebühr von %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ network requires a one time fee of %@."
