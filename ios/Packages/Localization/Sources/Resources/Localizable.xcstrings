    "receive.warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا عنوانك — أرسل فقط %@ على %@ شبكة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনার ঠিকানা — শুধুমাত্র পাঠান %@ উপরে %@ নেটওয়ার্ক।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je vaše adresa – pouze pro odeslání %@ na %@ síť."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er din adresse — kun forsendelse %@ på %@ netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist Ihre Adresse – bitte senden Sie nur %@ auf %@ Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your address — send only %@ on the %@ network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es tu dirección: envía solo %@ en la red %@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این آدرس شماست — فقط ارسال %@ روی %@ شبکه."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ito ang iyong address — ipadala lamang %@ sa %@ network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici votre adresse — envoyez uniquement %@ sur le réseau %@."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan shine adireshinka — aika kawai %@ a kan %@ hanyar sadarwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זוהי הכתובת שלך - שליחה בלבד %@ על ה- %@ רֶשֶׁת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपका पता है — केवल %@ ही %@ नेटवर्क पर भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini alamat Anda — kirim saja %@ pada %@ jaringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il tuo indirizzo: invia solo %@ sulla rete %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスには、%@ のみを %@ ネットワークで送金してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소는 귀하의 주소입니다. %@만 %@ 네트워크에서 보내세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini alamat anda — hantar sahaja %@ pada %@ rangkaian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is uw adres — alleen verzenden %@ op de %@ netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest Twój adres — wysyłaj tylko %@ na %@ sieć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o seu endereço — envie apenas %@ na rede %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta este adresa dvs. — trimiteți doar %@ în rețeaua %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ваш адрес — отправляйте только %@ на %@ сеть."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hii ni anwani yako — tuma pekee %@ kwenye %@ mtandao."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือที่อยู่ของคุณ — ส่งเฉพาะ %@ บนเครือข่าย %@ เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sizin adresiniz — yalnızca %@ varlığını %@ ağında gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це ваша адреса - надсилайте тільки %@ в мережі %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آپ کا پتہ ہے - صرف بھیجیں۔ %@ پر %@ نیٹ ورک"
