    "info.perpetual.open_interest.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمثل الفائدة المفتوحة القيمة الإجمالية لجميع العقود الدائمة القائمة التي لم يتم تسويتها. ويوفر نظرة ثاقبة لنشاط السوق والسيولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উন্মুক্ত সুদ সমস্ত অসামান্য চিরস্থায়ী চুক্তির মোট মূল্যের প্রতিনিধিত্ব করে যা নিষ্পত্তি করা হয়নি। এটি বাজারের কার্যকলাপ এবং তারল্য সম্পর্কে অন্তর্দৃষ্টি প্রদান করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřený úrok představuje celkovou hodnotu všech nesplacených trvalých smluv, které nebyly vypořádány. Poskytuje pohled na tržní aktivitu a likviditu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åben rente repræsenterer den samlede værdi af alle udestående evige kontrakter, der ikke er blevet afviklet. Det giver indsigt i markedsaktivitet og likviditet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das offene Interesse stellt den Gesamtwert aller ausstehenden unbefristeten Verträge dar, die noch nicht abgewickelt wurden. Es bietet Einblick in die Marktaktivität und Liquidität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open interest represents the total value of all outstanding perpetual contracts that have not been settled. It provides insight into market activity and liquidity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El interés abierto representa el valor total de todos los contratos perpetuos pendientes que no se han liquidado. Proporciona información sobre la actividad y la liquidez del mercado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بهره باز نشان دهنده ارزش کل تمام قراردادهای دائمی معوق است که تسویه نشده است. بینشی در مورد فعالیت بازار و نقدینگی ارائه می دهد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang bukas na interes ay kumakatawan sa kabuuang halaga ng lahat ng hindi pa nababayarang panghabang-buhay na mga kontrata na hindi pa nababayaran. Nagbibigay ito ng pananaw sa aktibidad ng merkado at pagkatubig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts ouverts représentent la valeur totale de tous les contrats perpétuels en cours qui n'ont pas été réglés. Il donne un aperçu de l'activité et de la liquidité du marché."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Buɗaɗɗen sha'awa tana wakiltar jimillar ƙimar duk wasu fitattun kwangiloli na dindindin waɗanda ba a daidaita su ba. Yana ba da haske game da ayyukan kasuwa da yawan ruwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוזיציות פתוחות מייצגות את הערך הכולל של כל החוזים התמידיים שטרם הוסדרו. הוא מספק תובנות לגבי פעילות השוק והנזילות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ओपन इंटरेस्ट उन सभी बकाया स्थायी अनुबंधों के कुल मूल्य का प्रतिनिधित्व करता है जिनका निपटान नहीं किया गया है। यह बाज़ार गतिविधि और तरलता के बारे में जानकारी प्रदान करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Open interest mewakili nilai total seluruh kontrak perpetual yang belum diselesaikan. Ini memberikan wawasan tentang aktivitas pasar dan likuiditas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'interesse aperto rappresenta il valore totale di tutti i contratti perpetui in essere che non sono stati regolati. Fornisce informazioni sull'attività del mercato e sulla liquidità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未決済建玉は、決済されていないすべてのパーペチュアル契約の合計価値を表し、市場の活発さや流動性の指標となります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미결제약정은 아직 결제되지 않은 모든 미결제 무기한 계약의 총 가치를 나타냅니다. 이는 시장 활동과 유동성에 대한 통찰력을 제공합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Faedah terbuka mewakili jumlah nilai semua kontrak kekal tertunggak yang belum dijelaskan. Ia memberikan pandangan tentang aktiviti pasaran dan kecairan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open interest vertegenwoordigt de totale waarde van alle uitstaande eeuwigdurende contracten die nog niet zijn afgewikkeld. Het geeft inzicht in de marktactiviteit en liquiditeit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarte odsetki reprezentują łączną wartość wszystkich pozostających do spłaty kontraktów wieczystych, które nie zostały rozliczone. Zapewnia wgląd w aktywność rynkową i płynność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os contratos em aberto representam o valor total de todos os contratos perpétuos pendentes que não foram liquidados. Ele fornece informações sobre a atividade e a liquidez do mercado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Interesul deschis reprezintă valoarea totală a tuturor contractelor perpetue restante care nu au fost decontate. Oferă o perspectivă asupra activității pieței și a lichidității."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытый интерес представляет собой общую стоимость всех непогашенных бессрочных контрактов, расчеты по которым еще не произведены. Он дает представление о рыночной активности и ликвидности."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Riba ya wazi inawakilisha jumla ya thamani ya kandarasi zote za kudumu ambazo hazijatatuliwa. Inatoa maarifa juu ya shughuli za soko na ukwasi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดอกเบี้ยคงเหลือแสดงถึงมูลค่ารวมของสัญญาระยะยาวคงค้างทั้งหมดที่ยังไม่ได้ชำระ ให้ข้อมูลเชิงลึกเกี่ยวกับกิจกรรมทางการตลาดและสภาพคล่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık faiz, ödenmemiş tüm kalıcı sözleşmelerin toplam değerini temsil eder. Piyasa faaliyetleri ve likidite hakkında bilgi sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкритий інтерес представляє собою загальну вартість усіх незавершених безстрокових контрактів, які не були розраховані. Він дає уявлення про ринкову активність і ліквідність."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کھلی دلچسپی ان تمام بقایا دائمی معاہدوں کی کل قیمت کی نمائندگی کرتی ہے جن کا تصفیہ نہیں ہوا ہے۔ یہ مارکیٹ کی سرگرمی اور لیکویڈیٹی کے بارے میں بصیرت فراہم کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lãi suất mở thể hiện tổng giá trị của tất cả các hợp đồng vĩnh viễn chưa thanh toán chưa được thanh toán. Nó cung cấp cái nhìn sâu sắc về hoạt động thị trường và tính thanh khoản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未平仓量是所有尚未结算的永续合约总价值，可反映市场活跃度和流动性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未平倉量是所有尚未結算的永續合約總價值，可反映市場活躍程度和流動性。"
          }
        }
      }
    },
