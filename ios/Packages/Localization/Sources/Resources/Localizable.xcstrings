    "search.state.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من التهجئة أو حاول إجراء بحث جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বানান পরীক্ষা করুন অথবা নতুন করে অনুসন্ধান করে দেখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte pravopis nebo zkuste nové vyhledávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek stavningen eller prøv en ny søgning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die Rechtschreibung oder versuchen Sie eine neue Suche."
