    "nodes.import_node.warning_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تكون العقد المخصصة ضارة وقد تكشف بيانات معاملاتك أو تقدم معلومات خاطئة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাস্টম নোডগুলি ক্ষতিকারক হতে পারে এবং আপনার লেনদেনের ডেটা প্রকাশ করতে পারে বা মিথ্যা তথ্য প্রদান করতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní uzly mohou být škodlivé a mohou zveřejnit vaše transakční data nebo poskytovat nepravdivé informace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brugerdefinerede noder kan være skadelige og kan eksponere dine transaktionsdata eller give falske oplysninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefinierte Knoten können bösartig sein und Ihre Transaktionsdaten offenlegen oder falsche Informationen liefern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom nodes can be malicious and may expose your transaction data or provide false information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nodos personalizados pueden ser maliciosos y pueden exponer sus datos de transacciones o proporcionar información falsa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گره‌های سفارشی می‌توانند مخرب باشند و ممکن است داده‌های تراکنش شما را افشا کنند یا اطلاعات نادرست ارائه دهند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga custom node ay maaaring maging malisyoso at maaaring maglantad ng iyong data ng transaksyon o magbigay ng maling impormasyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nœuds personnalisés peuvent être malveillants et exposer vos données de transaction ou fournir de fausses informations."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Maɓallan da aka keɓance na iya zama masu cutarwa kuma suna iya fallasa bayanan ma'amalar ku ko kuma samar da bayanan karya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צמתים מותאמים אישית עלולים להיות זדוניים ולחשוף את נתוני העסקאות שלך או לספק מידע כוזב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कस्टम नोड्स दुर्भावनापूर्ण हो सकते हैं और आपके लेनदेन डेटा को उजागर कर सकते हैं या गलत जानकारी प्रदान कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Node kustom dapat bersifat berbahaya dan dapat membocorkan data transaksi Anda atau memberikan informasi palsu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nodi personalizzati possono essere dannosi e potrebbero esporre i dati delle transazioni o fornire informazioni false."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムノードは悪意のある第三者によって運営されている可能性があり、取引データの漏えいや虚偽情報の提供につながるおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 노드는 악의적일 수 있으며 거래 데이터를 노출하거나 허위 정보를 제공할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nod tersuai boleh berniat jahat dan mungkin mendedahkan data transaksi anda atau memberikan maklumat palsu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste nodes kunnen kwaadaardig zijn en uw transactiegegevens blootleggen of valse informatie verstrekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Węzły niestandardowe mogą mieć charakter złośliwy i ujawniać dane transakcji lub podawać fałszywe informacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nós personalizados podem ser maliciosos e expor seus dados de transação ou fornecer informações falsas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodurile personalizate pot fi rău intenționate și pot expune datele tranzacțiilor sau pot furniza informații false."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательские узлы могут быть вредоносными и способны раскрыть данные ваших транзакций или предоставить ложную информацию."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodi maalum zinaweza kuwa na nia mbaya na zinaweza kufichua data ya muamala wako au kutoa taarifa za uongo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหนดที่กำหนดเองอาจเป็นอันตรายและอาจเปิดเผยข้อมูลธุรกรรมของคุณหรือให้ข้อมูลเท็จได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel düğümler kötü amaçlı olabilir ve işlem verilerinizi ifşa edebilir veya yanlış bilgi sağlayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користувацькі вузли можуть бути шкідливими та розкривати дані ваших транзакцій або надавати неправдиву інформацію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حسب ضرورت نوڈس بدنیتی پر مبنی ہو سکتے ہیں اور آپ کے لین دین کے ڈیٹا کو بے نقاب کر سکتے ہیں یا غلط معلومات فراہم کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các node tùy chỉnh có thể chứa mã độc và có thể làm lộ dữ liệu giao dịch của bạn hoặc cung cấp thông tin sai lệch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义节点可能存在恶意，可能会泄露交易数据或提供虚假信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂節點可能是惡意節點，並可能洩露交易資料或提供不實資訊。"
          }
        }
      }
    },
    "notifications.inapp.state.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستجد هنا تحديثات حول إشعاراتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বিজ্ঞপ্তি সম্পর্কে আপডেটগুলি এখানে দেখতে পাবেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí aktuální informace o vašich oznámeních"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se opdateringer om dine notifikationer her"
