    "errors.scan_transaction.malicious.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إكمال هذه المعاملة - عنوان المحفظة الوجهة مرتبط بنشاط مشبوه أو ضار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লেনদেনটি সম্পন্ন করা যাবে না — গন্তব্যস্থলের ওয়ালেট ঠিকানাটি সন্দেহজনক বা ক্ষতিকারক কার্যকলাপের সাথে যুক্ত।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto transakci nelze dokončit – cílová adresa peněženky je spojena s podezřelou nebo škodlivou aktivitou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne transaktion kan ikke gennemføres — destinationsadressen på tegnebogen er knyttet til mistænkelig eller skadelig aktivitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Transaktion kann nicht abgeschlossen werden – die Ziel-Wallet-Adresse ist mit verdächtigen oder schädlichen Aktivitäten verknüpft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This transaction cannot be completed — the destination wallet address is linked to suspicious or harmful activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transacción no se puede completar: la dirección de la billetera de destino está vinculada a actividades sospechosas o dañinas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تراکنش قابل انجام نیست — آدرس کیف پول مقصد به فعالیت مشکوک یا مضر مرتبط است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang transaksyong ito ay hindi makukumpleto — ang patutunguhang wallet address ay naka-link sa kahina-hinala o nakakapinsalang aktibidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette transaction ne peut être effectuée — l'adresse du portefeuille de destination est liée à une activité suspecte ou malveillante."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba za a iya kammala wannan ma'amala ba - adireshin walat ɗin da ake nufi yana da alaƙa da ayyuka masu ban tsoro ko cutarwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להשלים עסקה זו - כתובת ארנק היעד מקושרת לפעילות חשודה או מזיקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लेनदेन पूरा नहीं किया जा सकता - गंतव्य वॉलेट पता संदिग्ध या हानिकारक गतिविधि से जुड़ा हुआ है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi ini tidak dapat diselesaikan — alamat dompet tujuan terkait dengan aktivitas yang mencurigakan atau berbahaya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa transazione non può essere completata: l'indirizzo del portafoglio di destinazione è collegato ad attività sospette o dannose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この取引は完了できません。送信先アドレスが不審または悪意のある活動に関連しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 거래를 완료할 수 없습니다. 대상 지갑 주소가 의심스럽거나 유해한 활동과 연결되어 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus niaga ini tidak dapat diselesaikan — alamat dompet destinasi dipautkan kepada aktiviti yang mencurigakan atau berbahaya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze transactie kan niet worden voltooid: het adres van de bestemmingswallet is gekoppeld aan verdachte of schadelijke activiteiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można ukończyć tej transakcji — adres portfela docelowego jest powiązany z podejrzaną lub szkodliwą aktywnością."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transação não pode ser concluída — o endereço da carteira de destino está vinculado a atividades suspeitas ou prejudiciais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această tranzacție nu poate fi finalizată — adresa portofelului de destinație este legată de o activitate suspectă sau dăunătoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту транзакцию невозможно завершить — адрес кошелька назначения связан с подозрительной или вредоносной активностью."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala huu hauwezi kukamilika - anwani ya pochi lengwa imeunganishwa na shughuli za kutiliwa shaka au hatari."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถทำธุรกรรมนี้ให้เสร็จสมบูรณ์ได้ — ที่อยู่กระเป๋าเงินปลายทางเชื่อมโยงกับกิจกรรมที่น่าสงสัยหรือเป็นอันตราย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem tamamlanamıyor; hedef cüzdan adresi şüpheli veya zararlı bir etkinlikle bağlantılı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю транзакцію неможливо завершити — адреса гаманця призначення пов'язана з підозрілою або шкідливою активністю."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ لین دین مکمل نہیں کیا جا سکتا — منزل مقصود والیٹ کا پتہ مشکوک یا نقصان دہ سرگرمی سے منسلک ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch này không thể hoàn tất — địa chỉ ví đích được liên kết với hoạt động đáng ngờ hoặc có hại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成此交易：目标钱包地址与可疑或恶意行为有关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成此交易：收款錢包位址與可疑或惡意行為有關。"
          }
        }
      }
    },
