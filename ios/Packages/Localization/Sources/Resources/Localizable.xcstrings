    "swap.slippage_auto_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد تلقائيًا أفضل انزلاق لإتمام المبادلة بنجاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সফল সোয়াপের জন্য স্বয়ংক্রিয়ভাবে সেরা স্লিপেজ নির্ধারণ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky nastaví nejlepší skluz pro úspěšný swap."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver automatisk den bedste slippage for en vellykket swap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt automatisch die beste Slippage für einen erfolgreichen Swap fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically set the best slippage for a successful swap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece automáticamente el mejor deslizamiento para un swap exitoso."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌طور خودکار بهترین لغزش را برای مبادله موفق تنظیم می‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Awtomatikong itinatakda ang pinakamahusay na pagkadulas para sa matagumpay na swap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit automatiquement le meilleur glissement pour un échange réussi."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana saita mafi kyawun zamewa ta atomatik don samun nasarar musaya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגדיר אוטומטית את ההחלקה הטובה ביותר להחלפה מוצלחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफल स्वैप के लिए स्वचालित रूप से सर्वोत्तम स्लिपेज सेट करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara otomatis menetapkan slippage terbaik untuk swap yang berhasil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta automaticamente lo slippage migliore per uno swap riuscito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワップを成功させるための最適なスリッページを自動的に設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성공적인 스왑을 위해 최적의 슬리피지를 자동으로 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menetapkan gelinciran terbaik secara automatik untuk pertukaran yang berjaya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt automatisch de beste slippage in voor een succesvolle swap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie ustawia najlepszy poślizg dla udanej wymiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define automaticamente o melhor deslizamento para uma troca bem-sucedida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează automat cea mai bună alunecare pentru un swap reușit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически устанавливает оптимальное проскальзывание для успешного обмена."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huweka kuteleza bora kiotomatiki kwa ubadilishaji uliofaulu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าสลิปเพจที่ดีที่สุดโดยอัตโนมัติเพื่อการสว็อปที่สำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarılı bir takas için en iyi kaymayı otomatik olarak ayarlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично встановлює найкраще прослизання для успішного обміну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کامیاب سویپ کے لیے بہترین سلیپج خودکار طور پر مقرر کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động đặt mức trượt giá tốt nhất để hoán đổi thành công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动设置最佳滑点以确保兑换成功。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動設定最佳滑點以確保兌換成功。"
          }
        }
      }
