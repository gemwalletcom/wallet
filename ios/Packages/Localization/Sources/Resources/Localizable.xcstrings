    "activity.state.empty.search_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح عوامل التصفية لتحديث أنشطتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কার্যকলাপ রিফ্রেশ করতে ফিল্টার সাফ করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazáním filtrů obnovíte své aktivity"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryd filtre for at opdatere dine aktiviteter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen Sie die Filter, um Ihre Aktivitäten zu aktualisieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear filters to refresh your activities"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia los filtros para refrescar tus actividades"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فیلترها را پاک کنید تا فعالیت‌هایتان را به‌روزرسانی کنید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-clear ang mga filter para i-refresh ang iyong mga aktibidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacez les filtres pour actualiser vos activités"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Share masu tacewa don sabunta ayyukanku"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקה מסננים כדי לרענן את הפעילויות שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी गतिविधियों को ताज़ा करने के लिए फ़िल्टर साफ़ करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus filter untuk menyegarkan aktivitas Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella i filtri per aggiornare le tue attività"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルターをクリアしてアクティビティを更新する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동을 새로 고치려면 필터를 지우세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan penapis untuk menyegarkan aktiviti anda"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filters wissen om uw activiteiten te vernieuwen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyść filtry, aby odświeżyć swoje działania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe os filtros para atualizar suas atividades"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergeți filtrele pentru a vă reîmprospăta activitățile"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистите фильтры, чтобы обновить ваши действия"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Futa vichujio ili kuonyesha upya shughuli zako"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างตัวกรองเพื่อรีเฟรชกิจกรรมของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitelerinizi yenilemek için filtreleri temizleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистіть фільтри, щоб оновити свої дії"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی سرگرمیوں کو تازہ کرنے کے لیے فلٹرز صاف کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa bộ lọc để làm mới hoạt động của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空筛选条件后将重新加载交易"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除篩選條件以重新整理交易紀錄"
          }
        }
      }
    },
