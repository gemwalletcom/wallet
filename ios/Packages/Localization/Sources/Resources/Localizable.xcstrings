    "banner.activate_asset.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاستخدام الأصل %@ ، يجب عليك أولاً تمكينه على شبكة %@ من خلال استيفاء المتطلبات المحددة للشبكة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ সম্পদ ব্যবহার করতে, আপনাকে প্রথমে নেটওয়ার্কের নির্দিষ্ট প্রয়োজনীয়তা পূরণ করে %@ নেটওয়ার্কে এটি সক্রিয় করতে হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li použít aktivum %@, musíte jej nejprve povolit v síti %@ splněním specifických požadavků sítě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at bruge %@-aktivet skal du først aktivere det på %@-netværket ved at opfylde netværkets specifikke krav."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um das %@ -Asset zu verwenden, müssen Sie es zuerst im %@ -Netzwerk aktivieren, indem Sie die spezifischen Anforderungen des Netzwerks erfüllen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use the %@ asset, you must first enable it on the %@ network by fulfilling the network's specific requirements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para utilizar el activo %@, primero debe habilitarlo en la red %@ cumpliendo con los requisitos específicos de la red."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای استفاده از دارایی %@ ، ابتدا باید آن را در شبکه %@ با انجام الزامات خاص شبکه فعال کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Upang magamit ang asset na %@, dapat mo muna itong paganahin sa %@ network sa pamamagitan ng pagtupad sa mga partikular na kinakailangan ng network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser la ressource %@, vous devez d'abord l'activer sur le réseau %@ en remplissant les exigences spécifiques du réseau."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Don amfani da kadarar %@, dole ne ka fara kunna ta akan hanyar sadarwar %@ ta hanyar cika takamaiman buƙatun cibiyar sadarwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להשתמש בנכס %@, תחילה עליך להפעיל אותו ברשת %@ על ידי מילוי הדרישות הספציפיות של הרשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ एसेट का उपयोग करने के लिए, आपको पहले नेटवर्क की विशिष्ट आवश्यकताओं को पूरा करके इसे %@ नेटवर्क पर सक्षम करना होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan aset %@, Anda harus terlebih dahulu mengaktifkannya di jaringan %@ dengan memenuhi persyaratan khusus jaringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per utilizzare la risorsa %@, è necessario prima abilitarla sulla rete %@ soddisfacendo i requisiti specifici della rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を利用するには、%@ ネットワーク固有の要件を満たして有効化する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 자산을 사용하려면 먼저 네트워크의 특정 요구 사항을 충족하여 %@ 네트워크에서 해당 자산을 활성화해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan aset %@, anda mesti mendayakannya pada rangkaian %@ terlebih dahulu dengan memenuhi keperluan khusus rangkaian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als u de asset %@ wilt gebruiken, moet u deze eerst inschakelen op het netwerk %@ door te voldoen aan de specifieke vereisten van het netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby użyć zasobu %@, należy najpierw włączyć go w sieci %@ spełniając określone wymagania sieciowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar o ativo %@, você deve primeiro habilitá-lo na rede %@ atendendo aos requisitos específicos da rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a utiliza activul %@, trebuie mai întâi să îl activați în rețeaua %@ îndeplinind cerințele specifice ale rețelei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы использовать актив %@, необходимо сначала включить его в сети %@ выполнив особые требования сети."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ili kutumia kipengee %@, lazima kwanza uiwashe kwenye mtandao wa %@ kwa kutimiza mahitaji mahususi ya mtandao."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการใช้สินทรัพย์ %@ ก่อนอื่นคุณต้องเปิดใช้งานบนเครือข่าย %@ โดยปฏิบัติตามข้อกำหนดเฉพาะของเครือข่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ varlığını kullanmak için, öncelikle ağın özel gereksinimlerini karşılayarak %@ ağında etkinleştirmeniz gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб використовувати ресурс %@, ви повинні спочатку ввімкнути його в мережі %@ виконавши спеціальні вимоги мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ اثاثہ استعمال کرنے کے لیے، آپ کو پہلے نیٹ ورک کی مخصوص ضروریات کو پورا کرتے ہوئے اسے %@ نیٹ ورک پر فعال کرنا ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để sử dụng tài sản %@, trước tiên bạn phải bật nó trên mạng %@ bằng cách đáp ứng các yêu cầu cụ thể của mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用 %@ 资产，必须先在 %@ 网络上启用它，并满足该网络的特定要求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要使用 %@ 資產，必須先符合 %@ 網路的特定要求，才能啟用該資產。"
          }
        }
      }
    },
    "banner.asset_status.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون الرمز غير آمن أو مضللاً. تابع فقط إذا كنت تثق به تمامًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টোকেন অনিরাপদ বা বিভ্রান্তিকর হতে পারে। আপনি সম্পূর্ণরূপে বিশ্বাস করলেই এগিয়ে যান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Token může být nebezpečný nebo zavádějící. Pokračujte, pouze pokud tomu plně důvěřujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Token kan være usikker eller vildledende. Fortsæt kun, hvis du har fuld tillid til det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token kann unsicher oder irreführend sein. Fahren Sie nur fort, wenn Sie ihm voll und ganz vertrauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Token may be unsafe or misleading. Proceed only if you fully trust it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token puede ser inseguro o engañoso. Continúe sólo si confía plenamente en ello."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز ممکن است ناامن یا گمراه کننده باشد. فقط در صورت اعتماد کامل به آن ادامه دهید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring hindi ligtas o mapanlinlang ang token. Magpatuloy lamang kung lubos mong pinagkakatiwalaan ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton peut être dangereux ou trompeur. Ne procédez que si vous lui faites pleinement confiance."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamar na iya zama mara lafiya ko yaudara. Ci gaba kawai idan kun amince da shi sosai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האסימון עשוי להיות לא בטוח או מטעה. המשך רק אם אתה סומך עליו לחלוטין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टोकन असुरक्षित या भ्रामक हो सकता है. अगर आपको इस पर पूरा भरोसा है तो ही आगे बढ़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token mungkin tidak aman atau menyesatkan. Lanjutkan hanya jika Anda sepenuhnya memercayainya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il token potrebbe essere pericoloso o fuorviante. Procedi solo se ti fidi completamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンは安全でないか、誤解を招く可能性があります。完全に信頼できる場合のみ続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰은 안전하지 않거나 오해의 소지가 있을 수 있습니다. 완전히 신뢰하는 경우에만 진행하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Token mungkin tidak selamat atau mengelirukan. Teruskan hanya jika anda mempercayainya sepenuhnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Token kan onveilig of misleidend zijn. Ga alleen verder als u er volledig op vertrouwt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Token może być niebezpieczny lub wprowadzać w błąd. Kontynuuj tylko wtedy, gdy w pełni mu ufasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O token pode ser inseguro ou enganoso. Prossiga apenas se você confiar totalmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokenul poate fi nesigur sau înșelător. Continuați doar dacă aveți deplină încredere în el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Токен может быть небезопасным или вводить в заблуждение. Продолжайте, только если вы полностью ему доверяете."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ishara inaweza kuwa si salama au inapotosha. Endelea tu ikiwa unaiamini kikamilifu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทเค็นอาจไม่ปลอดภัยหรือทำให้เข้าใจผิด ดำเนินการต่อเมื่อคุณเชื่อถืออย่างเต็มที่เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Token güvenli olmayabilir veya yanıltıcı olabilir. Yalnızca tamamen güveniyorsanız devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Маркер може бути небезпечним або оманливим. Продовжуйте, лише якщо ви повністю довіряєте цьому."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹوکن غیر محفوظ یا گمراہ کن ہو سکتا ہے۔ صرف اس صورت میں آگے بڑھیں جب آپ کو اس پر مکمل اعتماد ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã thông báo có thể không an toàn hoặc gây hiểu lầm. Chỉ tiếp tục nếu bạn hoàn toàn tin tưởng nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代币可能不安全或具有误导性。请仅在完全信任的情况下继续操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代幣可能不安全或具有誤導性。請僅在完全信任的情況下繼續操作。"
          }
        }
      }
    },
