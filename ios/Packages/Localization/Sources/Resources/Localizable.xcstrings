    "rewards.unverified.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تفعيل المكافآت تلقائيًا كلما زاد استخدامك للتطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অ্যাপটি যত বেশি ব্যবহার করবেন, পুরস্কারগুলো তত স্বয়ংক্রিয়ভাবে সক্রিয় হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odměny se aktivují automaticky, jakmile aplikaci používáte více."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Belønninger aktiveres automatisk, når du bruger appen mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prämien werden automatisch aktiviert, je mehr Sie die App nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewards activate automatically as you use the app more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las recompensas se activan automáticamente a medida que usas más la aplicación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با استفاده بیشتر از برنامه، جوایز به طور خودکار فعال می‌شوند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Awtomatikong naa-activate ang mga reward habang mas madalas mong ginagamit ang app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les récompenses s'activent automatiquement à mesure que vous utilisez l'application."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lada yana kunna ta atomatik yayin da kake amfani da app ɗin sosai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרסים מופעלים אוטומטית ככל שתשתמשו יותר באפליקציה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे-जैसे आप ऐप का अधिक उपयोग करेंगे, पुरस्कार स्वचालित रूप से सक्रिय हो जाएंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadiah akan aktif secara otomatis seiring Anda semakin sering menggunakan aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I premi si attivano automaticamente man mano che utilizzi l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを使い続けると、ポイント機能が自動的に有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 더 많이 사용할수록 보상이 자동으로 활성화됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganjaran diaktifkan secara automatik apabila anda menggunakan aplikasi dengan lebih kerap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je beloningen worden automatisch geactiveerd naarmate je de app meer gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrody aktywują się automatycznie w miarę jak częściej korzystasz z aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As recompensas são ativadas automaticamente conforme você usa o aplicativo com mais frequência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recompensele se activează automat pe măsură ce utilizați aplicația mai mult."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Награды активируются автоматически по мере более частого использования приложения."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawadi huamilishwa kiotomatiki unapotumia programu zaidi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รางวัลจะเปิดใช้งานโดยอัตโนมัติเมื่อคุณใช้งานแอปมากขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı daha çok kullandıkça ödüller otomatik olarak etkinleşir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Винагороди активуються автоматично, коли ви більше користуєтеся додатком."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ ایپ کو زیادہ استعمال کرتے ہیں تو انعامات خود بخود فعال ہوجاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần thưởng sẽ tự động được kích hoạt khi bạn sử dụng ứng dụng nhiều hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续使用应用，积分功能会自动激活。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續使用 App，積分功能會自動啟用。"
          }
        }
      }
    },
