    "simulation.warning_externally_owned_spender_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمح هذه الموافقة لعنوان محفظة عادي (EOA) باستخدام أصولك. أكّد فقط إذا كنت تثق بهذا العنوان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অনুমোদন একটি সাধারণ ওয়ালেট ঠিকানাকে (EOA) আপনার সম্পদ ব্যবহার করতে দেয়। আপনি এই ঠিকানাকে বিশ্বাস করলেই নিশ্চিত করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto schválení umožní běžné adrese peněženky (EOA) používat vaše aktiva. Potvrďte pouze tehdy, pokud této adrese důvěřujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne godkendelse lader en almindelig walletadresse (EOA) bruge dine aktiver. Bekræft kun, hvis du har tillid til denne adresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Genehmigung erlaubt einer normalen Wallet-Adresse (EOA), Ihre Assets zu verwenden. Bestätigen Sie nur, wenn Sie dieser Adresse vertrauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This approval lets a regular wallet address (EOA) use your assets. Confirm only if you trust this address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aprobación permite que una dirección de billetera normal (EOA) use tus activos. Confirma solo si confías en esta dirección."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تأییدیه به یک آدرس کیف پول معمولی (EOA) اجازه می‌دهد از دارایی‌های شما استفاده کند. فقط اگر به این آدرس اعتماد دارید تأیید کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinahayaan ng pag-aprubang ito ang isang karaniwang wallet address (EOA) na gamitin ang iyong mga asset. Kumpirmahin lang kung pinagkakatiwalaan mo ang address na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette approbation permet à une adresse de portefeuille classique (EOA) d’utiliser vos actifs. Confirmez uniquement si vous faites confiance à cette adresse."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan amincewar tana ba adireshin walat na yau da kullum (EOA) damar amfani da kadarorinku. Tabbatar kawai idan kun amince da wannan adireshin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אישור זה מאפשר לכתובת ארנק רגילה (EOA) להשתמש בנכסים שלך. אשר רק אם אתה סומך על כתובת זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्वीकृति एक सामान्य वॉलेट पते (EOA) को आपकी संपत्तियों का उपयोग करने देती है। केवल तभी पुष्टि करें जब आप इस पते पर भरोसा करते हों।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persetujuan ini memungkinkan alamat dompet biasa (EOA) menggunakan aset Anda. Konfirmasikan hanya jika Anda mempercayai alamat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa approvazione consente a un normale indirizzo wallet (EOA) di usare i tuoi asset. Conferma solo se ti fidi di questo indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この承認により、通常のウォレットアドレス（EOA）がウォレット内の資産を使用できるようになります。このアドレスを信頼できる場合のみ確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 승인은 일반 지갑 주소(EOA)가 내 자산을 사용할 수 있게 합니다. 이 주소를 신뢰하는 경우에만 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelulusan ini membenarkan alamat dompet biasa (EOA) menggunakan aset anda. Sahkan hanya jika anda mempercayai alamat ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met deze goedkeuring kan een gewoon walletadres (EOA) uw assets gebruiken. Bevestig alleen als u dit adres vertrouwt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zatwierdzenie pozwala zwykłemu adresowi portfela (EOA) używać Twoich aktywów. Potwierdź tylko wtedy, gdy ufasz temu adresowi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aprovação permite que um endereço de carteira comum (EOA) use seus ativos. Confirme somente se você confia neste endereço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această aprobare permite unei adrese obișnuite de portofel (EOA) să folosească activele tale. Confirmă doar dacă ai încredere în această adresă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это разрешение позволяет обычному адресу кошелька (EOA) использовать ваши активы. Подтверждайте только если доверяете этому адресу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Idhini hii inaruhusu anwani ya kawaida ya pochi (EOA) kutumia mali zako. Thibitisha tu ikiwa unaiamini anwani hii."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอนุมัตินี้ทำให้ที่อยู่กระเป๋าเงินทั่วไป (EOA) สามารถใช้สินทรัพย์ของคุณได้ ยืนยันเฉพาะเมื่อคุณเชื่อถือที่อยู่นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu onay, normal bir cüzdan adresinin (EOA) varlıklarınızı kullanmasına izin verir. Yalnızca bu adrese güveniyorsanız onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це схвалення дозволяє звичайній адресі гаманця (EOA) використовувати ваші активи. Підтверджуйте лише якщо довіряєте цій адресі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ منظوری ایک عام والیٹ ایڈریس (EOA) کو آپ کے اثاثے استعمال کرنے دیتی ہے۔ صرف اس صورت میں تصدیق کریں جب آپ اس ایڈریس پر اعتماد کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phê duyệt này cho phép một địa chỉ ví thông thường (EOA) sử dụng tài sản của bạn. Chỉ xác nhận nếu bạn tin tưởng địa chỉ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此授权允许普通钱包地址 (EOA) 使用你的资产。仅在你信任该地址时确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此授權允許一般錢包位址（EOA）使用您的資產。僅在您信任此位址時確認。"
          }
        }
      }
    },
