    "info.no_quote.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إرجاع عرض الأسعار لزوج الرمز المميز المحدد، ربما بسبب انخفاض المبلغ، أو نقص السيولة، أو القيود الفنية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত টোকেন জোড়ার জন্য একটি উদ্ধৃতি ফেরত দিতে অক্ষম, সম্ভবত কম পরিমাণ, তারল্যের অভাব, অথবা প্রযুক্তিগত সীমাবদ্ধতার কারণে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze vrátit cenovou nabídku pro vybraný pár tokenů, pravděpodobně z důvodu nízkého množství, nedostatku likvidity nebo technických omezení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke returnere en pris for det valgte tokenpar, muligvis på grund af lavt beløb, manglende likviditet eller tekniske begrænsninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das ausgewählte Token-Paar kann kein Angebot zurückgegeben werden, möglicherweise aufgrund eines geringen Betrags, mangelnder Liquidität oder technischer Einschränkungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to return a quote for the selected token pair, possibly due to low amount, lack of liquidity, or technical limitations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede devolver una cotización para el par de tokens seleccionado, posiblemente debido a una cantidad baja, falta de liquidez o limitaciones técnicas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امکان ارائه قیمت برای جفت توکن انتخاب شده وجود ندارد، احتمالاً به دلیل مبلغ کم، کمبود نقدینگی یا محدودیت‌های فنی."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maibalik ang isang quote para sa napiling pares ng token, posibleng dahil sa mababang halaga, kakulangan ng pagkatubig, o mga teknikal na limitasyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de renvoyer un devis pour la paire de jetons sélectionnée, probablement en raison d'un faible montant, d'un manque de liquidité ou de limitations techniques."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba za a iya dawo da ƙididdiga don nau'in alamar da aka zaɓa ba, maiyuwa saboda ƙarancin ƙima, ƙarancin ruwa, ko iyakan fasaha."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להחזיר הצעת מחיר עבור זוג האסימונים שנבחר, כנראה עקב סכום נמוך, חוסר נזילות או מגבלות טכניות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित टोकन जोड़ी के लिए कोटेशन लौटाने में असमर्थ, संभवतः कम राशि, तरलता की कमी, या तकनीकी सीमाओं के कारण।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengembalikan kutipan untuk pasangan token yang dipilih, mungkin karena jumlahnya rendah, kurangnya likuiditas, atau keterbatasan teknis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile restituire una quotazione per la coppia di token selezionata, probabilmente a causa dell'importo basso, della mancanza di liquidità o di limitazioni tecniche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したトークンペアの見積もりを取得できません。取引額が小さすぎる、流動性が不足している、または技術的な制約がある可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 토큰 쌍에 대한 견적을 반환할 수 없습니다. 금액이 부족하거나, 유동성이 부족하거나, 기술적 한계가 있을 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengembalikan sebut harga untuk pasangan token yang dipilih, mungkin disebabkan oleh jumlah yang rendah, kekurangan kecairan atau pengehadan teknikal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kan geen offerte worden geretourneerd voor het geselecteerde tokenpaar, mogelijk vanwege een te laag bedrag, gebrek aan liquiditeit of technische beperkingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zwrócić wyceny dla wybranej pary tokenów, prawdopodobnie z powodu zbyt niskiej kwoty, braku płynności lub ograniczeń technicznych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível retornar uma cotação para o par de tokens selecionado, possivelmente devido à baixa quantidade, falta de liquidez ou limitações técnicas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se poate returna o cotație pentru perechea de tokenuri selectată, posibil din cauza sumei mici, a lipsei de lichiditate sau a limitărilor tehnice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно вернуть котировку для выбранной пары токенов, возможно, из-за низкой суммы, отсутствия ликвидности или технических ограничений."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haikuweza kurejesha nukuu kwa jozi ya tokeni iliyochaguliwa, labda kwa sababu ya kiasi kidogo, ukosefu wa ukwasi, au vikwazo vya kiufundi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถส่งคืนใบเสนอราคาสำหรับคู่โทเค็นที่เลือกได้ อาจเป็นเพราะจำนวนเงินน้อย ขาดสภาพคล่อง หรือข้อจำกัดทางเทคนิค"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen token çifti için bir fiyat teklifi döndürülemiyor; bunun nedeni muhtemelen düşük miktar, likidite eksikliği veya teknik sınırlamalar olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо повернути котирування для вибраної пари токенів, можливо через малу суму, брак ліквідності або технічні обмеження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکنہ طور پر کم رقم، لیکویڈیٹی کی کمی، یا تکنیکی حدود کی وجہ سے منتخب کردہ ٹوکن جوڑے کے لیے کوئی اقتباس واپس کرنے سے قاصر ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể trả về báo giá cho cặp mã thông báo đã chọn, có thể do số lượng thấp, thiếu thanh khoản hoặc hạn chế về mặt kỹ thuật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取所选代币对的报价，可能是由于交易金额过小、流动性不足或技术限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法提供所選代幣對的報價，可能是因為金額過低、流動性不足或技術限制。"
          }
        }
      }
    },
    "info.perpetual.auto_close.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق مركزك تلقائيًا عند مستويات الأسعار المحددة. جني الأرباح يُثبّت الأرباح، ووقف الخسارة يحدّ من الخسائر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্ধারিত মূল্য স্তরে আপনার পজিশন স্বয়ংক্রিয়ভাবে বন্ধ করুন। টেক প্রফিট লাভকে আটকে রাখে, স্টপ লস লোকসানকে সীমাবদ্ধ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky uzavřete svou pozici na stanovených cenových úrovních. Funkce Take Profit blokuje zisky, Stop Loss omezuje ztráty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Luk automatisk din position ved fastsatte prisniveauer. Take Profit låser gevinster, Stop Loss begrænser tab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie Ihre Position automatisch bei festgelegten Preisniveaus. Take Profit sichert Gewinne, Stop Loss begrenzt Verluste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically close your position at set price levels. Take Profit locks in gains, Stop Loss limits losses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra tu posición automáticamente a precios establecidos. El Take Profit fija las ganancias y el Stop Loss limita las pérdidas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعیت خود را به طور خودکار در سطوح قیمت تعیین شده ببندید. برداشت سود، سود را قفل می‌کند، و توقف ضرر، ضرر را محدود می‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Awtomatikong isara ang iyong posisyon sa nakatakdang antas ng presyo. Pinapanatili ng Take Profit ang mga kita, nililimitahan ng Stop Loss ang mga pagkalugi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clôturez automatiquement votre position à des niveaux de prix définis. Le Take Profit verrouille vos gains, tandis que le Stop Loss limite vos pertes."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rufe matsayinka ta atomatik a saita matakan farashi. Ɗauki makullin riba a cikin riba, Dakatar da Asara yana iyakance asara."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סגור אוטומטית את הפוזיציה שלך ברמות מחיר קבועות. Take Profit נועל רווחים, Stop Loss מגביל הפסדים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्धारित मूल्य स्तरों पर अपनी पोजीशन स्वचालित रूप से बंद करें। टेक प्रॉफिट लाभ को लॉक करता है, स्टॉप लॉस नुकसान को सीमित करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup posisi Anda secara otomatis pada level harga yang ditentukan. Take Profit mengunci keuntungan, Stop Loss membatasi kerugian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi automaticamente la tua posizione a livelli di prezzo prestabiliti. Il Take Profit blocca i guadagni, mentre lo Stop Loss limita le perdite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した価格レベルでポジションを自動的に決済します。テイクプロフィットで利益を確定し、ストップロスで損失を制限します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정된 가격 수준에서 자동으로 포지션을 청산합니다. 이익실현(Take Profit)은 수익을 확정하고, 손절매(Stop Loss)는 손실을 제한합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup kedudukan anda secara automatik pada tahap harga yang ditetapkan. Ambil Untung mengunci keuntungan, Henti Kerugian menghadkan kerugian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit uw positie automatisch op ingestelde prijsniveaus. Take Profit vergrendelt winsten, Stop Loss beperkt verliezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie zamykaj pozycje po ustalonych cenach. Take Profit zabezpiecza zyski, Stop Loss ogranicza straty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche sua posição automaticamente em níveis de preço definidos. O Take Profit garante os ganhos, o Stop Loss limita as perdas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Închide automat poziția la nivelurile de preț stabilite. Funcția Take Profit blochează câștigurile, iar funcția Stop Loss limitează pierderile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически закрывает позицию по достижении заданного уровня цены. Тейк-профит фиксирует прибыль, стоп-лосс ограничивает убытки."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Funga nafasi yako kiotomatiki katika viwango vya bei vilivyowekwa. Take Profit hulinda faida, Stop Loss hupunguza hasara."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดสถานะของคุณโดยอัตโนมัติเมื่อถึงระดับราคาที่กำหนด Take Profit ล็อกกำไร Stop Loss จำกัดการขาดทุน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozisyonunuzu belirlenen fiyat seviyelerinde otomatik olarak kapatın. Kâr Al özelliği kazançlarınızı sabitler, Zarar Durdur özelliği ise kayıplarınızı sınırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично закривайте свою позицію за встановленими ціновими рівнями. Тейк-профіт фіксує прибутки, а стоп-лос обмежує збитки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی پوزیشن کو مقررہ قیمت کی سطح پر خودکار طور پر بند کریں۔ ٹیک پرافٹ منافع کو محفوظ کرتا ہے، اسٹاپ لاس نقصان کو محدود کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động đóng vị thế của bạn ở mức giá đã đặt. Chốt lời khóa lợi nhuận, Cắt lỗ hạn chế thua lỗ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以设定的价格自动平仓。止盈锁定收益，止损限制损失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以設定的價格自動平倉。止盈鎖定收益，止損限制損失。"
          }
        }
      }
    },
    "info.perpetual.funding_apr.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعدل السنوي الذي تدفع به صفقات الشراء صفقات البيع (إذا كانت سلبية، تدفع صفقات البيع صفقات شراء). لا توجد رسوم مرتبطة بالتمويل، وهو عبارة عن تحويل من نظير إلى نظير بين المستخدمين لدفع الأسعار نحو السعر الفوري."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বার্ষিক হারে লংস শর্টস প্রদান করে (যদি নেতিবাচক, শর্টস লং পে করে)। তহবিলের সাথে সম্পর্কিত কোন ফি নেই, যা স্পট প্রাইসের দিকে দাম ঠেলে দেওয়ার জন্য ব্যবহারকারীদের মধ্যে পিয়ার-টু-পিয়ার স্থানান্তর।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Anualizovaná sazba, jakou longs platí shorts (pokud jsou záporné, shorts platí longs). S financováním nejsou spojeny žádné poplatky, což je peer-to-peer převod mezi uživateli za účelem tlačení cen směrem k spotové ceně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den årlige sats, hvormed longs betaler shorts (hvis negative, shorts pay longs). Der er ingen gebyrer forbundet med finansiering, som er en peer-to-peer-overførsel mellem brugere for at presse priserne mod spotprisen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der auf das Jahr umgerechnete Zinssatz, zu dem Long-Positionen Short-Positionen zahlen (bei negativem Wert zahlen Short-Positionen Long-Positionen). Mit der Finanzierung sind keine Gebühren verbunden, es handelt sich um einen Peer-to-Peer-Transfer zwischen Nutzern, um die Preise in Richtung des Spotpreises zu drücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The annualized rate at which longs pay shorts (if negative, shorts pay longs). There are no fees associated with funding, which is a peer-to-peer transfer between users to push prices towards the spot price."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tasa anualizada a la que los largos pagan a los cortos (si es negativa, los cortos pagan a los largos). No hay tarifas asociadas con la financiación, que es una transferencia de igual a igual entre usuarios para impulsar los precios hacia el precio al contado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نرخ سالانه ای که در آن لانگ ها به شورت پرداخت می کنند (اگر منفی باشد، شورت ها به لانگ پرداخت می کنند). هیچ کارمزدی در ارتباط با تامین مالی وجود ندارد، که انتقالی همتا به همتا بین کاربران است تا قیمت ها را به سمت قیمت لحظه ای سوق دهد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang taunang rate kung saan nagbabayad ang longs ng shorts (kung negatibo, ang shorts ay nagbabayad ng longs). Walang mga bayarin na nauugnay sa pagpopondo, na isang peer-to-peer na paglipat sa pagitan ng mga user upang itulak ang mga presyo patungo sa presyo ng lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux annualisé auquel les positions longues paient les positions courtes (si négatif, les positions courtes paient les positions longues). Il n'y a aucun frais associé au financement, qui est un transfert peer-to-peer entre utilisateurs pour pousser les prix vers le prix spot."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Matsakaicin adadin shekara-shekara wanda masu doguwa ke biyan masu gajere (idan mara kyau, masu gajere suna biyan masu doguwa). Babu wasu kudade da ke da alaƙa da kudade, wanda shine canja wuri tsakanin-tsara tsakanin masu amfani don tura farashin zuwa farashin tabo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השיעור השנתי שבו לונג משלם שורט (אם שלילי, שורט משלם לונג). אין עמלות הקשורות למימון, שהוא העברה עמית לעמית בין משתמשים כדי לדחוף את המחירים לכיוון מחיר הספוט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वार्षिक दर जिस पर लॉन्ग शॉर्ट्स को भुगतान करते हैं (यदि नकारात्मक, शॉर्ट्स लॉन्ग्स को भुगतान करते हैं)। फंडिंग से जुड़ी कोई फीस नहीं है, जो कीमतों को स्पॉट कीमत की ओर बढ़ाने के लिए उपयोगकर्ताओं के बीच एक पीयर-टू-पीयर ट्रांसफर है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkat tahunan di mana posisi long membayar posisi short (jika negatif, posisi short membayar posisi long). Tidak ada biaya yang terkait dengan pendanaan, yang merupakan transfer peer-to-peer antar pengguna untuk mendorong harga menuju harga spot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso annualizzato al quale le posizioni long pagano le posizioni short (se negativo, le posizioni short pagano le posizioni long). Non sono previste commissioni associate al finanziamento, che è un trasferimento peer-to-peer tra utenti per spingere i prezzi verso il prezzo spot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロングがショートに支払うファンディングの年率換算値です（マイナスの場合はショートがロングに支払います）。ファンディングは、パーペチュアル価格を現物価格に近づけるためにユーザー間で行われる直接支払いで、別途手数料はかかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매수자가 매도자에게 지급하는 연간 비율입니다(음수인 경우 매도자가 매수자에게 지급). 가격을 현물 가격으로 끌어올리기 위해 사용자 간에 P2P(Peer-to-Peer) 전송을 수행하는 자금 조달과 관련된 수수료는 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar tahunan di mana long membayar short (jika negatif, short membayar long). Tiada yuran yang berkaitan dengan pembiayaan, yang merupakan pemindahan rakan ke rakan antara pengguna untuk menolak harga ke arah harga spot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het op jaarbasis berekende percentage waarmee longs shorts betalen (indien negatief, shorts betalen longs). Er zijn geen kosten verbonden aan financiering, wat een peer-to-peer overdracht tussen gebruikers is om de prijzen richting de spotprijs te duwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Roczna stopa procentowa, według której pozycje długie opłacają pozycje krótkie (jeśli wartość ujemna, pozycje krótkie opłacają pozycje długie). Nie ma żadnych opłat związanych z finansowaniem, które stanowi transfer typu peer-to-peer pomiędzy użytkownikami w celu podniesienia cen w kierunku ceny spot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa anualizada pela qual as posições compradas pagam as posições vendidas (se for negativa, as posições vendidas pagam as posições compradas). Não há taxas associadas ao financiamento, que é uma transferência ponto a ponto entre usuários para empurrar os preços em direção ao preço à vista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rata anualizată la care plățile lungi plătesc scurt-uri (dacă este negativ, scurt-urile plătesc lungi). Nu există taxe asociate cu finanțarea, care este un transfer peer-to-peer între utilizatori pentru a împinge prețurile către prețul spot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Годовая ставка, по которой длинные позиции платят коротким позициям (если она отрицательная, короткие позиции платят длинным позициям). Никаких комиссий, связанных с финансированием, которое представляет собой одноранговую передачу между пользователями для подталкивания цен к спотовой цене."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiwango cha kila mwaka ambacho nafasi ndefu hulipa nafasi fupi (ikiwa hasi, nafasi fupi hulipa nafasi ndefu). Hakuna ada zinazohusishwa na ufadhili, ambao ni uhamishaji kati ya watumiaji ili kusukuma bei kuelekea bei inayotarajiwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตรารายปีที่สัญญา Long จ่าย Short (หากติดลบ Short จะจ่าย Long) ไม่มีค่าธรรมเนียมที่เกี่ยวข้องกับการระดมทุน ซึ่งเป็นการโอนแบบเพียร์ทูเพียร์ระหว่างผู้ใช้เพื่อดันราคาไปสู่ราคาสปอต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun pozisyonların kısa pozisyon ödediği yıllık oran (negatifse kısa pozisyonların uzun pozisyon ödediği). Fiyatları spot fiyata doğru itmek için kullanıcılar arasında eşler arası transfer olan finansmanla ilgili herhangi bir ücret yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Річна ставка, за якою довгі позиції платять за короткі позиції (якщо від'ємна, короткі позиції платять за довгі позики). Немає жодної комісії, пов'язаної з фінансуванням, яке є одноранговою передачею між користувачами для підвищення цін до спотової ціни."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سالانہ شرح جس پر لانگ شارٹس ادا کرتا ہے (اگر منفی، شارٹس لانگ ادا کرتے ہیں)۔ فنڈنگ ​​سے وابستہ کوئی فیس نہیں ہے، جو کہ قیمتوں کو اسپاٹ پرائس کی طرف دھکیلنے کے لیے صارفین کے درمیان پیئر ٹو پیئر ٹرانسفر ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tỷ lệ hàng năm mà người mua trả tiền cho người bán (nếu âm, người bán trả tiền cho người mua). Không có phí liên quan đến tài trợ, đó là chuyển khoản ngang hàng giữa những người dùng để đẩy giá về giá giao ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多头向空头支付的年化资金费率（为负时由空头向多头支付）。资金费是用户之间的点对点支付，不另收手续费，用于使永续合约价格接近现货价格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多頭向空頭支付的年化資金費率（為負時由空頭向多頭支付）。資金費是使用者之間的點對點支付，不另收手續費，用於使永續合約價格接近現貨價格。"
          }
        }
      }
    },
