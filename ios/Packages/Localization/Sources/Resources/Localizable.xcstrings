    "transfer.reserved_fees": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تركنا %@ في رصيدك لتغطية رسوم الشبكة المستقبلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভবিষ্যতের নেটওয়ার্ক ফি মেটানোর জন্য আমরা আপনার ব্যালেন্সে %@ রেখে দিয়েছি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vašem zůstatku jsme nechali %@ na pokrytí budoucích poplatků za síť."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har efterladt %@ på din saldo til dækning af fremtidige netværksgebyrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben %@ auf Ihrem Guthaben belassen, um zukünftige Netzwerkgebühren abzudecken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We've left %@ in your balance to cover future network fees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos dejado %@ en su saldo para cubrir futuras tarifas de red."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ما %@ را برای پوشش هزینه‌های شبکه در آینده در موجودی شما باقی گذاشته‌ایم."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniwan namin ang %@ sa iyong balanse upang mabayaran ang mga bayarin sa network sa hinaharap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons laissé %@ sur votre solde pour couvrir les futurs frais de réseau."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mun bar %@ cikin ma'auni don biyan kuɗin hanyar sadarwa na gaba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השארנו %@ ביתרה שלך לכיסוי עמלות רשת עתידיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने भविष्य में नेटवर्क शुल्क को कवर करने के लिए आपके बैलेंस में %@ छोड़ दिया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah meninggalkan %@ di saldo Anda untuk menutupi biaya jaringan di masa mendatang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo lasciato %@ nel tuo saldo per coprire le future commissioni di rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後のネットワーク手数料として、残高から %@ を確保しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "향후 네트워크 수수료를 충당하기 위해 잔액에 %@ 남겨두었습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah meninggalkan %@ dalam baki anda untuk menampung yuran rangkaian masa hadapan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben %@ op uw saldo laten staan om toekomstige netwerkkosten te dekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostawiliśmy %@ na Twoim koncie na pokrycie przyszłych opłat sieciowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixamos %@ em seu saldo para cobrir futuras taxas de rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am lăsat %@ în soldul dumneavoastră pentru a acoperi viitoarele taxe de rețea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы оставили %@ на вашем балансе для покрытия будущих сетевых сборов."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumeacha %@ katika salio lako ili kulipia ada za mtandao za siku zijazo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราได้เหลือ %@ ไว้ในยอดคงเหลือของคุณเพื่อครอบคลุมค่าธรรมเนียมเครือข่ายในอนาคต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelecekteki ağ ücretlerini karşılamak için bakiyenizde %@ bıraktık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми залишили на вашому балансі %@ для покриття майбутніх мережевих платежів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم نے مستقبل کے نیٹ ورک فیس کو پورا کرنے کے لیے آپ کے بیلنس میں %@ چھوڑ دیا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã để lại %@ trong số dư của bạn để trang trải phí mạng trong tương lai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在余额中预留 %@，用于支付后续网络费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留 %@ 的餘額，以支付後續網路手續費。"
          }
        }
      }
    },
