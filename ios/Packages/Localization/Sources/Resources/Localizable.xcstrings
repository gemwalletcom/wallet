            "state": "translated",
            "value": "Scannez ou collez le code pour vous connecter à la DApp"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba ko liƙa lamba don haɗi zuwa DApp"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרוק או הדבק קוד כדי להתחבר ל-DApp"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DApp से कनेक्ट करने के लिए कोड स्कैन करें या पेस्ट करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai atau tempel kode untuk terhubung ke DApp"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona o incolla il codice per connetterti alla DApp"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードをスキャンするか貼り付けて、DAppに接続してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DApp에 연결하려면 코드를 스캔하거나 붙여넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbas atau tampal kod untuk menyambung ke DApp"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan of plak de code om verbinding te maken met de DApp"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj lub wklej kod, aby połączyć się z aplikacją DApp"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie ou cole o código para conectar ao DApp"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanați sau lipiți codul pentru a vă conecta la DApp"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте или вставьте код для подключения к DApp"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Changanua au ubandike msimbo ili kuunganisha kwenye DApp"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนหรือวางรหัสเพื่อเชื่อมต่อกับ DApp"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DApp'e bağlanmak için kodu tarayın veya yapıştırın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відскануйте або вставте код для підключення до DApp"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "DApp سے جڑنے کے لیے کوڈ کو اسکین یا پیسٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét hoặc dán mã để kết nối với DApp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描二维码或粘贴连接链接，以连接 DApp"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描 QR 碼或貼上連線連結，以連線至 DApp"
          }
        }
      }
    },
