    "onboarding.security.create_wallet.no_recovery.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا فقدت عبارتك السرية، فإنك تفقد القدرة على الوصول إلى محفظتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যদি আপনার গোপন বাক্যাংশ হারান, আপনি আপনার ওয়ালেট অ্যাক্সেস হারাবেন."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud ztratíte tajnou frázi, ztratíte přístup ke své peněžence."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du mister din hemmelige sætning, mister du adgangen til din pung."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie Ihre geheime Phrase verlieren, verlieren Sie den Zugriff auf Ihre Wallet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you lose your secret phrase, you lose access to your wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si pierde su frase secreta, perderá el acceso a su billetera."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر عبارت مخفی خود را گم کنید، دسترسی به کیف پول خود را از دست خواهید داد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung mawala mo ang iyong sikretong parirala, mawawalan ka ng access sa iyong wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous perdez votre phrase secrète, vous perdez l'accès à votre portefeuille."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Idan ka rasa kalmar sirrinka, ka rasa damar shiga walat ɗinka."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם אתה מאבד את הביטוי הסודי שלך, אתה מאבד את הגישה לארנק שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप अपना गुप्त वाक्यांश खो देते हैं, तो आप अपने वॉलेट तक पहुंच खो देंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda kehilangan frasa rahasia, Anda kehilangan akses ke dompet Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdi la tua frase segreta, perderai l'accesso al tuo portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズを紛失すると、ウォレットにアクセスできなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호 문구를 잃어버리면 지갑에 접근할 수 없게 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda kehilangan frasa rahsia anda, anda kehilangan akses kepada dompet anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als u uw geheime zin verliest, verliest u de toegang tot uw portemonnee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli zgubisz swoją tajną frazę, stracisz dostęp do swojego portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você perder sua frase secreta, perderá o acesso à sua carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă îți pierzi fraza secretă, pierzi accesul la portofel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы потеряете секретную фразу, вы потеряете доступ к своему кошельку."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukipoteza maneno yako ya siri, utapoteza ufikiaji wa mkoba wako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณสูญเสียรหัสลับ คุณจะสูญเสียการเข้าถึงกระเป๋าเงินของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli cümlenizi kaybederseniz cüzdanınıza erişiminizi kaybedersiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви втратите секретну фразу, ви втратите доступ до свого гаманця."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ اپنا خفیہ جملہ کھو دیتے ہیں، تو آپ اپنے بٹوے تک رسائی کھو دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn làm mất cụm từ bí mật, bạn sẽ mất quyền truy cập vào ví của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助记词一旦丢失，将无法访问钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助記詞一旦遺失，將無法存取錢包。"
          }
        }
      }
    },
