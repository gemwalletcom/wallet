        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैक करने के लिए सिक्के जोड़कर उन्हें सक्षम करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan mereka dengan menambahkan koin untuk dilacak"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilitali aggiungendo monete per tracciarli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡するコインを追加して有効にしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적에 동전을 추가하여 활성화하세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayakan mereka dengan menambahkan syiling untuk dijejaki"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel ze in door munten toe te voegen aan de track"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz je, dodając monety do śledzenia"
          }
        },
