        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sami %@ maki ga kowane aboki da ya shiga."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לִזכּוֹת %@ נקודות לכל חבר שמצטרף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमाना %@ जितने दोस्त जुड़ेंगे, उतने ही पॉइंट्स मिलेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghasilkan %@ poin untuk setiap teman yang bergabung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guadagnare %@ punti per ogni amico che si iscrive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達が1人参加するごとに、%@ ポイントを獲得できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벌다 %@ 친구가 가입할 때마다 포인트를 획득합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan %@ mata untuk setiap rakan yang menyertai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdienen %@ punten voor elke vriend die meedoet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarabiaj %@ punktów za każdego dołączonego znajomego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganhar %@ Pontos para cada amigo que se inscrever."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câştiga %@ puncte pentru fiecare prieten care se alătură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарабатывай %@ баллов за каждого друга, который присоединится."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pata %@ pointi kwa kila rafiki anayejiunga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้รับ %@ รับคะแนนสะสมสำหรับเพื่อนแต่ละคนที่เข้าร่วม"
