    "onboarding.security.create_wallet.intro.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستحصل على عبارة سرية - إنها الطريقة الوحيدة للوصول إلى محفظتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি একটি গোপন বাক্যাংশ পাবে — এটি তোমার ওয়ালেট অ্যাক্সেস করার একমাত্র উপায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostanete tajnou frázi – je to jediný způsob, jak se dostat ke své peněžence."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får en hemmelig sætning – det er den eneste måde at få adgang til din tegnebog på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erhalten eine geheime Phrase – nur so können Sie auf Ihr Wallet zugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will get a Secret Phrase — it's the only way to access your wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás una frase secreta: es la única forma de acceder a tu billetera."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما یک عبارت مخفی دریافت خواهید کرد - این تنها راه برای دسترسی به کیف پول شما است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makakakuha ka ng Secret Phrase — ito lang ang paraan para ma-access ang iyong wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevrez une phrase secrète : c'est le seul moyen d'accéder à votre portefeuille."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ku sami kalmar sirri - ita ce kawai hanyar samun damar walat ɗin ku."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקבל ביטוי סודי - זו הדרך היחידה לגשת לארנק שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको एक गुप्त वाक्यांश मिलेगा - यह आपके वॉलेट तक पहुंचने का एकमात्र तरीका है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan mendapatkan Frasa Rahasia — itu satu-satunya cara untuk mengakses dompet Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceverai una frase segreta: è l'unico modo per accedere al tuo portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズが作成されます。ウォレットにアクセスする唯一の手段です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 비밀 문구를 받게 될 것입니다. 이것이 당신의 지갑에 접근할 수 있는 유일한 방법입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan mendapat Frasa Rahsia — ia adalah satu-satunya cara untuk mengakses dompet anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U ontvangt een geheime zin. Dit is de enige manier om toegang te krijgen tot uw portemonnee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymasz tajną frazę — to jedyny sposób na uzyskanie dostępu do portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você receberá uma Frase Secreta — é a única maneira de acessar sua carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vei primi o Frază Secretă — este singura modalitate de a accesa portofelul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получите Секретную фразу — это единственный способ получить доступ к вашему кошельку."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Utapata Maneno ya Siri - ndiyo njia pekee ya kufikia pochi yako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะได้รับวลีลับซึ่งเป็นวิธีเดียวที่จะเข้าถึงกระเป๋าเงินของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli bir İfade alacaksınız; bu, cüzdanınıza erişmenin tek yoludur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви отримаєте секретну фразу — це єдиний спосіб отримати доступ до вашого гаманця."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کو ایک خفیہ جملہ ملے گا - یہ آپ کے بٹوے تک رسائی کا واحد طریقہ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ nhận được Cụm từ bí mật — đây là cách duy nhất để truy cập vào ví của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将获得一组助记词——这是访问钱包的唯一方法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將取得一組助記詞——這是存取錢包的唯一方式。"
          }
        }
      }
    },
    "onboarding.security.create_wallet.keep_safe.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العبارة السرية هي الطريقة الوحيدة للوصول إلى محفظتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গোপন বাক্যাংশটি আপনার ওয়ালেট অ্যাক্সেস করার একমাত্র উপায়।"
