            "value": "ট্র্যাকে কয়েন যোগ করে এগুলি সক্ষম করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte je přidáním mincí do sledování"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivér dem ved at tilføje mønter til sporet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie sie, indem Sie Münzen zur Verfolgung hinzufügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable them by adding coins to track"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilítelos agregando monedas para realizar un seguimiento"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با اضافه کردن سکه‌ها برای ردیابی، آنها را فعال کنید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Paganahin ang mga ito sa pamamagitan ng pagdaragdag ng mga barya upang masubaybayan"
