    "info.total_supply.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجمالي عدد العملات المعدنية الموجودة، بما في ذلك العملات المعدنية المقفلة أو المحجوزة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক করা বা সংরক্ষিত কয়েন সহ বিদ্যমান মোট কয়েনের সংখ্যা।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celkový počet existujících mincí, včetně uzamčených nebo rezervovaných mincí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det samlede antal mønter, der findes, inklusive låste eller reserverede mønter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gesamtzahl der existierenden Münzen, einschließlich gesperrter oder reservierter Münzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The total number of coins that exist, including locked or reserved coins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número total de monedas que existen, incluidas las monedas bloqueadas o reservadas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد کل سکه‌های موجود، شامل سکه‌های قفل‌شده یا رزرو شده."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang kabuuang bilang ng mga barya na umiiral, kabilang ang mga naka-lock o nakareserbang barya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre total de pièces existantes, y compris les pièces bloquées ou réservées."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Jimillar tsabar kuɗin da ke akwai, gami da tsabar kuɗi da aka kulle ko aka ajiye."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המספר הכולל של מטבעות שקיימים, כולל מטבעות נעולים או שמורים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक किए गए या आरक्षित सिक्कों सहित, मौजूद सिक्कों की कुल संख्या।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah total koin yang ada, termasuk koin yang terkunci atau dicadangkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero totale di monete esistenti, comprese quelle bloccate o riservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックされたコインや予約されたコインを含む、存在するコインの合計数。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠겨 있거나 예약된 코인을 포함하여 존재하는 전체 코인 수입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah syiling yang wujud, termasuk syiling yang dikunci atau ditempah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het totale aantal munten dat bestaat, inclusief vergrendelde of gereserveerde munten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączna liczba istniejących monet, łącznie z monetami zablokowanymi lub zarezerwowanymi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número total de moedas existentes, incluindo moedas bloqueadas ou reservadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul total de monede existente, inclusiv monedele blocate sau rezervate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общее количество существующих монет, включая заблокированные или зарезервированные монеты."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumla ya sarafu zilizopo, ikijumuisha sarafu zilizofungwa au zilizohifadhiwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเหรียญทั้งหมดที่มีอยู่ รวมทั้งเหรียญที่ถูกล็อกหรือสงวนไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli veya rezerve edilmiş paralar da dahil olmak üzere mevcut toplam para sayısı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загальна кількість існуючих монет, включаючи заблоковані або зарезервовані монети."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجود سکوں کی کل تعداد، بشمول مقفل یا محفوظ سکے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng số lượng tiền xu hiện có, bao gồm cả tiền xu bị khóa hoặc được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代币总供应量，包括已锁定或预留的部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前存在的代幣總數，包括鎖定或預留的代幣。"
          }
        }
      }
    },
    "info.transaction.error.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إتمام المعاملة بسبب خطأ، مثل عدم كفاية الرصيد، أو إدخال غير صحيح، أو رفض من قِبل الشبكة. يُرجى مراجعة التفاصيل والمحاولة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ত্রুটির কারণে লেনদেন সম্পন্ন করা যায়নি, যেমন অপর্যাপ্ত তহবিল, অবৈধ ইনপুট, বা নেটওয়ার্ক দ্বারা প্রত্যাখ্যান। অনুগ্রহ করে বিস্তারিত পর্যালোচনা করুন এবং আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakci nebylo možné dokončit kvůli chybě, jako je nedostatek finančních prostředků, neplatný vstup nebo odmítnutí ze strany sítě. Zkontrolujte podrobnosti a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen kunne ikke gennemføres på grund af en fejl, såsom utilstrækkelige midler, ugyldigt input eller afvisning af netværket. Gennemgå venligst detaljerne og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion konnte aufgrund eines Fehlers nicht abgeschlossen werden, z. B. aufgrund unzureichender Mittel, ungültiger Eingaben oder einer Ablehnung durch das Netzwerk. Bitte überprüfen Sie die Details und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction could not be completed due to an error, such as insufficient funds, invalid input, or rejection by the network. Please review the details and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacción no se pudo completar debido a un error, como fondos insuficientes, una entrada no válida o un rechazo de la red. Revise los detalles y vuelva a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش به دلیل خطایی مانند موجودی ناکافی، ورودی نامعتبر یا رد شدن توسط شبکه، انجام نشد. لطفاً جزئیات را بررسی کرده و دوباره امتحان کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makumpleto ang transaksyon dahil sa isang error, tulad ng hindi sapat na pondo, hindi wastong input, o pagtanggi ng network. Pakisuri ang mga detalye at subukang muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction n'a pas pu être finalisée en raison d'une erreur, telle qu'un fonds insuffisant, une saisie non valide ou un rejet par le réseau. Veuillez vérifier les détails et réessayer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba za a iya kammala cinikin ba saboda kuskure, kamar rashin isassun kuɗi, shigarwa mara inganci, ko kin amincewa da hanyar sadarwa. Da fatan za a sake nazarin cikakkun bayanai kuma a sake gwadawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להשלים את העסקה עקב שגיאה, כגון חוסר כספים, קלט לא תקין או דחייה על ידי הרשת. אנא בדוק את הפרטים ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपर्याप्त धनराशि, अमान्य इनपुट या नेटवर्क द्वारा अस्वीकृति जैसी किसी त्रुटि के कारण लेनदेन पूरा नहीं हो सका। कृपया विवरण की समीक्षा करें और पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi tidak dapat diselesaikan karena kesalahan, seperti dana tidak mencukupi, input tidak valid, atau penolakan oleh jaringan. Harap tinjau detailnya dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La transazione non è stata completata a causa di un errore, ad esempio fondi insufficienti, input non validi o rifiuto da parte della rete. Si prega di controllare i dettagli e riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高不足、無効な入力、ネットワークによる拒否などのエラーにより、取引を完了できませんでした。詳細をご確認の上、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자금 부족, 잘못된 입력, 네트워크 거부 등의 오류로 인해 거래를 완료할 수 없습니다. 세부 정보를 확인하고 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus niaga tidak dapat diselesaikan kerana ralat, seperti dana tidak mencukupi, input tidak sah atau penolakan oleh rangkaian. Sila semak butiran dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transactie kon niet worden voltooid vanwege een fout, zoals onvoldoende saldo, ongeldige invoer of afwijzing door het netwerk. Controleer de details en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja nie mogła zostać ukończona z powodu błędu, takiego jak niewystarczające środki, nieprawidłowe dane wejściowe lub odrzucenie przez sieć. Sprawdź szczegóły i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transação não pôde ser concluída devido a um erro, como fundos insuficientes, entrada inválida ou rejeição pela rede. Revise os detalhes e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacția nu a putut fi finalizată din cauza unei erori, cum ar fi fonduri insuficiente, introducere nevalidă sau respingere din partea rețelei. Vă rugăm să examinați detaliile și să încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция не может быть завершена из-за ошибки, например, недостаточно средств, неверных данных или отклонения сетью. Пожалуйста, проверьте детали и повторите попытку."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala haukuweza kukamilika kwa sababu ya hitilafu, kama vile uhaba wa fedha, ingizo batili au kukataliwa na mtandao. Tafadhali kagua maelezo na ujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถทำธุรกรรมให้เสร็จสมบูรณ์ได้เนื่องจากเกิดข้อผิดพลาด เช่น เงินไม่เพียงพอ ข้อมูลที่ป้อนไม่ถูกต้อง หรือเครือข่ายปฏิเสธ โปรดตรวจสอบรายละเอียดและลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem, yetersiz fon, geçersiz giriş veya ağ tarafından reddedilme gibi bir hata nedeniyle tamamlanamadı. Lütfen ayrıntıları inceleyin ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцію не вдалося завершити через помилку, таку як недостатня кількість коштів, недійсні дані або відхилення мережею. Перегляньте деталі та повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لین دین ایک خرابی کی وجہ سے مکمل نہیں ہو سکا، جیسے کہ ناکافی فنڈز، غلط ان پٹ، یا نیٹ ورک کی طرف سے مسترد۔ براہ کرم تفصیلات کا جائزہ لیں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch không thể hoàn tất do lỗi, chẳng hạn như không đủ tiền, đầu vào không hợp lệ hoặc bị mạng từ chối. Vui lòng xem lại chi tiết và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于资金不足、输入无效或网络拒绝等错误，交易无法完成。请检查详情并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於錯誤（例如資金不足、輸入無效或網路拒絕）導致交易無法完成。請查看詳細資訊並重試。"
          }
        }
      }
    },
    "info.transaction.pending.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال المعاملة وهي بانتظار التأكيد على الشبكة. قد تختلف أوقات المعالجة. يُرجى مراجعة التحديثات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেন জমা দেওয়া হয়েছে এবং নেটওয়ার্কে নিশ্চিতকরণের জন্য অপেক্ষা করছে। প্রক্রিয়াকরণের সময় পরিবর্তিত হতে পারে। আপডেটের জন্য আবার চেক করুন."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce byla odeslána a čeká na potvrzení v síti. Doba zpracování se může lišit. Zkontrolujte prosím aktualizace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen er blevet indsendt og afventer bekræftelse på netværket. Behandlingstiderne kan variere. Kom venligst tilbage for opdateringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion wurde übermittelt und wartet auf die Bestätigung im Netzwerk. Die Bearbeitungszeit kann variieren. Bitte schauen Sie später noch einmal vorbei, um Updates zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction has been submitted and is awaiting confirmation on the network. Processing times may vary. Please check back for updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacción se ha enviado y está pendiente de confirmación en la red. El tiempo de procesamiento puede variar. Por favor, vuelva a consultar para obtener actualizaciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش ارسال شده و در انتظار تأیید در شبکه است. زمان پردازش ممکن است متفاوت باشد. لطفاً برای به‌روزرسانی‌ها دوباره مراجعه کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naisumite na ang transaksyon at naghihintay ng kumpirmasyon sa network. Maaaring mag-iba ang mga oras ng pagproseso. Mangyaring bumalik para sa mga update."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction a été soumise et est en attente de confirmation sur le réseau. Les délais de traitement peuvent varier. Veuillez consulter régulièrement les mises à jour."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An ƙaddamar da ma'amala kuma yana jiran tabbaci akan hanyar sadarwar. Lokutan sarrafawa na iya bambanta. Da fatan za a duba baya don sabuntawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה הוגשה וממתינה לאישור ברשת. זמני העיבוד עשויים להשתנות. אנא בדקו שוב לעדכונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन सबमिट कर दिया गया है और नेटवर्क पर पुष्टि की प्रतीक्षा कर रहा है। प्रसंस्करण समय अलग-अलग हो सकता है। कृपया अपडेट के लिए वापस जाँच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi telah dikirimkan dan sedang menunggu konfirmasi di jaringan. Waktu pemrosesan dapat bervariasi. Silakan periksa kembali untuk pembaruan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La transazione è stata inoltrata ed è in attesa di conferma sulla rete. I tempi di elaborazione possono variare. Si prega di controllare regolarmente per aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引は送信済みで、ネットワーク上での確認を待っています。処理時間は異なる場合があります。最新情報を再度ご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 제출되었으며 네트워크에서 확인을 기다리고 있습니다. 처리 시간은 다를 수 있습니다. 업데이트된 내용을 다시 확인해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus niaga telah diserahkan dan sedang menunggu pengesahan pada rangkaian. Masa pemprosesan mungkin berbeza-beza. Sila semak semula untuk kemas kini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transactie is verzonden en wacht op bevestiging op het netwerk. Verwerkingstijden kunnen variëren. Kom later terug voor updates."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja została wysłana i oczekuje na potwierdzenie w sieci. Czasy przetwarzania mogą się różnić. Sprawdź ponownie, czy są jakieś aktualizacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transação foi enviada e aguarda confirmação na rede. O tempo de processamento pode variar. Verifique novamente para obter atualizações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacția a fost trimisă și așteaptă confirmarea în rețea. Timpii de procesare pot varia. Vă rugăm să verificați din nou pentru actualizări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция была отправлена и ожидает подтверждения в сети. Время обработки может меняться. Пожалуйста, проверяйте обновления."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala umewasilishwa na unasubiri uthibitisho kwenye mtandao. Nyakati za usindikaji zinaweza kutofautiana. Tafadhali angalia tena kwa sasisho."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธุรกรรมได้รับการส่งแล้วและกำลังรอการยืนยันบนเครือข่าย เวลาในการประมวลผลอาจแตกต่างกัน โปรดตรวจสอบอีกครั้งเพื่อดูการอัปเดต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem gönderildi ve ağda onay bekleniyor. İşlem süreleri değişiklik gösterebilir. Lütfen güncellemeler için tekrar kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцію надіслано та очікує підтвердження в мережі. Час обробки може змінюватися. Будь ласка, слідкуйте за оновленнями."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لین دین جمع کر دیا گیا ہے اور نیٹ ورک پر تصدیق کا انتظار کر رہا ہے۔ پروسیسنگ کے اوقات مختلف ہو سکتے ہیں۔ براہ کرم اپ ڈیٹس کے لیے دوبارہ چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đã được gửi và đang chờ xác nhận trên mạng. Thời gian xử lý có thể thay đổi. Vui lòng kiểm tra lại để cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已提交，正在等待网络确认。处理时间可能有所不同。请稍后查看更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已提交並正在等待網路確認。處理時間可能有所不同。請回來查看更新。"
          }
        }
      }
    },
    "info.transaction.success.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إتمام المعاملة وتأكيدها على الشبكة. يمكنك مراجعة التفاصيل للتحقق من حالتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটওয়ার্কে লেনদেন সম্পন্ন এবং নিশ্চিত করা হয়েছে। আপনি এর স্থিতি যাচাই করতে বিশদ পর্যালোচনা করতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce byla dokončena a potvrzena v síti. Můžete zkontrolovat podrobnosti a ověřit jeho stav."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen er gennemført og bekræftet på netværket. Du kan gennemgå detaljerne for at bekræfte dens status."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion wurde abgeschlossen und im Netzwerk bestätigt. Sie können die Details überprüfen, um den Status zu verifizieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction has been completed and confirmed on the network. You can review the details to verify its status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacción se ha completado y confirmado en la red. Puedes revisar los detalles para verificar su estado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش تکمیل و در شبکه تأیید شده است. می‌توانید جزئیات را برای تأیید وضعیت آن بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang transaksyon ay nakumpleto at nakumpirma sa network. Maaari mong suriin ang mga detalye upang i-verify ang status nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction a été finalisée et confirmée sur le réseau. Vous pouvez consulter les détails pour vérifier son statut."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An kammala cinikin kuma an tabbatar da shi akan hanyar sadarwa. Kuna iya duba cikakkun bayanai don tabbatar da matsayinsa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה הושלמה ואושרה ברשת. באפשרותך לעיין בפרטים כדי לאמת את מצבה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन पूरा हो गया है और नेटवर्क पर इसकी पुष्टि हो गई है। आप इसकी स्थिति सत्यापित करने के लिए विवरण की समीक्षा कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi telah selesai dan dikonfirmasi di jaringan. Anda dapat meninjau detailnya untuk memverifikasi statusnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La transazione è stata completata e confermata sulla rete. Puoi controllare i dettagli per verificarne lo stato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引は完了し、ネットワーク上で確認されました。詳細を確認してステータスをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 완료되었으며 네트워크에서 확인되었습니다. 세부 정보를 확인하여 거래 상태를 확인하실 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus niaga telah selesai dan disahkan pada rangkaian. Anda boleh menyemak butiran untuk mengesahkan statusnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transactie is voltooid en bevestigd op het netwerk. U kunt de details bekijken om de status ervan te verifiëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja została ukończona i potwierdzona w sieci. Możesz przejrzeć szczegóły, aby zweryfikować jej status."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transação foi concluída e confirmada na rede. Você pode revisar os detalhes para verificar o status."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacția a fost finalizată și confirmată în rețea. Puteți examina detaliile pentru a verifica starea acestuia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция завершена и подтверждена в сети. Вы можете просмотреть детали, чтобы проверить ее статус."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala umekamilika na kuthibitishwa kwenye mtandao. Unaweza kukagua maelezo ili kuthibitisha hali yake."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธุรกรรมเสร็จสมบูรณ์และได้รับการยืนยันบนเครือข่ายแล้ว คุณสามารถตรวจสอบรายละเอียดเพื่อยืนยันสถานะได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem tamamlandı ve ağda onaylandı. Durumunu doğrulamak için ayrıntıları inceleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцію завершено та підтверджено в мережі. Ви можете переглянути деталі, щоб перевірити її статус."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لین دین مکمل ہو چکا ہے اور نیٹ ورک پر اس کی تصدیق ہو چکی ہے۔ آپ اس کی حیثیت کی تصدیق کے لیے تفصیلات کا جائزہ لے سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đã hoàn tất và được xác nhận trên mạng. Bạn có thể xem lại thông tin chi tiết để xác minh trạng thái của giao dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已完成并已在网络上确认。可查看详情以核实状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已完成並在網路上確認。可以查看詳細資訊來驗證其狀態。"
          }
        }
      }
    },
    "info.watch_wallet.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفظة لا يمكنك الوصول إليها، ولكن يمكنك مشاهدة معاملاتها وحركاتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি মানিব্যাগ যা আপনার অ্যাক্সেস নেই, তবে আপনি এটির লেনদেন এবং গতিবিধি দেখতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peněženka, ke které nemáte přístup, ale můžete sledovat její transakce a pohyby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tegnebog, som du ikke har adgang til, men du kan se dens transaktioner og bevægelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Wallet, auf die Sie keinen Zugriff haben, deren Transaktionen und Bewegungen Sie jedoch beobachten können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wallet that you do not have access to, but you can watch its transactions and movements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una billetera a la que no tienes acceso, pero puedes observar sus transacciones y movimientos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پولی که به آن دسترسی ندارید اما می توانید تراکنش ها و حرکات آن را تماشا کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang wallet na wala kang access, ngunit maaari mong panoorin ang mga transaksyon at paggalaw nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un portefeuille auquel vous n'avez pas accès, mais dont vous pouvez surveiller les transactions et les mouvements."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet wanda ba ku da damar yin amfani da shi, amma kuna iya kallon ma'amaloli da motsinsa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארנק שאין לך גישה אליו, אבל אתה יכול לצפות בעסקאות ובתנועות שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक वॉलेट जिस तक आपकी पहुंच नहीं है, लेकिन आप इसके लेनदेन और गतिविधियों पर नजर रख सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet yang tidak dapat Anda akses, tetapi Anda dapat memantau transaksi dan pergerakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un portafoglio a cui non hai accesso, ma di cui puoi monitorare le transazioni e i movimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資産を操作する権限はありませんが、取引や資金の動きを確認できるウォレットです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근할 수는 없지만 거래 및 이동을 볼 수 있는 지갑입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet yang anda tidak mempunyai akses, tetapi anda boleh menonton transaksi dan pergerakannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een portemonnee waar u geen toegang toe heeft, maar wel de transacties en bewegingen ervan kunt bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfel, do którego nie masz dostępu, ale możesz śledzić zawarte w nim transakcje i ruchy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma carteira à qual você não tem acesso, mas pode monitorar suas transações e movimentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un portofel la care nu ai acces, dar îi poți urmări tranzacțiile și mișcările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелек, к которому у вас нет доступа, но вы можете следить за его транзакциями и движениями."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mkoba ambao huna ufikiaji, lakini unaweza kutazama shughuli na harakati zake."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าเงินที่คุณไม่สามารถเข้าถึงได้แต่คุณสามารถดูธุรกรรมและการเคลื่อนไหวได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişiminizin olmadığı, ancak işlemlerini ve hareketlerini izleyebileceğiniz bir cüzdan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець, до якого у вас немає доступу, але ви можете спостерігати за його транзакціями та рухами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک والیٹ جس تک آپ کی رسائی نہیں ہے، لیکن آپ اس کے لین دین اور نقل و حرکت دیکھ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ví mà bạn không thể truy cập nhưng bạn có thể theo dõi các giao dịch và biến động của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一个您无法操作的钱包，但可以查看它的交易和资产变动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是一個您無法操作的錢包，但可以查看它的交易和資產變動。"
          }
        }
      }
    },
