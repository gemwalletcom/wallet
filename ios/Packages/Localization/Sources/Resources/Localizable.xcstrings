    "errors.scan_transaction.memo_required": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب عنوان محفظة الوجهة %@ علامة وجهة/مذكرة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ গন্তব্য ওয়ালেট ঠিকানার জন্য একটি গন্তব্য ট্যাগ / মেমো প্রয়োজন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cílová adresa peněženky %@ vyžaduje cílovou značku / poznámku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ destinations-wallet-adresse kræver et destinationstag / en destinations-memo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Für die Ziel-Wallet-Adresse wird ein Ziel-Tag/Memo benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ destination wallet address requires a destination tag / memo"
          }
        },
