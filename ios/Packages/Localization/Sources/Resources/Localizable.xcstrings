    "rewards.share_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينضم Gem Wallet استخدم رابط الإحالة الخاص بي واحصل على مكافآت: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগদান করুন Gem Wallet আমার রেফারেল লিঙ্ক দিয়ে পুরষ্কার জিতুন: %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte se ke Gem Wallet pomocí mého doporučovacího odkazu a získejte odměny: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltag Gem Wallet med mit henvisningslink og optjen belønninger: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treten Sie Gem Wallet mit meinem Empfehlungslink bei und verdienen Sie Prämien: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join Gem Wallet with my referral link and earn rewards: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a Gem Wallet con mi enlace de referencia y gana recompensas: %@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عضویت Gem Wallet با لینک معرفی من و کسب جوایز: %@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumali Gem Wallet gamit ang aking referral link at kumita ng mga gantimpala: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez Gem Wallet avec mon lien de parrainage et gagnez des récompenses : %@"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiga Gem Wallet tare da hanyar haɗin yanar gizo na kuma sami lada: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לְהִצְטַרֵף Gem Wallet בעזרת קישור ההפניה שלי וצברו פרסים: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ना Gem Wallet मेरे रेफरल लिंक का उपयोग करें और पुरस्कार अर्जित करें: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergabung Gem Wallet Gunakan tautan referensi saya dan dapatkan hadiah: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisciti a Gem Wallet con il mio link di riferimento e guadagna premi: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私の紹介リンクから Gem Wallet に参加して、ポイントを獲得しましょう：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제 추천 링크로 Gem Wallet에 가입하고 보상을 받으세요: %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertai Gem Wallet dengan pautan rujukan saya dan dapatkan ganjaran: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe mee met Gem Wallet via mijn verwijzingslink en verdien beloningen: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącz do Gem Wallet z moim linkiem polecającym i zyskaj nagrody: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Juntar Gem Wallet Use meu link de indicação e ganhe recompensas: %@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alătură-te Gem Wallet cu linkul meu de recomandare și câștigă recompense: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте Gem Wallet по моей реферальной ссылке и получите вознаграждение: %@"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiunge Gem Wallet kwa kutumia kiungo changu cha rufaa na upate zawadi: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าร่วม Gem Wallet ใช้ลิงก์แนะนำของฉันเพื่อรับรางวัล: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katılmak Gem Wallet Benim referans linkimi kullanarak kayıt olun ve ödüller kazanın: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приєднатися Gem Wallet за моїм реферальним посиланням та отримуйте винагороди: %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شمولیت Gem Wallet میرے ریفرل لنک کے ساتھ اور انعامات حاصل کریں: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tham gia Gem Wallet Sử dụng liên kết giới thiệu của tôi và nhận phần thưởng: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过我的邀请链接加入 Gem Wallet，即可获得积分：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過我的邀請連結加入 Gem Wallet，即可獲得積分：%@"
          }
        }
      }
    },
