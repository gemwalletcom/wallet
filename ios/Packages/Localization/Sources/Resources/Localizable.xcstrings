          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережа %@ вимагає одноразової оплати в розмірі %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ نیٹ ورک کو %@ کی ایک بار کی فیس درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mạng %@ yêu cầu một khoản phí một lần là %@."
