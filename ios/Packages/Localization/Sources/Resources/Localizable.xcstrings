        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier sehen Sie Aktualisierungen zu Ihren Benachrichtigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll see updates about your notifications here"
          }
