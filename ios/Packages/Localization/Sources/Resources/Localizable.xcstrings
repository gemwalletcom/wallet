    "wallet.import_address_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك عرض الأرصدة والمعاملات لهذا العنوان، ولكن **لا يمكنك إرسال أو بيع الأموال**."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এই ঠিকানার ব্যালেন্স এবং লেনদেন দেখতে পারবেন, কিন্তু **তহবিল পাঠাতে বা বিক্রি করতে পারবেন না**।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tuto adresu si můžete prohlížet zůstatky a transakce, ale **nemůžete posílat ani prodávat finanční prostředky**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se saldi og transaktioner for denne adresse, men **kan ikke sende eller sælge penge**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Guthaben und Transaktionen für diese Adresse anzeigen, aber **kein Geld senden oder verkaufen**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can view balances and transactions for this address, but **cannot send or sell funds**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ver los saldos y las transacciones de esta dirección, pero **no puede enviar ni vender fondos**."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما می‌توانید موجودی و تراکنش‌های این آدرس را مشاهده کنید، اما **نمی‌توانید وجه ارسال یا بفروشید**."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaari mong tingnan ang mga balanse at transaksyon para sa address na ito, ngunit **hindi maaaring magpadala o magbenta ng mga pondo**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez consulter les soldes et les transactions pour cette adresse, mais **vous ne pouvez pas envoyer ou vendre des fonds**."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuna iya duba ma'auni da ma'amaloli don wannan adireshin, amma ** ba za ku iya aikawa ko siyar da kuɗi ba**."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לצפות ביתרות ועסקאות עבור כתובת זו, אך **לא ניתן לשלוח או למכור כספים**."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस पते के लिए शेष राशि और लेनदेन देख सकते हैं, लेकिन **धन भेज या बेच नहीं सकते**।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat melihat saldo dan transaksi untuk alamat ini, tetapi **tidak dapat mengirim atau menjual dana**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi visualizzare i saldi e le transazioni per questo indirizzo, ma **non puoi inviare o vendere fondi**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスの残高と取引履歴は確認できますが、**送金や売却はできません**。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소에 대한 잔액과 거래 내역은 볼 수 있지만, **자금을 보내거나 판매할 수는 없습니다**."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh melihat baki dan urus niaga untuk alamat ini, tetapi **tidak boleh menghantar atau menjual dana**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt het saldo en de transacties voor dit adres bekijken, maar u kunt geen geld verzenden of verkopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz przeglądać salda i transakcje dla tego adresu, ale **nie możesz wysyłać ani sprzedawać środków**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode visualizar saldos e transações para este endereço, mas **não pode enviar ou vender fundos**."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți vizualiza soldurile și tranzacțiile pentru această adresă, dar **nu puteți trimite sau vinde fonduri**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете просматривать балансы и транзакции для этого адреса, но **не можете отправлять или продавать средства**."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unaweza kuangalia salio na miamala ya anwani hii, lakini **haiwezi kutuma au kuuza fedha**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถดูยอดคงเหลือและธุรกรรมสำหรับที่อยู่นี้ แต่ **ไม่สามารถส่งหรือขายเงินได้**"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adrese ait bakiyeleri ve işlemleri görüntüleyebilirsiniz, ancak **para gönderemez veya satamazsınız**."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете переглядати баланси та транзакції для цієї адреси, але **не можете надсилати або продавати кошти**."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اس پتے کے بیلنس اور لین دین دیکھ سکتے ہیں، لیکن **فنڈز بھیج یا فروخت نہیں کر سکتے**۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xem số dư và giao dịch của địa chỉ này, nhưng **không thể gửi hoặc bán tiền**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以查看此地址的余额和交易，但**不能发送或出售资金**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以查看此地址的餘額和交易，但**不能發送或出售資金**。"
          }
        }
      }
    },
