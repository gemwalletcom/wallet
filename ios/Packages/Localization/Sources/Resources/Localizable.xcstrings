    "info.estimated_confirmation_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتمد هذا التقدير على رسوم المعاملة ونشاط شبكة %@ الحالي. قد يتغير وقت التأكيد الفعلي وهو غير مضمون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অনুমানটি লেনদেনের ফি এবং বর্তমান %@ নেটওয়ার্ক কার্যকলাপের উপর ভিত্তি করে। প্রকৃত নিশ্চিতকরণের সময় পরিবর্তিত হতে পারে এবং এর নিশ্চয়তা নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento odhad vychází z transakčního poplatku a aktuální aktivity sítě %@. Skutečná doba potvrzení se může změnit a není zaručena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er et estimat baseret på transaktionsgebyret og den aktuelle aktivitet på %@-netværket. Den faktiske bekræftelsestid kan ændre sig og er ikke garanteret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Schätzung auf Grundlage der Transaktionsgebühr und der aktuellen Auslastung des %@-Netzwerks. Die tatsächliche Bestätigungszeit kann sich ändern und ist nicht garantiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This estimate is based on the transaction fee and current %@ network activity. The actual confirmation time may change and is not guaranteed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta estimación se basa en la comisión de la transacción y la actividad actual de la red %@. El tiempo real de confirmación puede cambiar y no está garantizado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تخمین بر اساس کارمزد تراکنش و فعالیت فعلی شبکه %@ است. زمان واقعی تأیید ممکن است تغییر کند و تضمین‌شده نیست."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang tantiya na ito ay batay sa bayad sa transaksyon at kasalukuyang aktibidad ng %@ network. Maaaring magbago ang aktuwal na oras ng kumpirmasyon at hindi ito garantisado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette estimation repose sur les frais de transaction et l’activité actuelle du réseau %@. Le délai réel de confirmation peut changer et n’est pas garanti."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan kiyasi ya dogara da kuɗin ma'amala da aikin hanyar sadarwar %@ na yanzu. Ainihin lokacin tabbatarwa na iya canzawa kuma ba shi da tabbaci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערכה זו מבוססת על עמלת העסקה ועל הפעילות הנוכחית ברשת %@. זמן האישור בפועל עשוי להשתנות ואינו מובטח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अनुमान लेन-देन शुल्क और मौजूदा %@ नेटवर्क गतिविधि पर आधारित है। वास्तविक पुष्टि समय बदल सकता है और इसकी गारंटी नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan ini didasarkan pada biaya transaksi dan aktivitas jaringan %@ saat ini. Waktu konfirmasi sebenarnya dapat berubah dan tidak dijamin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa stima si basa sulla commissione della transazione e sull’attuale attività della rete %@. Il tempo effettivo di conferma può cambiare e non è garantito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この推定は、取引手数料と %@ ネットワークの現在の混雑状況に基づいています。実際の確認時間は変わる可能性があり、保証されるものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 예상치는 거래 수수료와 현재 %@ 네트워크 활동을 기반으로 합니다. 실제 확인 시간은 달라질 수 있으며 보장되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggaran ini berdasarkan yuran transaksi dan aktiviti rangkaian %@ semasa. Masa pengesahan sebenar mungkin berubah dan tidak dijamin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze schatting is gebaseerd op de transactiekosten en de huidige activiteit op het %@-netwerk. De werkelijke bevestigingstijd kan veranderen en wordt niet gegarandeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To oszacowanie opiera się na opłacie transakcyjnej i bieżącej aktywności sieci %@. Rzeczywisty czas potwierdzenia może się zmienić i nie jest gwarantowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta estimativa se baseia na taxa da transação e na atividade atual da rede %@. O tempo real de confirmação pode mudar e não é garantido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această estimare se bazează pe taxa tranzacției și pe activitatea curentă a rețelei %@. Timpul real de confirmare se poate modifica și nu este garantat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта оценка основана на комиссии транзакции и текущей активности сети %@. Фактическое время подтверждения может измениться и не гарантируется."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Makadirio haya yanategemea ada ya muamala na shughuli za sasa za mtandao wa %@. Muda halisi wa uthibitisho unaweza kubadilika na haujahakikishwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประมาณนี้อ้างอิงจากค่าธรรมเนียมธุรกรรมและกิจกรรมปัจจุบันของเครือข่าย %@ เวลายืนยันจริงอาจเปลี่ยนแปลงและไม่สามารถรับประกันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tahmin işlem ücreti ve mevcut %@ ağı etkinliğine dayanır. Gerçek onay süresi değişebilir ve garanti edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця оцінка базується на комісії транзакції та поточній активності мережі %@. Фактичний час підтвердження може змінюватися й не гарантується."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ تخمینہ لین دین کی فیس اور موجودہ %@ نیٹ ورک سرگرمی پر مبنی ہے۔ تصدیق کا اصل وقت تبدیل ہو سکتا ہے اور اس کی ضمانت نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước tính này dựa trên phí giao dịch và hoạt động hiện tại của mạng %@. Thời gian xác nhận thực tế có thể thay đổi và không được đảm bảo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此估算基于交易手续费和 %@ 网络当前的负载情况。实际确认时间可能变化，无法保证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此估算是根據交易手續費和 %@ 網路目前的負載情況得出。實際確認時間可能變動，無法保證。"
          }
        }
      }
    },
    "info.fully_diluted_valuation.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القيمة السوقية النظرية في حال تداول جميع العملات. تُحسب بضرب السعر في الحد الأقصى للعرض."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যদি সমস্ত মুদ্রা প্রচলিত থাকে, তাহলে তাত্ত্বিক বাজার মূল্য। সর্বোচ্চ সরবরাহ দ্বারা গুণিত মূল্য হিসাবে গণনা করা হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teoretická tržní hodnota, pokud by všechny mince byly v oběhu. Vypočítá se jako cena vynásobená maximální nabídkou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den teoretiske markedsværdi, hvis alle mønter var i omløb. Beregnet som prisen ganget med det maksimale udbud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der theoretische Marktwert, wenn alle Münzen im Umlauf wären. Berechnet als Preis multipliziert mit der maximalen Gesamtmenge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The theoretical market value if all coins were in circulation. Calculated as price multiplied by max supply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor teórico de mercado si todas las monedas estuvieran en circulación. Se calcula multiplicando el precio por la oferta máxima."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارزش بازار فرضی در صورتی که همه کوین‌ها در گردش باشند. این ارزش از حاصل ضرب قیمت در حداکثر عرضه محاسبه می‌شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang teoretikal na halaga sa pamilihan kung lahat ng barya ay nasa sirkulasyon. Kinakalkula bilang presyo na pinarami sa pinakamataas na suplay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeur marchande théorique si toutes les pièces étaient en circulation. Calculée en multipliant le prix par l'offre maximale."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Darajar kasuwa ta ka'ida idan duk tsabar kudi suna yawo. An ƙididdige shi azaman farashi da aka ninka ta hanyar mafi girman wadata."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שווי השוק התיאורטי אם כל המטבעות היו במחזור. מחושב כמחיר כפול היצע מקסימלי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि सभी सिक्के प्रचलन में होते तो उनका सैद्धांतिक बाजार मूल्य क्या होता? इसकी गणना मूल्य को अधिकतम आपूर्ति से गुणा करके की जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai pasar teoretis jika semua koin beredar. Dihitung sebagai harga dikalikan dengan pasokan maksimum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valore di mercato teorico se tutte le monete fossero in circolazione. Calcolato come prezzo moltiplicato per l'offerta massima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのコインが流通している場合の理論上の市場価値。価格に最大供給量を掛けて計算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 동전이 유통될 경우의 이론적인 시장 가치. 가격에 최대 공급량을 곱하여 계산합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai pasaran teori jika semua syiling berada dalam edaran. Dikira sebagai harga didarab dengan penawaran maksimum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De theoretische marktwaarde als alle munten in omloop zouden zijn. Berekend als de prijs vermenigvuldigd met het maximale aanbod."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teoretyczna wartość rynkowa, gdyby wszystkie monety były w obiegu. Obliczona jako iloczyn ceny i maksymalnej podaży."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor de mercado teórico se todas as moedas estivessem em circulação. Calculado como o preço multiplicado pela oferta máxima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valoarea teoretică de piață ar rezulta în cazul în care toate monedele ar fi în circulație. Calculată ca preț înmulțit cu oferta maximă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теоретическая рыночная стоимость, если бы все монеты находились в обращении. Рассчитывается как цена, умноженная на максимальное предложение."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Thamani ya kinadharia ya soko ikiwa sarafu zote zilikuwa zikitumika. Imehesabiwa kama bei ikizidishwa na usambazaji wa juu zaidi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มูลค่าตลาดตามทฤษฎีหากเหรียญทั้งหมดหมุนเวียนอยู่ในระบบ คำนวณจากราคาคูณด้วยจำนวนเหรียญสูงสุดที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm madeni paraların dolaşımda olması durumunda teorik piyasa değeri. Fiyatın maksimum arzla çarpılmasıyla hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теоретична ринкова вартість, якби всі монети були в обігу. Розраховується як ціна, помножена на максимальну пропозицію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نظریاتی مارکیٹ کی قیمت اگر تمام سکے گردش میں تھے۔ قیمت کو زیادہ سے زیادہ سپلائی سے ضرب کے حساب سے شمار کیا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị thị trường lý thuyết nếu tất cả các đồng tiền đều được lưu thông. Được tính bằng giá nhân với nguồn cung tối đa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全稀释估值是所有代币均进入流通时的理论市值，计算方式为当前价格乘以最大供应量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "假設所有代幣均已流通時的理論市值，計算方式為價格乘以最大供應量。"
          }
        }
      }
    },
