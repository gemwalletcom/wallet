    "errors.decoding_qr": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل في فك رمز الاستجابة السريعة. يرجى المحاولة مرة أخرى باستخدام رمز QR مختلف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "QR কোড ডিকোড করতে ব্যর্থ হয়েছে৷ একটি ভিন্ন QR কোড দিয়ে আবার চেষ্টা করুন."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se dekódovat QR kód. Zkuste to prosím znovu s jiným QR kódem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke afkode QR-koden. Prøv venligst igen med en anden QR-kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der QR-Code konnte nicht entschlüsselt werden. Bitte versuchen Sie es erneut mit einem anderen QR-Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to decode the QR code. Please try again with a different QR code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo decodificar el código QR. Inténtelo de nuevo con un código QR diferente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خطا در خواندن بارکد. لطفا با بارکد دیگری دوباره امتحان کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabigong i-decode ang QR code. Pakisubukang muli gamit ang ibang QR code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du décodage du code QR. Veuillez réessayer avec un autre code QR."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An kasa yanke lambar QR. Da fatan za a sake gwadawa tare da lambar QR daban."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פענוח קוד ה-QR נכשל. אנא נסה שוב עם קוד QR אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "QR कोड को डिकोड करने में विफल. कृपया किसी भिन्न QR कोड के साथ पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal memindai kode QR. Silakan coba lagi dengan kode QR yang berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile decodificare il codice QR. Riprova con un codice QR diverso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードを読み取れませんでした。別のQRコードでもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드를 디코딩하지 못했습니다. 다른 QR 코드를 사용하여 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal menyahkod kod QR. Sila cuba lagi dengan kod QR lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de QR-code niet decoderen. Probeer het opnieuw met een andere QR-code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zdekodować kodu QR. Spróbuj ponownie, używając innego kodu QR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao decodificar o código QR. Tente novamente com um código QR diferente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut decoda codul QR. Vă rugăm să încercați din nou cu un alt cod QR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось расшифровать QR-код. Пожалуйста, повторите попытку с другим QR-кодом."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kusimbua msimbo wa QR. Tafadhali jaribu tena ukitumia msimbo tofauti wa QR."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถถอดรหัสรหัส QR โปรดลองอีกครั้งโดยใช้โค้ด QR อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodu çözülemedi. Lütfen farklı bir QR koduyla tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося розшифрувати QR-код. Будь ласка, спробуйте ще раз з іншим QR-кодом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "QR کوڈ کو ڈی کوڈ کرنے میں ناکام۔ براہ کرم ایک مختلف QR کوڈ کے ساتھ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không giải mã được mã QR. Vui lòng thử lại bằng mã QR khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解析二维码失败，请换一个码重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法辨識 QR 碼，請改用其他 QR 碼再試一次。"
          }
        }
      }
    },
    "errors.dust_threshold": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت المعاملة لأن المبلغ صغير جدًا بحيث لا يلبي الحد الأدنى لمتطلبات شبكة %@ (حد الغبار). يضمن هذا الحد أن قيمة المعاملة تغطي الرسوم وتكاليف المعالجة. زد المبلغ أو قلل الرسوم للمتابعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেন ব্যর্থ হয়েছে কারণ পরিমাণটি %@ নেটওয়ার্কের ন্যূনতম প্রয়োজনীয়তা (ডাস্ট থ্রেশহোল্ড) পূরণ করতে খুব কম। এই সীমা নিশ্চিত করে যে লেনদেনের মূল্য ফি এবং প্রক্রিয়াকরণের খরচ কভার করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce se nezdařila, protože částka je příliš malá na to, aby splnila minimální požadavek sítě %@ (prahová hodnota prachu). Tento limit zajišťuje, že hodnota transakce pokryje poplatky a náklady na zpracování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen mislykkedes, fordi beløbet er for lille til at opfylde %@ netværkets minimumskrav (støvtærskel). Denne grænse sikrer, at transaktionsværdien dækker gebyrer og behandlingsomkostninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion ist fehlgeschlagen, da der Betrag zu gering ist, um die Mindestanforderung des %@ -Netzwerks (Dust-Schwellenwert) zu erfüllen. Dieses Limit stellt sicher, dass der Transaktionswert die Gebühren und Bearbeitungskosten deckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction failed because the amount is too small to meet the %@ network's minimum requirement (dust threshold). This limit ensures the transaction value covers the fees and processing costs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacción falló porque el monto es demasiado pequeño para cumplir con el requisito mínimo de la red %@ (umbral de polvo). Este límite garantiza que el valor de la transacción cubra las comisiones y los costos de procesamiento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش به دلیل کم بودن مبلغ برای برآورده کردن حداقل لازم شبکه %@ (آستانه گرد و غبار) انجام نشد. این محدودیت تضمین می‌کند که ارزش تراکنش، کارمزدها و هزینه‌های پردازش را پوشش می‌دهد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabigo ang transaksyon dahil napakaliit ng halaga upang matugunan ang minimum na kinakailangan ng %@ network (dust threshold). Tinitiyak ng limitasyong ito na saklaw ng halaga ng transaksyon ang mga bayarin at gastos sa pagproseso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction a échoué car le montant est trop faible pour atteindre le seuil minimal du réseau %@. Cette limite garantit que la valeur de la transaction couvre les frais et les coûts de traitement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasuwancin ya gaza saboda adadin ya yi ƙanƙanta da zai iya biyan mafi ƙarancin buƙatun hanyar sadarwa na %@ (ƙafar ƙura). Wannan iyaka yana tabbatar da ƙimar ciniki ta rufe kudade da farashin sarrafawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה נכשלה מכיוון שהסכום קטן מדי לעמוד בדרישת המינימום של רשת %@ (ערך אבק). מגבלה זו מבטיחה שערך העסקה יכסה את העמלות ואת עלויות העיבוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन विफल रहा क्योंकि राशि %@ नेटवर्क की न्यूनतम आवश्यकता (डस्ट थ्रेशोल्ड) को पूरा करने के लिए बहुत कम है। यह सीमा सुनिश्चित करती है कि लेन-देन का मूल्य शुल्क और प्रसंस्करण लागत को कवर करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi gagal karena jumlahnya terlalu kecil untuk memenuhi persyaratan minimum jaringan %@ (ambang batas debu). Batas ini memastikan nilai transaksi mencakup biaya dan ongkos pemrosesan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La transazione non è riuscita perché l'importo è troppo basso per soddisfare il requisito minimo della rete %@ (soglia di dust). Questo limite garantisce che il valore della transazione copra le commissioni e i costi di elaborazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額が%@ネットワークの最小要件（ダストしきい値）を満たしていないため、取引は失敗しました。この制限は、取引額が手数料と処理コストをカバーすることを保証するものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 %@ 네트워크의 최소 요구 사항(먼지 임계값)을 충족하기에 너무 적어 실패했습니다. 이 한도는 거래 금액이 수수료 및 처리 비용을 충당할 수 있도록 보장합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus niaga gagal kerana jumlahnya terlalu kecil untuk memenuhi keperluan minimum rangkaian %@ (ambang habuk). Had ini memastikan nilai transaksi meliputi yuran dan kos pemprosesan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transactie is mislukt omdat het bedrag te klein is om te voldoen aan de minimumvereiste van het %@-netwerk (stofdrempel). Deze limiet zorgt ervoor dat de transactiewaarde de vergoedingen en verwerkingskosten dekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja nie powiodła się, ponieważ kwota jest zbyt mała, aby spełnić minimalne wymagania sieci %@ (próg pyłu). Ten limit zapewnia, że wartość transakcji pokrywa opłaty i koszty przetwarzania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transação falhou porque o valor é muito pequeno para atender ao requisito mínimo da rede %@ (limite de poeira). Este limite garante que o valor da transação cubra as taxas e os custos de processamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacția a eșuat deoarece suma este prea mică pentru a îndeplini cerințele minime ale rețelei %@ (pragul de praf). Această limită asigură că valoarea tranzacției acoperă taxele și costurile de procesare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция не удалась, так как сумма слишком мала для соответствия минимальным требованиям сети %@ (порог пыли). Этот предел гарантирует, что сумма транзакции покрывает комиссии и затраты на обработку."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala haukufaulu kwa sababu kiasi hicho ni kidogo sana kutosheleza mahitaji ya chini ya mtandao %@ (kiwango cha juu cha vumbi). Kikomo hiki kinahakikisha thamani ya muamala inashughulikia ada na gharama za usindikaji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธุรกรรมล้มเหลวเนื่องจากจำนวนเงินน้อยเกินไปที่จะตรงตามข้อกำหนดขั้นต่ำของเครือข่าย %@ (เกณฑ์ค่าฝุ่น) ขีดจำกัดนี้ช่วยให้มั่นใจว่ามูลค่าธุรกรรมครอบคลุมค่าธรรมเนียมและต้นทุนการประมวลผล เพิ่มจำนวนเงินหรือลดค่าธรรมเนียมเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem, tutarın %@ ağının minimum gereksinimini (toz eşiği) karşılamak için çok küçük olması nedeniyle başarısız oldu. Bu sınır, işlem değerinin ücretleri ve işlem maliyetlerini karşılamasını sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцію не вдалося виконати, оскільки сума занадто мала, щоб відповідати мінімальним вимогам мережі %@ (поріг пилу). Це обмеження гарантує, що сума транзакції покриває комісії та витрати на обробку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لین دین ناکام ہو گیا کیونکہ رقم %@ نیٹ ورک کی کم از کم ضرورت (دھول کی حد) کو پورا کرنے کے لیے بہت کم ہے۔ یہ حد یقینی بناتی ہے کہ لین دین کی قیمت فیسوں اور پروسیسنگ کے اخراجات کا احاطہ کرتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch không thành công vì số tiền quá nhỏ để đáp ứng yêu cầu tối thiểu của mạng %@ (ngưỡng bụi). Giới hạn này đảm bảo giá trị giao dịch bao gồm phí và chi phí xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易失败，因为金额太小，无法满足%@网络的最低要求（粉尘阈值）。此限制可确保交易金额足以覆盖手续费和处理成本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易失敗，因為金額太小，無法滿足 %@ 網路的最低要求（粉塵門檻）。此限制確保交易金額足以支付手續費和處理成本。"
          }
        }
      }
    },
    "errors.dust_threshold_short": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتبر الشبكة هذه الكمية مجرد غبار، حيث أن الرسوم أعلى من الكمية نفسها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটওয়ার্ক এই পরিমাণ ধুলো বিবেচনা করে - ফি পরিমাণের চেয়ে বেশি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Síť toto množství považuje za prach – poplatek je vyšší než samotné množství."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Netværket anser denne mængde for støv – gebyret er højere end selve mængden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Netzwerk betrachtet diesen Betrag als Staub – die Gebühr ist höher als der Betrag selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network considers this amount dust - the fee is higher than the amount itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La red considera esta cantidad como polvo: la tarifa es más alta que el monto en sí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شبکه این مبلغ را داست (dust) در نظر می‌گیرد - کارمزد آن از خود مبلغ بیشتر است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinuturing ng network ang halagang ito bilang alikabok (dust) - ang bayad ay mas mataas kaysa sa halaga mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau considère ce montant comme négligeable - les frais sont supérieurs au montant lui-même."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Cibiyar sadarwa tana la'akari da wannan adadin ƙura - kuɗin ya fi girma fiye da adadin kanta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשת מחשיבה את הכמות הזו כאבק - העמלה גבוהה יותר מהכמות עצמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क इस राशि को धूल मानता है - शुल्क स्वयं राशि से अधिक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaringan menganggap jumlah ini sebagai debu - biayanya lebih tinggi daripada jumlahnya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rete considera questa cifra come polvere: la commissione è più alta dell'importo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークはこの金額をダストとみなします。つまり、手数料は金額自体よりも高くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크는 이 금액을 먼지로 간주합니다. 수수료가 금액 자체보다 높기 때문입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangkaian menganggap jumlah habuk ini - bayarannya lebih tinggi daripada jumlah itu sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het netwerk beschouwt deze hoeveelheid als stof; de vergoeding is hoger dan de hoeveelheid zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieć traktuje tę kwotę jako kurz - opłata jest wyższa od samej kwoty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rede considera essa quantia insignificante - a taxa cobrada é superior à própria quantia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rețeaua consideră această cantitate drept praf - taxa este mai mare decât suma în sine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту сумму сеть считает пылью - комиссия выше самой суммы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtandao unazingatia kiasi hiki cha vumbi - ada ni kubwa kuliko kiasi yenyewe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครือข่ายถือว่าจำนวนนี้เป็นแค่ฝุ่น เพราะค่าธรรมเนียมนั้นสูงกว่าจำนวนที่แท้จริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ bu miktarı toz olarak değerlendiriyor; ücret miktarın kendisinden daha yüksek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережа вважає цю кількість пилом - плата вища за саму суму."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیٹ ورک اس رقم کو دھول سمجھتا ہے — فیس خود رقم سے زیادہ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mạng lưới coi số tiền này là bụi - mức phí còn cao hơn cả số tiền thực tế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转账金额过小，被网络视为“粉尘”金额，手续费甚至高于金额本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此網路將這筆金額視為粉塵金額，手續費高於金額本身。"
          }
        }
      }
    },
