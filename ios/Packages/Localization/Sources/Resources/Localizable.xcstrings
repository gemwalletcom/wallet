    "rewards.invite_friends.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكسب %@ نقاط لكل صديق ينضم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আয় করুন %@ যোগদানকারী প্রতিটি বন্ধুর জন্য পয়েন্ট।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získejte %@ bodů za každého přítele, který se připojí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optjen %@ point for hver ven, der tilmelder sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdienen %@ Punkte für jeden geworbenen Freund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earn %@ points for each friend who joins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganar %@ puntos por cada amigo que se una."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کسب درآمد %@ امتیاز برای هر دوستی که عضو می‌شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumita %@ puntos para sa bawat kaibigang sasali."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagner %@ Des points pour chaque ami qui s'inscrit."
