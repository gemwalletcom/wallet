    "swap.slippage_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انزلاق مرتفع. قد يُنفَّذ التبادل بسعر أسوأ من المتوقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উচ্চ স্লিপেজ। আপনার সোয়াপ প্রত্যাশার চেয়ে খারাপ দামে সম্পন্ন হতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vysoký skluz. Vaše směna může proběhnout za horší cenu, než se očekávalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Høj slippage. Din swap kan blive udført til en dårligere pris end forventet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hohe Slippage. Dein Swap wird möglicherweise zu einem schlechteren Preis als erwartet ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High slippage. Your swap may be executed at a worse price than expected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizamiento alto. Tu swap podría ejecutarse a un precio peor de lo esperado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لغزش بالا. ممکن است سواپ شما با قیمتی بدتر از حد انتظار انجام شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mataas na slippage. Maaaring maisagawa ang iyong swap sa mas masamang presyo kaysa inaasahan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissement élevé. Votre échange pourrait s'exécuter à un prix pire que prévu."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamewa mai yawa. Wataƙila a aiwatar da musayar ku a farashi mafi muni fiye da yadda ake tsammani."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלקה גבוהה. ההמרה שלך עלולה להתבצע במחיר גרוע מהצפוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्च स्लिपेज। आपका स्वैप अपेक्षा से खराब मूल्य पर निष्पादित हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage tinggi. Swap Anda mungkin dieksekusi pada harga yang lebih buruk dari yang diharapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage elevato. Il tuo swap potrebbe essere eseguito a un prezzo peggiore del previsto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリッページが大きいです。スワップが予想より悪い価格で実行される可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬리피지가 높습니다. 스왑이 예상보다 나쁜 가격에 체결될 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelinciran tinggi. Pertukaran anda mungkin dilaksanakan pada harga yang lebih buruk daripada dijangka."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoge slippage. Je swap wordt mogelijk uitgevoerd tegen een slechtere prijs dan verwacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysoki poślizg. Twoja zamiana może zostać wykonana po gorszej cenie niż oczekiwano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizamento alto. Sua troca pode ser executada a um preço pior do que o esperado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alunecare mare. Schimbul tău ar putea fi executat la un preț mai prost decât cel așteptat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокое проскальзывание. Обмен может пройти по цене хуже ожидаемой."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuteleza kwa juu. Ubadilishaji wako unaweza kutekelezwa kwa bei mbaya zaidi kuliko ilivyotarajiwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลิปเพจสูง การสว็อปของคุณอาจดำเนินการที่ราคาที่แย่กว่าที่คาดไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek kayma. Takasınız beklenenden daha kötü bir fiyattan gerçekleşebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Високе прослизання. Обмін може відбутися за гіршою ціною, ніж очікувалося."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ سلیپج۔ آپ کا سویپ متوقع سے خراب قیمت پر انجام پا سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trượt giá cao. Giao dịch hoán đổi của bạn có thể được thực hiện ở mức giá tệ hơn dự kiến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑点过高。兑换可能以比预期更差的价格成交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑點過高。兌換可能以比預期更差的價格成交。"
          }
        }
      }
    },
