    "widget.medium.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع أسعار العملات المشفرة الرائدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শীর্ষ ক্রিপ্টোকারেন্সির দাম ট্র্যাক করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte ceny nejoblíbenějších kryptoměn"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor priserne på de bedste kryptovalutaer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgen Sie die Preise der wichtigsten Kryptowährungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track prices of top cryptocurrencies"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimiento de los precios de las principales criptomonedas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قیمت ارزهای دیجیتال برتر را پیگیری کنید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Subaybayan ang mga presyo ng mga nangungunang cryptocurrencies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les prix des principales crypto-monnaies"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibiyar farashin manyan cryptocurrencies"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעקב אחר מחירי מטבעות קריפטוגרפיים מובילים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्ष क्रिप्टोकरेंसी की कीमतों पर नज़र रखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacak harga mata uang kripto teratas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni traccia dei prezzi delle principali criptovalute"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主要暗号通貨の価格を追跡する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주요 암호화폐 가격 추적"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejaki harga mata wang kripto teratas"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg de prijzen van de beste cryptovaluta's"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź ceny najlepszych kryptowalut"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe os preços das principais criptomoedas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește prețurile criptomonedelor de top"
