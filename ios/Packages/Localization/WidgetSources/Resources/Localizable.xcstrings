        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте цены топ криптовалют"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuatilia bei za sarafu-fiche za juu"
