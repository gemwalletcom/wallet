        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শীর্ষ ক্রিপ্টোকারেন্সির দাম ট্র্যাক করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte ceny nejoblíbenějších kryptoměn"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor priserne på de bedste kryptovalutaer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgen Sie die Preise der wichtigsten Kryptowährungen"
